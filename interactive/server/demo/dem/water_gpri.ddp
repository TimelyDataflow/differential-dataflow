-- VARIANT of water.ddp for very large meshes: identical rules and answers,
-- with the priority classes extended from the seeds to the proposals, so the
-- whole wavefront advances in level order rather than at full speed.
--
-- Measured on engadin_512 (262,144 cells, ~13 m): cold fill 12.66s in 2.3 GB
-- against water.ddp's 30.23s in 3.7 GB, but a dam edit costs 2.89s against
-- 0.70s, because every later change must walk the class ladder. Prefer this
-- for cold loads and large meshes; prefer water.ddp for live, edited worlds.
-- See NOTES_PERF.md.
-- Depression filling ("priority flood"), incrementally maintained: edit the
-- terrain and only the affected basin re-derives.
--
-- input 0: terrain ((x, y) ; (height)). Any set of cells; 4-adjacency is a
-- coordinate equijoin, and cells with fewer than four neighbours are the
-- window boundary — the rest of the world, which drains.

let terrain = input 0;

-- Both directions of each axis shift, restricted to cells present.
let sx = terrain | map($0[0] + 1, $0[1] ; $0[0], $0[1]);
let ax = sx | join(terrain, ($1[0], $1[1] ; $0[0], $0[1]));
let bx = sx | join(terrain, ($0[0], $0[1] ; $1[0], $1[1]));
let sy = terrain | map($0[0], $0[1] + 1 ; $0[0], $0[1]);
let ay = sy | join(terrain, ($1[0], $1[1] ; $0[0], $0[1]));
let by = sy | join(terrain, ($0[0], $0[1] ; $1[0], $1[1]));
let adj = ax + bx + ay + by;

-- Boundary cells (degree < 4) pin to their own terrain: water drains there.
let deg = adj | map($0 ;) | count;
let bound = terrain | join(deg, ($0 ; $1[0], $2[0])) | filter($1[1] < 4) | map($0 ; $1[0]);

-- Neighbour relation keyed by the neighbour, to read its water level.
-- Release each boundary cell at its own height, so the lowest drain starts
-- first and the wavefronts are broadly ordered by level.
let lo = terrain | map(; $1[0]) | min;
let boundu = bound | map(; $0[0], $0[1], $1[0]);
let seeds = boundu
    | join(lo, ($1[0], $1[1] ; $1[2], $2[0]))
    | enter_at($1[0] - $1[1])
    | map($0 ; $1[0]);

let adjn = adj | map($1[0], $1[1] ; $0[0], $0[1]);

w: {
    -- Lowest neighbouring level, clamped below by own terrain; a cell whose
    -- neighbours have no level yet contributes no candidate at all.
    let pass = adjn | join(w, ($1[0], $1[1] ; $2[0])) | min;
    -- Same absolute-priority idea applied to propagation: a proposed level
    -- enters in the magnitude class of its height above the lowest terrain.
    let cand0 = pass | join(terrain, ($0 ; if($1[0] > $2[0], $1[0], $2[0])));
    let candu = cand0 | map(; $0[0], $0[1], $1[0]);
    let cand = candu
        | join(lo, ($1[0], $1[1] ; $1[2], $2[0]))
        | enter_at($1[0] - $1[1])
        | map($0 ; $1[0]);
    -- grow from the draining boundary; boundary stays pinned at terrain
    var w = seeds + cand | min;
}

export "water" = w::w;
export "terrain" = terrain;
