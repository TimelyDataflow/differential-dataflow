-- One epoch's transaction resolution against the committed store, installed
-- for that epoch and dropped once its decisions are read.
--
-- Input 0 holds only this epoch's intents, in maintained.ddp's row format.
-- Every id in it exceeds every id in the store. The store is read only by
-- joins outside the recursion, so the program shares the store's arrangement
-- and touches it at the keys this epoch reads or writes.
--
-- `delta` is the store change: each written key's latest committed write in,
-- the store's prior row for that key out. `feed store 0 from delta` applies it.
-- Nothing this program holds is ever retracted; dropping it frees it.

let store = import "store" : ((int) ; (int, int));
let intents = input 0 : ((int, int, int) ; (int));

-- ((rid, k) ; expected) and ((wid, k) ; v)
let reads  = intents | filter(((_, r, _), _) -> (r, 1) eq) | map(((rid, _, k), (e)) -> ((rid, k), (e)));
let wr_all = intents | filter(((_, r, _), _) -> (r, 0) eq) | map(((wid, _, k), (v)) -> ((wid, k), (v)));
let wid = wr_all | map(((wid, k), (v)) -> ((wid), (k, v)));
let rk  = reads  | map(((rid, k), (e)) -> ((k), (rid, e)));

-- Each read's store row: a prior write older than any of this epoch's.
let base = rk | join(store, ((k), (rid, e), (sw, v)) -> ((k, rid, e), (sw neg, v)));

res: {
    -- this epoch's writes of transactions not (currently) rolled back.
    let wr_bad = wid | join(rollback, (wid, kv, ()) -> (wid, kv));
    let writes = wid + (wr_bad | negate);

    -- each read paired with every surviving prior write to its key, the store's
    -- among them; the LATEST wins: min over (-wid, v).
    let wk = writes | map(((wid), (k, v)) -> ((k), (wid, v)));
    let pairs = rk | join(wk, ((k), (rid, e), (wid, v)) -> ((k, rid, e), (wid neg, v)))
              | filter(((_, rid, _), (nw, _)) -> (nw neg, rid) lt);
    let best = (pairs + base) | min;

    -- a read fails if the latest prior value mismatches ...
    let bad_seen = best | filter(((_, _, e), (_, v)) -> (v, e) ne) | map(((_, rid, _), _) -> ((rid), ()));

    -- ... or if no prior write exists and it did not expect absence (-1).
    let seen   = best | map(((k, rid, _), _) -> ((rid, k), ()));
    let rkk    = reads | map((rk, _) -> (rk, ()));
    let unseen = rkk + (seen | negate);
    let bad_absent = unseen | join(reads, ((rid, _), (), (e)) -> ((rid, e), ()))
                   | filter(((_, e), ()) -> (e, -1) ne) | map(((rid, _), ()) -> ((rid), ()));

    var rollback = (bad_seen + bad_absent) | distinct;
}

let rb = res::rollback;
let wbad = wid | join(rb, (wid, kv, ()) -> (wid, kv));
let committed = wid + (wbad | negate);

-- ((k) ; (-wid, v)): each written key's latest committed write this epoch.
let latest = committed | map(((wid), (k, v)) -> ((k), (wid neg, v))) | min;
let new_rows = latest | map(((k), (nw, v)) -> ((k), (nw neg, v)));
let old_rows = latest | join(store, ((k), _, (sw, sv)) -> ((k), (sw, sv)));

export "rollback" = rb;
export "delta" = new_rows + (old_rows | negate);
