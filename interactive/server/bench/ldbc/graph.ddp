-- Positional input schema (all rows arrive as keys, with unit values):
-- 0 person(id, first, last, city); 1 knows(src, dst, created);
-- 2 message(id, kind, creator, parent), where post=0, comment=1, no parent=-1;
-- 3 tag(id, name); 4 message_tag(message, tag); 5 likes(person, message);
-- 6 place(id, name, parent). Strings are UTF-8 List(int).
let person = input 0 : ((int, List(int), List(int), int), ());
let knows = input 1 : ((int, int, int), ());
let message = input 2 : ((int, int, int, int), ());
let tag = input 3 : ((int, List(int)), ());
let message_tag = input 4 : ((int, int), ());
let likes = input 5 : ((int, int), ());
let place = input 6 : ((int, List(int), int), ());

export "person" = person | map(((id, first, last, city), ()) -> ((id), (first, last, city))) | arrange;
-- The input contains each undirected friendship once.
let edges = ((knows | map(((src, dst, created), ()) -> ((src, dst, created), ())))
           + (knows | map(((src, dst, created), ()) -> ((dst, src, created), ())))) | distinct;
export "edge" = edges | map(((src, dst, created), ()) -> ((src), (dst, created))) | arrange;
export "message" = message | map(((id, kind, creator, parent), ()) -> ((id), (kind, creator, parent))) | arrange;
export "likes" = likes | map(((person, message), ()) -> ((message), (person))) | arrange;
let tags = tag | map(((id, name), ()) -> (id, name));
export "tagged" = message_tag | map(((message, tag), ()) -> (tag, message))
    | join(tags, (_, message, name) -> ((message), (name))) | arrange;
let places = place | map(((id, name, parent), ()) -> (id, (name, parent)));
-- City -> country is one parent step in SNB.
export "resident" = person | map(((id, _, _, city), ()) -> (city, id))
    | join(places, (_, person, (_, parent)) -> (parent, person))
    | join(places, (_, person, (name, _)) -> ((name), (person))) | arrange;
