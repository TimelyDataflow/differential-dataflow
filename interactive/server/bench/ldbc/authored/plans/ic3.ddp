-- IC3. Friends and friends-of-friends who live outside countries X and Y but posted
-- from both inside a time window; top 20 by messages from X and Y together.
-- The two countries' messages in the window are found first (joining on the
-- country id), and only then matched against the person's circle.

let request = input 0 : ((int, int, List(int), List(int), int, int) ; ());   -- (rid, person, X, Y, start, days)
let person  = import "ldbc.person"  : ((int, List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int) ; ());
let message = import "ldbc.message" : ((int, int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int) ; ());
let knows   = import "ldbc.knows" : ((int, int, int) ; ());
let place   = import "ldbc.place" : ((int, List(int), List(int), int) ; ());

-- Friendships in both directions, between people who exist.
let exists = person | map(((id, _, _, _, _, _, _, _, _, _, _, _), ()) -> (id, ())) | distinct;
let either = (knows | map(((a, b, _), ()) -> (a, b))) + (knows | map(((a, b, _), ()) -> (b, a)));
let friend = either | join(exists, (a, b, ()) -> (b, a))
                    | join(exists, (b, a, ()) -> ((a, b), ())) | distinct
                    | map(((a, b), ()) -> (a, b));

-- Country ids by name ("Country" is the place type), and each person's country.
let countries  = place | filter(((_, _, kind, _), ()) -> (kind, [67,111,117,110,116,114,121]) eq)
                       | map(((id, name, _, _), ()) -> (name, id));
let parent     = place | map(((id, _, _, up), ()) -> (id, up));
let country_of = person | map(((id, _, _, _, _, _, _, _, city, _, _, _), ()) -> (city, id))
                        | join(parent, (_, who, country) -> (who, country));

-- The request with X and Y as ids: (rid, (person, x, y, start, end)).
let asked = request | map(((rid, who, x, y, start, days), ()) -> (x, (rid, who, y, start, (start, (days, 86400000) mul) add)))
                    | join(countries, (_, (rid, who, y, start, end), x) -> (y, (rid, who, x, start, end)))
                    | join(countries, (_, (rid, who, x, start, end), y) -> (rid, (who, x, y, start, end)));

-- Messages sent from X or from Y inside the window: ((rid, author), (in X, in Y)).
let sent_from = message | map(((_, _, created, author, country, _, _, _, _, _, _, _, _, _), ()) -> (country, (author, created)));
let window    = (asked | map((rid, (_, x, _, start, end)) -> (x, (rid, start, end, 1, 0))))
              + (asked | map((rid, (_, _, y, start, end)) -> (y, (rid, start, end, 0, 1))));
let visits    = window | join(sent_from, (_, (rid, start, end, ix, iy), (author, created)) -> ((rid, author), (created, start, end, ix, iy)))
                       | filter((_, (created, start, end, _, _)) -> ((created, start) ge, (created, end) lt) all)
                       | map((key, (_, _, _, ix, iy)) -> (key, (ix, iy)));

-- The circle (one or two hops, not the person), living outside both X and Y.
let hop1   = asked | map((rid, (who, x, y, _, _)) -> (who, (rid, who, x, y))) | join(exists, (who, req, ()) -> (who, req))
                   | join(friend, (_, req, f) -> (f, req));
let hop2   = hop1 | join(friend, (_, req, g) -> (g, req));
let circle = (hop1 + hop2) | filter((node, (_, who, _, _)) -> (node, who) ne)
                           | join(country_of, (node, (rid, _, x, y), home) -> ((rid, node), (x, y, home)))
                           | filter((_, (x, y, home)) -> ((home, x) ne, (home, y) ne) all)
                           | map((key, _) -> (key, ())) | distinct;

-- Per person in the circle: messages from X and from Y. A count of zero has no row,
-- so "both positive" is a join of the two counts.
let seen   = visits | join(circle, (key, (ix, iy), ()) -> (key, (ix, iy)));
let in_x   = seen | filter((_, (ix, _)) -> (ix, 1) eq) | map((key, _) -> (key, ())) | count;
let in_y   = seen | filter((_, (_, iy)) -> (iy, 1) eq) | map((key, _) -> (key, ())) | count;
let counts = in_x | join(in_y, (key, nx, ny) -> (key, (nx, ny)));
let names  = person | map(((id, first, last, _, _, _, _, _, _, _, _, _), ()) -> (id, (first, last)));
let ranked = counts | map(((rid, node), (nx, ny)) -> (node, (rid, nx, ny)))
                    | join(names, (node, (rid, nx, ny), (first, last)) -> (rid, (((nx, ny) add neg, node), (first, last, nx, ny))))
                    | collect | flatmap((_, entries) -> entries) | filter((_, (rank, _)) -> (rank, 20) lt);
let answer = ranked | map((rid, (rank, ((_, node), (first, last, nx, ny)))) -> ((rid, rank), (node, first, last, nx, ny, (nx, ny) add)));

export "ic3.answer" = answer | arrange;
