-- IC12. Expert search: friends who replied to posts tagged with a tag of the given class
-- or any of its subclasses; count of such replies and the tags involved; top 20.

let request  = input 0 : ((int, int, List(int)) ; ());         -- (rid, person, class name)
let person  = import "ldbc.person"  : ((int, List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int) ; ());
let message = import "ldbc.message" : ((int, int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int) ; ());
let knows   = import "ldbc.knows"   : ((int, int, int) ; ());
let tag     = import "ldbc.tag"     : ((int, List(int), int) ; ());
let tagclass = import "ldbc.tagclass" : ((int, List(int), int) ; ());
let mtag    = import "ldbc.mtag"    : ((int, int) ; ());

-- Friendships in both directions, between people who exist.
let exists = person | map(((id, _, _, _, _, _, _, _, _, _, _, _), ()) -> (id, ())) | distinct;
let either = (knows | map(((a, b, _), ()) -> (a, b))) + (knows | map(((a, b, _), ()) -> (b, a)));
let friend = either | join(exists, (a, b, ()) -> (b, a))
                    | join(exists, (b, a, ()) -> ((a, b), ())) | distinct
                    | map(((a, b), ()) -> (a, b));
let names   = person | map(((id, first, last, _, _, _, _, _, _, _, _, _), ()) -> (id, (first, last)));

-- Class ancestry: every class is below itself, and below its parent's ancestors.
let selves = tagclass | map(((id, _, _), ()) -> ((id, id), ()));
let up     = tagclass | filter(((_, _, parent), ()) -> (parent, 0) ge) | map(((id, _, parent), ()) -> (id, parent));
below: {
    let step  = below | map(((low, high), ()) -> (high, low)) | join(up, (_, low, higher) -> ((low, higher), ()));
    var below = selves + step | distinct;
}

-- Tagged posts in the requested class: ((rid, post), tag name).
let classes = tagclass | map(((id, name, _), ()) -> (name, id));
let posts   = message | filter(((_, kind, _, _, _, _, _, _, _, _, _, _, _, _), ()) -> (kind, 0) eq)
                      | map(((id, _, _, _, _, _, _, _, _, _, _, _, _, _), ()) -> (id, ()));
let intag   = request | map(((rid, _, name), ()) -> (name, rid))
                      | join(classes, (_, rid, high) -> (high, rid))
                      | join(below::below | map(((low, high), ()) -> (high, low)), (_, rid, low) -> (low, rid))
                      | join(tag | map(((id, name, cls), ()) -> (cls, (id, name))), (_, rid, (t, name)) -> (t, (rid, name)))
                      | join(mtag | map(((m, t), ()) -> (t, m)), (_, (rid, name), m) -> (m, (rid, name)))
                      | join(posts, (m, (rid, name), ()) -> ((rid, m, name), ()));   -- each tag reached once; names unique

-- Friends' replies to those posts.
let reply   = message | filter(((_, kind, _, _, _, _, _, _, _, _, _, _, _, _), ()) -> (kind, 1) eq)
                      | map(((id, _, _, who, _, _, _, _, _, _, parent, _, _, _), ()) -> (who, (id, parent)));
let hits    = request | map(((rid, who, _), ()) -> (who, rid))
                      | join(exists, (who, rid, ()) -> (who, rid))
                      | join(friend, (_, rid, f) -> (f, rid))
                      | join(reply, (f, rid, (id, parent)) -> ((rid, parent), (f, id)))
                      | join(intag | map(((rid, m, name), ()) -> ((rid, m), name)), ((rid, _), (f, id), name) -> ((rid, f), (id, name)));

-- Per friend: distinct replies counted, distinct tag names listed.
let counts  = hits | map(((rid, f), (id, _)) -> ((rid, f, id), ())) | distinct
                   | map(((rid, f, _), ()) -> ((rid, f), ())) | count;
let tagset  = hits | map(((rid, f), (_, name)) -> ((rid, f, name), ())) | distinct
                   | map(((rid, f, name), ()) -> ((rid, f), name)) | collect;
let ranked  = counts | join(tagset, ((rid, f), n, list) -> (f, (rid, n, list)))
                     | join(names, (f, (rid, n, list), (first, last)) -> (rid, ((n neg, f), (first, last, list))))
                     | collect | flatmap((_, entries) -> entries) | filter((_, (rank, _)) -> (rank, 20) lt);
let answer  = ranked | map((rid, (rank, ((neg, f), (first, last, list)))) -> ((rid, rank), (f, first, last, list, neg neg)));

export "ic12.answer" = answer | arrange;
