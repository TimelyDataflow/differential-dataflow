-- BI15. The cheapest path between two people, where a friendship costs 2 / (s + 2)
-- and s scores the pair's replies (2 to a post, 1 to a comment) in forums created
-- inside [start, end]. Searched from both ends at once; a friendship's cost is only
-- computed when the search reaches it.

let request = input 0 : ((int, int, int, int, int) ; ());     -- (rid, from, to, start, end)
let person  = import "ldbc.person"  : ((int, List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int) ; ());
let message = import "ldbc.message" : ((int, int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int) ; ());
let knows   = import "ldbc.knows" : ((int, int, int) ; ());
let forum   = import "ldbc.forum" : ((int, List(int), int, int) ; ());

-- Friendships in both directions, between people who exist.
let exists = person | map(((id, _, _, _, _, _, _, _, _, _, _, _), ()) -> (id, ())) | distinct;
let either = (knows | map(((a, b, _), ()) -> (a, b))) + (knows | map(((a, b, _), ()) -> (b, a)));
let friend = either | join(exists, (a, b, ()) -> (b, a))
                    | join(exists, (b, a, ()) -> ((a, b), ())) | distinct
                    | map(((a, b), ()) -> (a, b));

-- Threads: every post roots its own thread; a comment joins its parent's thread.
-- Rows are (message, root, forum of the root post).
let roots   = message | filter(((_, kind, _, _, _, _, _, _, _, _, _, _, _, _), ()) -> (kind, 0) eq)
                      | map(((id, _, _, _, _, _, _, _, _, forum, _, _, _, _), ()) -> ((id, id, forum), ()));
let replies = message | filter(((_, kind, _, _, _, _, _, _, _, _, _, _, _, _), ()) -> (kind, 1) eq)
                      | map(((id, _, _, _, _, _, _, _, _, _, parent, _, _, _), ()) -> (parent, id));
thread: {
    let below  = thread | map(((mid, root, forum), ()) -> (mid, (root, forum)))
                        | join(replies, (_, (root, forum), child) -> ((child, root, forum), ()));
    var thread = roots + below | distinct;
}
let forum_of = thread::thread | map(((mid, _, forum), ()) -> (mid, forum));

-- Every reply between two friends, scored and dated by its thread's forum:
-- ((a, b), (forum created, score)), in both directions.
let author  = message | map(((id, kind, _, who, _, _, _, _, _, _, _, _, _, _), ()) -> (id, (who, kind)));
let reply   = replies | join(author, (_, child, (to, kind)) -> (child, (to, ((kind, 0) eq, 2, 1) select)))
                      | join(author, (child, (to, score), (from, _)) -> (child, (from, to, score)))
                      | filter((_, (from, to, _)) -> (from, to) ne);
let created = forum | map(((id, _, when, _), ()) -> (id, when));
let dated   = reply | join(forum_of, (_, (from, to, score), f) -> (f, (from, to, score)))
                    | join(created, (_, (from, to, score), when) -> ((from, to), (when, score)));
let scored  = (dated + (dated | map(((from, to), v) -> ((to, from), v))))
            | join(friend | map((a, b) -> ((a, b), ())), (pair, v, ()) -> (pair, v));

let window  = request | map(((rid, _, _, start, end), ()) -> (rid, (start, end)));
-- Sums: move each value into the multiplicity (join_function) and let `count` add them up.
let starts  = (request | map(((rid, from, _, _, _), ()) -> ((rid, 0, from, 0 to_float), ())))
            + (request | map(((rid, _, to, _, _), ()) -> ((rid, 1, to, 0 to_float), ())));

search: {
    -- The best meeting so far: least cost0 + cost1 over nodes both sides reached.
    let side0  = search | filter(((_, side, _, _), ()) -> (side, 0) eq) | map(((rid, _, node, c), ()) -> ((rid, node), c));
    let side1  = search | filter(((_, side, _, _), ()) -> (side, 1) eq) | map(((rid, _, node, c), ()) -> ((rid, node), c));
    let best   = side0 | join(side1, ((rid, _), c0, c1) -> (rid, (c0, c1) add)) | min;

    -- A row keeps growing until its request has met, then only while 2·cost < best.
    let by_rid = search | map(((rid, side, node, c), ()) -> (rid, (side, node, c)));
    let met    = best | map((rid, _) -> (rid, ()));
    let open   = by_rid - (by_rid | join(met, (rid, row, ()) -> (rid, row)));
    let near   = by_rid | join(best, (rid, (side, node, c), b) -> (rid, (side, node, c, b)))
                        | filter((_, (_, _, c, b)) -> ((c, c) add, b) lt)
                        | map((rid, (side, node, c, _)) -> (rid, (side, node, c)));
    let steps  = (open + near) | map((rid, (side, node, c)) -> (node, (rid, side, c)))
                               | join(friend, (node, (rid, side, c), next) -> ((rid, node, next), (side, c)));

    -- Cost only the friendships being crossed: sum scores inside the request's window.
    let wanted = steps | map((key, _) -> (key, ())) | distinct;
    let inside = wanted | map(((rid, a, b), ()) -> ((a, b), rid))
                        | join(scored, (pair, rid, (when, score)) -> (rid, (pair, when, score)))
                        | join(window, (rid, ((a, b), when, score), (start, end)) -> ((rid, a, b), (when, score, start, end)))
                        | filter((_, (when, _, start, end)) -> ((when, start) ge, (when, end) le) all)
                        | map((key, (_, score, _, _)) -> (key, score));
    let summed = inside | join_function((key, score) -> ((key, ()), (0, 0), score) enlist) | count;
    let scores = summed + ((wanted - (wanted | join(summed, (key, (), _) -> (key, ())))) | map((key, ()) -> (key, 0)));
    let cost   = scores | map((key, s) -> (key, (2.0, (s, 2) add to_float) div));
    let grow   = steps | join(cost, ((rid, _, next), (side, c), w) -> ((rid, side, next, (c, w) add), ()));

    var search = (starts + search + grow) | map(((rid, side, node, c), ()) -> ((rid, side, node), c)) | min
                                          | map(((rid, side, node), c) -> ((rid, side, node, c), ()));
}

let side0  = search::search | filter(((_, side, _, _), ()) -> (side, 0) eq) | map(((rid, _, node, c), ()) -> ((rid, node), c));
let side1  = search::search | filter(((_, side, _, _), ()) -> (side, 1) eq) | map(((rid, _, node, c), ()) -> ((rid, node), c));
let best   = side0 | join(side1, ((rid, _), c0, c1) -> (rid, (c0, c1) add)) | min;

let asked  = request | map(((rid, _, _, _, _), ()) -> (rid, ()));
let never  = asked - (asked | join(best, (rid, (), _) -> (rid, ())));
let answer = (best | map((rid, c) -> ((rid, 0), (c)))) + (never | map((rid, ()) -> ((rid, 0), (-1 to_float))));

export "bi15.answer" = answer | arrange;
