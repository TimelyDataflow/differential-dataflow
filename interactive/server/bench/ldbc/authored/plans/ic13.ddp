-- IC13. Length of the shortest friendship path between two people, or -1.
-- Searched from both ends at once: each side stops growing once twice its
-- distance reaches the best meeting found so far.

let request = input 0 : ((int, int, int) ; ());               -- (rid, from, to)
let person  = import "ldbc.person" : ((int, List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int) ; ());
let knows   = import "ldbc.knows"  : ((int, int, int) ; ());

-- Friendships in both directions, between people who exist.
let exists = person | map(((id, _, _, _, _, _, _, _, _, _, _, _), ()) -> (id, ())) | distinct;
let either = (knows | map(((a, b, _), ()) -> (a, b))) + (knows | map(((a, b, _), ()) -> (b, a)));
let friend = either | join(exists, (a, b, ()) -> (b, a))
                    | join(exists, (b, a, ()) -> ((a, b), ())) | distinct
                    | map(((a, b), ()) -> (a, b));

-- Searches are rows (rid, side, node, hops): side 0 grows from `from`, side 1 from `to`.
let starts = (request | map(((rid, from, _), ()) -> ((rid, 0, from, 0), ())))
           + (request | map(((rid, _, to), ()) -> ((rid, 1, to, 0), ())));

search: {
    -- The best meeting so far: a node both sides reached, with the least total hops.
    let side0  = search | filter(((_, side, _, _), ()) -> (side, 0) eq) | map(((rid, _, node, d), ()) -> ((rid, node), d));
    let side1  = search | filter(((_, side, _, _), ()) -> (side, 1) eq) | map(((rid, _, node, d), ()) -> ((rid, node), d));
    let best   = side0 | join(side1, ((rid, _), d0, d1) -> (rid, (d0, d1) add)) | min;

    -- A row keeps growing until its request has met, then only while 2·hops < best.
    let by_rid = search | map(((rid, side, node, d), ()) -> (rid, (side, node, d)));
    let met    = best | map((rid, _) -> (rid, ()));
    let open   = by_rid - (by_rid | join(met, (rid, row, ()) -> (rid, row)));
    let near   = by_rid | join(best, (rid, (side, node, d), b) -> (rid, (side, node, d, b)))
                        | filter((_, (_, _, d, b)) -> ((d, d) add, b) lt)
                        | map((rid, (side, node, d, _)) -> (rid, (side, node, d)));
    let grow   = (open + near) | map((rid, (side, node, d)) -> (node, (rid, side, d)))
                               | join(friend, (_, (rid, side, d), next) -> ((rid, side, next, (d, 1) add), ()));

    var search = (starts + search + grow) | map(((rid, side, node, d), ()) -> ((rid, side, node), d)) | min
                                          | map(((rid, side, node), d) -> ((rid, side, node, d), ()));
}

let side0  = search::search | filter(((_, side, _, _), ()) -> (side, 0) eq) | map(((rid, _, node, d), ()) -> ((rid, node), d));
let side1  = search::search | filter(((_, side, _, _), ()) -> (side, 1) eq) | map(((rid, _, node, d), ()) -> ((rid, node), d));
let best   = side0 | join(side1, ((rid, _), d0, d1) -> (rid, (d0, d1) add)) | min;

-- Requests whose two sides never met get -1.
let asked  = request | map(((rid, _, _), ()) -> (rid, ()));
let never  = asked - (asked | join(best, (rid, (), _) -> (rid, ())));
let answer = (best | map((rid, d) -> ((rid, 0), (d)))) + (never | map((rid, ()) -> ((rid, 0), (-1))));

export "ic13.answer" = answer | arrange;
