-- IC8. The 20 most recent replies to a person's messages. Ranked on narrow rows; the
-- text and the repliers' names are fetched only for the 20.

let request = input 0 : ((int, int) ; ());                    -- (rid, person)
let person  = import "ldbc.person"  : ((int, List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int) ; ());
let message = import "ldbc.message" : ((int, int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int) ; ());
let names   = person | map(((id, first, last, _, _, _, _, _, _, _, _, _), ()) -> (id, (first, last)));

let author  = message | map(((id, _, _, who, _, _, _, _, _, _, _, _, _, _), ()) -> (id, who));
let comment = message | filter(((_, kind, _, _, _, _, _, _, _, _, _, _, _, _), ()) -> (kind, 1) eq)
                      | map(((id, _, created, who, _, _, _, _, _, _, parent, _, _, _), ()) -> (parent, (id, created, who)));
let replies = comment | join(author, (_, (id, created, who), op) -> (op, (id, created, who)));
let top     = request | map(((rid, who), ()) -> (who, rid))
                      | join(replies, (_, rid, (id, created, who)) -> (rid, ((created neg, id), who)))
                      | collect | flatmap((_, entries) -> entries) | filter((_, (rank, _)) -> (rank, 20) lt);

let text    = message | map(((id, _, _, _, _, content, _, _, _, _, _, _, _, _), ()) -> (id, content));
let answer  = top | map((rid, (rank, ((neg, id), who))) -> (id, (rid, rank, neg neg, who)))
                  | join(text, (id, (rid, rank, created, who), content) -> (who, (rid, rank, id, content, created)))
                  | join(names, (who, (rid, rank, id, content, created), (first, last)) -> ((rid, rank), (who, first, last, created, id, content)));

export "ic8.answer" = answer | arrange;
