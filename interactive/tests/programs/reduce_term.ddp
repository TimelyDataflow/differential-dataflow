-- Reductions written as terms, checked against vec: the term reads the key and a list of
-- `(val, diff)`, and lists the output with diffs. Weighted sums and maxima fold the list; `$1`
-- alone is the identity; an output diff need not be one, and may be negative.
let pairs = input 0 : ((int, int) ; ()) | key($0[0] ; $0[1]);

export "sum" = pairs | reduce(list(tuple(tuple(fold($1, 0, ^1 + ^0[0][0] * ^0[1])), 1)));
export "max" = pairs | reduce(list(tuple(tuple(fold($1, 0 - 1000000, if(^0[0][0] > ^1, ^0[0][0], ^1))), 1)));
export "same" = pairs | reduce($1);
export "weights" = pairs | reduce(list(tuple(tuple(len($1)), 0 - 2), tuple(tuple(fold($1, 0, ^1 + ^0[1])), 3)));
-- A two-field key, which the arrangement identifies by its hash.
export "pair_keys" = pairs | key($0, 7 ; $1) | reduce(list(tuple(tuple(fold($1, 0, ^1 + ^0[1])), 1)));
