-- Scalar unaries on the corgi compiled path, checked against the vec backend:
-- negation, `not` as a comparison with zero, and list `len` (along `collect`ed values).

let pairs = input 0 : ((int, int, int) ; ()) | key(((k, a, b), ()) -> ((k), (a, b)));
let mapped = pairs
    | key((k, (a, _)) -> (k, (a neg, ((a, 2) gt, 0) eq)))
    | filter((_, (n, _)) -> ((n, -5) eq, 0) eq);

let lengths = pairs | key((k, (a, _)) -> (k, (a))) | collect | key((k, l) -> (k, (l len)));

export "mapped" = mapped | arrange | inspect(total);
export "lengths" = lengths | arrange | inspect(total);
