-- A join keyed on a 2-tuple: exercises the lane-tuple key path (lexicographic
-- lane-buffer walk + tuple-needle probe, ordinal tokens) rather than the
-- single-lane or structural walks. The gate is agreement with vec.

let left  = input 0 : ((int, int, int), ()) | map(((a, b, c), ()) -> ((a, b), c));
let right = input 1 : ((int, int, int), ()) | map(((a, b, c), ()) -> ((a, b), c));
let out = left | join(right, (k, l, r) -> (k, (l, r) add));

export "result" = out | arrange | inspect(total);
