-- Connected components by label propagation, written with `+` as a pipeline stage:
-- `a | map(f) + b | distinct` is `((a | map(f)) + b) | distinct`.

let raw   = input 0 : ((int, int), ());

-- symmetrize the edges, and name the nodes
let edges = raw | map(((a, b), ()) -> ((b, a), ())) + raw | distinct | map(((a, b), ()) -> (a, b));
let nodes = edges | map((a, _) -> (a, ())) | distinct;

-- each node starts with its own name as a label and keeps the least label it has seen
cc: {
    let props  = labels | join(edges, (_, lbl, dst) -> (dst, lbl));
    set labels = nodes | map((n, _) -> (n, n)) + props | min;
}

-- the labels now name the components
export "parts" = cc::labels | map((_, label) -> (label, ())) | arrange | inspect(total);
