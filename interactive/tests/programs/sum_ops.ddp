-- Sum intro and tag tests on the corgi compiled path, checked against vec: a data-driven tag,
-- `(payload, tag) branch Three` (Op::Branch over a homogeneous declared type), and tag tests by
-- `match` on a sum (MapSum + Unwrap, incl. a tag no row carries).
type Three = A int | B int | C int;

let pairs = input 0 : ((int, int) ; ()) | key(((a, b), ()) -> ((a), (b)));
let tagged = pairs
    | key((k, (b)) -> (k, (let s = (b, 2) branch Three in (s, s match (A (_ -> 0), B (_ -> 0), C (_ -> 1)), s match (A (_ -> 0), B (_ -> 1), C (_ -> 0))))));

export "result" = tagged | arrange | inspect(total);
