-- Count must group on the complete key. Only its output may be masked.
let rows = input 0 : ((int, int), ());
let counted = rows | count;
output "out" = counted | map(((a, _), n) -> (a, n));

-- Value projections belong in the reduction expression.
let values = input 1 : (int, (int, int));
output "minimum" = values | min | map((k, (_, v)) -> (k, ((), v)));
output "unique" = values | distinct | map((k, (_, v)) -> (k, ((), v)));
output "counted" = values | count | map((k, _) -> (k, ()));
output "collected" = values | collect | map((k, _) -> (k, ()));
let custom = values | reduce((_, vals) -> vals map ((v, d) -> (v, (d, 2) mul)));
output "custom" = custom | map((k, (_, v)) -> ((k, v), ()));
