-- Only the strict reader may discard G; the shared lift must retain it.
let rows = input "rows" : (int, int);
let lifted = rows | lift;
output "strict" = lifted | half_join(rows, 1, (k, ((v, _), t)) -> (k, (v, t)));
output "inclusive" = lifted | half_join(rows, 0, (k, ((v, _), t)) -> (k, (v, t)));
