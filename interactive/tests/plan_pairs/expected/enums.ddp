type Entry = Empty | Number int | Pair (int, int);
-- Time lanes: epoch.
let rows = input 0 : (int, Entry);
let out_rows = rows | map((k, v) -> (k, v match (Empty (_ -> 0), Number (n -> n), Pair ((a, b) -> (a, b) add)))) | map((k, n) -> (k, n inject Entry::Number));
-- Renderer: build an export arrangement.
export "out" = out_rows;
