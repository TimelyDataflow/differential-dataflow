enum Entry = Empty | Number int | Pair (int, int);
-- Time lanes: epoch.
let rows = input 0 : (int, Entry);
let out_map = rows | map((k, v) -> let (k, n) = (k, v match (Empty (_ -> 0), Number (n -> n), Pair ((a, b) -> (a, b) add))) in (k, n inject Entry::Number));
-- Renderer: build an export arrangement.
output "out" = out_map;
