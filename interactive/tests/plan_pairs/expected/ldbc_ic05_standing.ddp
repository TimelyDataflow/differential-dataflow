-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (1, []), placeholder install epoch 2.
let message = import "ldbc.message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let member = import "ldbc.member.by_person" : (int, (int, int));
let posted_rows = message | filter((_, (kind, _, _, _, _, _, _, _, _, _, _, _, _)) -> (kind, 0) eq) | map((_, (_, _, who, _, _, _, _, _, f, _, _, _, _)) -> ((who, f), ()));
let posted_idx = posted_rows | arrange;
let posted = posted_idx | count;
let first_map = member | map((who, (_, since)) -> (who, since));
let first_idx = first_map | arrange;
let first = first_idx | min;
let lowest_map = member | map((who, (f, _)) -> (who, f));
let lowest_idx = lowest_map | arrange;
let lowest_reduce = lowest_idx | reduce((_, vals) -> let positive = (vals map ((_, d) -> (d, 0) gt), (0, vals len) range) zip filter in let indices = ((0, (positive len, 40) min) range, positive) gather in let prefix = (indices, vals) gather in let ends = prefix map ((_, d) -> (d, 40) min) scan_add in let chosen = (prefix, ends) zip map (((item, d), end) -> let count = (d, 40) min in let before = (end, count) sub in let keep = (((40, before) sub, 0) max, count) min in ((keep, 0) gt, (item, keep))) filter in let ends = chosen map ((_, d) -> d) scan_add in (chosen, ends) zip map (((item, d), end) -> (item, ((end, d) sub, end) range) cap_list map ((item, rank) -> ((rank, item), 1))) flatten .1);
let lowest_map2 = lowest_reduce | map((a, (_, b)) -> (a, ((), b)));
let lowest = lowest_map2 | map((who, (_, f)) -> (who, f));
let lowest_idx2 = lowest | arrange;
-- Renderer: publish the existing arrangement.
export "ic5.s.posted" = posted;
-- Renderer: publish the existing arrangement.
export "ic5.s.first" = first;
-- Renderer: publish the existing arrangement.
export "ic5.s.lowest" = lowest_idx2;
