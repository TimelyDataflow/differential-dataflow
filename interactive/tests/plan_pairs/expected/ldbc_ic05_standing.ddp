-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (0, []).
let message = import "ldbc.message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let member = import "ldbc.member.by_person" : (int, (int, int));
let posted_rows = message | filter((_, (kind, _, _, _, _, _, _, _, _, _, _, _, _)) -> (kind, 0) eq) | map((_, (_, _, who, _, _, _, _, _, f, _, _, _, _)) -> ((who, f), ()));
let posted_idx = posted_rows | arrange;
let posted = posted_idx | reduce((_, vals) -> let diffs = vals map ((_, d) -> d) in let n = diffs fold_add in (n, (n, 1)) enlist filter);
let first_map = member | map((who, (_, since)) -> (who, since));
let first_idx = first_map | arrange;
let first = first_idx | reduce((_, vals) -> let first = vals head in (first.0, 1) enlist);
let lowest_map = member | map((who, (f, _)) -> (who, f));
let lowest_idx = lowest_map | arrange;
let lowest = lowest_idx | reduce((_, a) -> let v0 = (a map ((_, a) -> (a, 0) gt), (0, a len) range) zip filter in let v1 = (((0, (v0 len, 40) min) range, v0) gather, a) gather in let v2 = (v1, v1 map ((_, a) -> (a, 40) min) scan_add) zip map ((a, b) -> let v0 = (a.1, 40) min in let v1 = (((40, (b, v0) sub) sub, 0) max, v0) min in ((v1, 0) gt, (a.0, v1))) filter in (v2, v2 map ((_, a) -> a) scan_add) zip map ((a, b) -> (a.0, ((b, a.1) sub, b) range) cap_list map ((a, b) -> ((b, a), 1))) flatten.1 map ((a, b) -> (a.1, b)));
-- Renderer: publish the existing arrangement.
export "ic5.s.posted" = posted;
-- Renderer: publish the existing arrangement.
export "ic5.s.first" = first;
-- Renderer: publish the existing arrangement.
export "ic5.s.lowest" = lowest;
