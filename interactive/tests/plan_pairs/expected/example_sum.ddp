-- Time lanes: epoch.
-- Bound inputs use provider arrangements; history advances to G = (0, []).
let orders = input "orders" : (int, (int, int));
let totals_rows = orders | map((_, (customer, amount)) -> (customer, amount)) | lift | join_function((k, (v, t)) -> ((k, ()), t, v) enlist);
let totals_idx = totals_rows | arrange;
let totals_reduce = totals_idx | reduce((_, vals) -> let diffs = vals map ((_, d) -> d) in let n = diffs fold_add in (n, (n, 1)) enlist filter);
-- Renderer: publish the existing arrangement.
output "totals" = totals_reduce;
