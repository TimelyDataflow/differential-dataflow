-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (0, []).
let request = input 0 : ((int, int, List(int), int), ());
let person = import "ldbc.person" : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let friend = import "ldbc.friend" : (int, (int, int));
let work = import "ldbc.work.by_person" : (int, (int, int));
let org = import "ldbc.org" : (int, (List(int), List(int), int));
let place = import "ldbc.place" : (int, (List(int), List(int), int));
let hop1_map = request | map(((rid, who, country, year), ()) -> (who, (rid, who, country, year)));
let hop1_idx = hop1_map | arrange;
let person_idx = person | arrange;
let hop1_join = hop1_idx | join(person_idx, (who, req, _) -> (who, req));
let hop1_idx2 = hop1_join | arrange;
let friend_idx = friend | arrange;
let hop1 = hop1_idx2 | join(friend_idx, (_, req, (f, _)) -> (f, req));
let hop1_idx3 = hop1 | arrange;
let hop2 = hop1_idx3 | join(friend_idx, (_, req, (g, _)) -> (g, req));
let circle_rows = hop1 + hop2;
let circle_rows2 = circle_rows | filter((node, (_, who, _, _)) -> (node, who) ne) | map((node, (rid, _, country, year)) -> ((node, rid, country, year), ()));
let circle_idx = circle_rows2 | arrange;
let circle = circle_idx | reduce((_, vals) -> vals map (((), _) -> ((), 1)));
let jobs_map = circle | map(((node, rid, country, year), ()) -> (node, (rid, country, year)));
let jobs_idx = jobs_map | arrange;
let work_idx = work | arrange;
let jobs_join = jobs_idx | join(work_idx, (node, (rid, country, year), (at, since)) -> (at, (rid, node, country, year, since)));
let jobs_filter = jobs_join | filter((_, (_, _, _, year, since)) -> (since, year) lt);
let jobs_idx2 = jobs_filter | arrange;
let org_idx = org | arrange;
let jobs_join2 = jobs_idx2 | join(org_idx, (_, (rid, node, country, _, since), (company, _, located)) -> (located, ((rid, since, node), (company, country))));
let jobs_idx3 = jobs_join2 | arrange;
let place_idx = place | arrange;
let jobs_join3 = jobs_idx3 | join(place_idx, (_, (key, (company, country)), (there, _, _)) -> (key, (company, country, there)));
let jobs = jobs_join3 | filter((_, (_, country, there)) -> (country, there) eq) | map((key, (company, _, _)) -> (key, company));
let jobs_idx4 = jobs | arrange;
let named_reduce = jobs_idx4 | reduce((_, vals) -> let lists = vals map ((v, d) -> (v, (0, d) range) cap_list map ((v, _) -> v)) in let flat = lists flatten in (flat.1, 1) enlist);
let ranked_rows = named_reduce | flatmap((_, entries) -> entries) | map(((rid, since, node), (pos, company)) -> (node, (rid, since, pos, company)));
let ranked_idx = ranked_rows | arrange;
let ranked_join = ranked_idx | join(person_idx, (node, (rid, since, pos, company), (first, last, _, _, _, _, _, _, _, _, _)) -> (rid, ((since, node, pos neg), (first, last, company))));
let ranked_idx2 = ranked_join | arrange;
let ranked = ranked_idx2 | reduce((_, vals) -> let positive = (vals map ((_, d) -> (d, 0) gt), (0, vals len) range) zip filter in let indices = ((0, (positive len, 10) min) range, positive) gather in let prefix = (indices, vals) gather in let ends = prefix map ((_, d) -> (d, 10) min) scan_add in let chosen = (prefix, ends) zip map (((item, d), end) -> let count = (d, 10) min in let before = (end, count) sub in let keep = (((10, before) sub, 0) max, count) min in ((keep, 0) gt, (item, keep))) filter in let ends = chosen map ((_, d) -> d) scan_add in (chosen, ends) zip map (((item, d), end) -> (item, ((end, d) sub, end) range) cap_list map ((item, rank) -> ((rank, item), 1))) flatten .1);
let answer = ranked | map((rid, (rank, ((since, node, _), (first, last, company)))) -> ((rid, rank), (node, first, last, company, since)));
let answer_idx = answer | arrange;
-- Renderer: publish the existing arrangement.
export "ic11x1.answer" = answer_idx;
