-- Time lanes: epoch.
-- Bound inputs use provider arrangements; history advances to G = (0, []).
let rows = input "rows" : (int, int);
let out_rows = rows | lift | filter((_, (_, (t0))) -> (t0, 0) ne);
let rows_idx = rows | arrange;
let out_join = out_rows | half_join(rows_idx, 1, (k, ((v, _), t)) -> (k, (v, t)));
-- Renderer: build an export arrangement.
output "out" = out_join;
