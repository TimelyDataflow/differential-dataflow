-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (1, []), placeholder install epoch 2.
let request = input 0 : ((int, int), ());
let person = import "ldbc.person" : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let message = import "ldbc.message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let answer_map = request | map(((rid, m), ()) -> (m, rid));
let answer_idx = answer_map | arrange;
let message_idx = message | arrange;
let answer_join = answer_idx | join(message_idx, (_, rid, (_, _, who, _, _, _, _, _, _, _, _, _, _)) -> (who, rid));
let answer_idx2 = answer_join | arrange;
let person_idx = person | arrange;
let answer = answer_idx2 | join(person_idx, (who, rid, (first, last, _, _, _, _, _, _, _, _, _)) -> ((rid, 0), (who, first, last)));
let answer_idx3 = answer | arrange;
-- Renderer: publish the existing arrangement.
export "is5.answer" = answer_idx3;
