-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (0, []).
let request = input 0 : ((int, int), ());
let person = import "graph::person" : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let message = import "graph::message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let answer_map = request | map(((rid, m), ()) -> (m, rid));
let answer_idx = answer_map | arrange;
let answer_join = answer_idx | join(message, (_, rid, (_, _, who, _, _, _, _, _, _, _, _, _, _)) -> (who, rid));
let answer_idx2 = answer_join | arrange;
let answer = answer_idx2 | join(person, (who, rid, (first, last, _, _, _, _, _, _, _, _, _)) -> ((rid, 0), (who, first, last)));
let answer_idx3 = answer | arrange;
-- Renderer: publish the existing arrangement.
output "answer" = answer_idx3;
