-- Time lanes: epoch.
let rows = input 0 : (int, int);
let left_map = rows | map((k, v) -> (k, (v, 1) add));
let left = left_map | filter((k, _) -> (k, 0) gt);
let right = left_map | filter((k, _) -> (k, 10) lt);
let out_rows = left + right + left;
-- Renderer: build an export arrangement.
export "out" = out_rows;
