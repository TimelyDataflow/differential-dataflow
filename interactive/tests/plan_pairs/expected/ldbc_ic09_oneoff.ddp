-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (0, []).
let request = input 0 : ((int, int, int), ());
let person = import "ldbc.person" : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let message = import "ldbc.message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let friend = import "ldbc.friend" : (int, (int, int));
let by_author = import "ic9.s.by_author" : (int, (int, int));
let latest = import "ic9.s.latest" : (int, (int, int));
let newest = import "ic9.s.newest" : (int, int);
let hop1_map = request | map(((rid, who, max), ()) -> (who, (rid, who, max)));
let hop1_idx = hop1_map | arrange;
let person_idx = person | arrange;
let hop1_join = hop1_idx | join(person_idx, (who, req, _) -> (who, req));
let hop1_idx2 = hop1_join | arrange;
let friend_idx = friend | arrange;
let hop1 = hop1_idx2 | join(friend_idx, (_, req, (f, _)) -> (f, req));
let hop1_idx3 = hop1 | arrange;
let hop2 = hop1_idx3 | join(friend_idx, (_, req, (g, _)) -> (g, req));
let friends_rows = hop1 + hop2;
let friends_rows2 = friends_rows | filter((node, (_, who, _)) -> (node, who) ne) | map((node, (rid, _, max)) -> ((node, rid, max), ()));
let friends_idx = friends_rows2 | arrange;
let friends_reduce = friends_idx | reduce((_, vals) -> vals map (((), _) -> ((), 1)));
let friends = friends_reduce | map(((node, rid, max), ()) -> (node, (rid, max)));
let friends_idx2 = friends | arrange;
let newest_idx = newest | arrange;
let ahead = friends_idx2 | join(newest_idx, (f, (rid, max), neg) -> (f, (rid, max, neg neg)));
let fast_rows = ahead | filter((_, (_, max, last)) -> (last, max) lt) | map((k, (v0, _, _)) -> (k, (v0, (), ())));
let fast_idx = fast_rows | arrange;
let latest_idx = latest | arrange;
let fast = fast_idx | join(latest_idx, (f, (rid, _, _), (neg, id)) -> (rid, ((neg, id), f)));
let slow_rows = ahead | filter((_, (_, max, last)) -> (last, max) ge) | map((k, (v0, v1, _)) -> (k, (v0, v1, ())));
let slow_idx = slow_rows | arrange;
let by_author_idx = by_author | arrange;
let slow_join = slow_idx | join(by_author_idx, (f, (rid, max, _), (neg, id)) -> ((rid, f), ((neg, id), max)));
let slow_rows2 = slow_join | filter((_, ((neg, _), max)) -> (neg neg, max) lt) | map((key, (order, _)) -> (key, order));
let slow_idx2 = slow_rows2 | arrange;
let slow_reduce = slow_idx2 | reduce((_, a) -> let v0 = (a map ((_, a) -> (a, 0) gt), (0, a len) range) zip filter in let v1 = (((0, (v0 len, 20) min) range, v0) gather, a) gather in let v2 = (v1, v1 map ((_, a) -> (a, 20) min) scan_add) zip map ((a, b) -> let v0 = (a.1, 20) min in let v1 = (((20, (b, v0) sub) sub, 0) max, v0) min in ((v1, 0) gt, (a.0, v1))) filter in (v2, v2 map ((_, a) -> a) scan_add) zip map ((a, b) -> (a.0, ((b, a.1) sub, b) range) cap_list map ((a, b) -> ((b, a), 1))) flatten.1 map ((a, b) -> (((), a.1), b)));
let slow = slow_reduce | map(((rid, f), (_, order)) -> (rid, (order, f)));
let top_rows = fast + slow;
let top_idx = top_rows | arrange;
let top = top_idx | reduce((_, vals) -> let positive = (vals map ((_, d) -> (d, 0) gt), (0, vals len) range) zip filter in let indices = ((0, (positive len, 20) min) range, positive) gather in let prefix = (indices, vals) gather in let ends = prefix map ((_, d) -> (d, 20) min) scan_add in let chosen = (prefix, ends) zip map (((item, d), end) -> let count = (d, 20) min in let before = (end, count) sub in let keep = (((20, before) sub, 0) max, count) min in ((keep, 0) gt, (item, keep))) filter in let ends = chosen map ((_, d) -> d) scan_add in (chosen, ends) zip map (((item, d), end) -> (item, ((end, d) sub, end) range) cap_list map ((item, rank) -> ((rank, item), 1))) flatten .1);
let answer_map = top | map((rid, (rank, ((neg, id), f))) -> (id, (rid, rank, neg neg, f)));
let answer_idx = answer_map | arrange;
let message_idx = message | arrange;
let answer_join = answer_idx | join(message_idx, (id, (rid, rank, created, f), (_, _, _, _, content, image, _, _, _, _, _, _, _)) -> (f, (rid, rank, id, ((content len, 0) gt, content, image) select, created)));
let answer_idx2 = answer_join | arrange;
let answer = answer_idx2 | join(person_idx, (f, (rid, rank, id, body, created), (first, last, _, _, _, _, _, _, _, _, _)) -> ((rid, rank), (f, first, last, id, body, created)));
let answer_idx3 = answer | arrange;
-- Renderer: publish the existing arrangement.
export "ic9x1.answer" = answer_idx3;
