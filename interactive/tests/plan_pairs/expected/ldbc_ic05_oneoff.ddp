-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (1, []), placeholder install epoch 2.
let request = input 0 : ((int, int, int), ());
let person = import "ldbc.person" : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let friend = import "ldbc.friend" : (int, (int, int));
let forum = import "ldbc.forum" : (int, (List(int), int, int));
let member = import "ldbc.member.by_person" : (int, (int, int));
let posted = import "ic5.s.posted" : ((int, int), int);
let first = import "ic5.s.first" : (int, int);
let lowest = import "ic5.s.lowest" : (int, int);
let hop1_map = request | map(((rid, who, date), ()) -> (who, (rid, who, date)));
let hop1_idx = hop1_map | arrange;
let person_idx = person | arrange;
let hop1_join = hop1_idx | join(person_idx, (who, req, _) -> (who, req));
let hop1_idx2 = hop1_join | arrange;
let friend_idx = friend | arrange;
let hop1 = hop1_idx2 | join(friend_idx, (_, req, (f, _)) -> (f, req));
let hop1_idx3 = hop1 | arrange;
let hop2 = hop1_idx3 | join(friend_idx, (_, req, (g, _)) -> (g, req));
let circle_rows = hop1 + hop2;
let circle_rows2 = circle_rows | filter((node, (_, who, _)) -> (node, who) ne) | map((node, (rid, _, date)) -> ((node, rid, date), ()));
let circle_idx = circle_rows2 | arrange;
let circle_reduce = circle_idx | reduce((_, vals) -> vals map (((), _) -> ((), 1)));
let circle = circle_reduce | map(((node, rid, date), ()) -> (node, (rid, date)));
let circle_idx2 = circle | arrange;
let member_idx = member | arrange;
let after_join = circle_idx2 | join(member_idx, (node, (rid, date), (f, since)) -> ((node, f), (rid, date, since)));
let after = after_join | filter((_, (_, date, since)) -> (since, date) gt) | map((key, (rid, _, _)) -> (key, rid));
let after_idx = after | arrange;
let posted_idx = posted | arrange;
let busy_join = after_idx | join(posted_idx, ((_, f), rid, n) -> ((rid, f), n));
let busy_rows = busy_join | join_function((key, n) -> ((key, ()), (0), n) enlist);
let busy_idx = busy_rows | arrange;
let busy = busy_idx | reduce((_, vals) -> let diffs = vals map ((_, d) -> d) in let n = diffs fold_add in (n, (n, 1)) enlist filter);
let first_idx = first | arrange;
let timed = circle_idx2 | join(first_idx, (node, (rid, date), since) -> (node, (rid, date, since)));
let fast_filter = timed | filter((_, (_, date, since)) -> (since, date) gt);
let fast_idx = fast_filter | arrange;
let lowest_idx = lowest | arrange;
let fast = fast_idx | join(lowest_idx, (_, (rid, _, _), f) -> ((rid, f), ()));
let slow_rows = timed | filter((_, (_, date, since)) -> (since, date) le) | map((node, (rid, _, _)) -> ((node, rid), ()));
let slow_idx = slow_rows | arrange;
let slow_map = after | map(((node, f), rid) -> ((node, rid), f));
let slow_idx2 = slow_map | arrange;
let slow = slow_idx | join(slow_idx2, ((_, rid), (), f) -> ((rid, f), ()));
let idle_rows = fast + slow;
let idle_idx = idle_rows | arrange;
let idle = idle_idx | reduce((_, vals) -> vals map (((), _) -> ((), 1)));
let quiet_join = idle | join(busy, (key, (), _) -> (key, ()));
let quiet_neg = quiet_join | negate;
let quiet_rows = idle + quiet_neg;
let quiet = quiet_rows | map((key, ()) -> (key, 0));
let ranked_rows = busy + quiet;
let ranked_map = ranked_rows | map(((rid, f), n) -> (f, (rid, n)));
let ranked_idx = ranked_map | arrange;
let forum_idx = forum | arrange;
let ranked_join = ranked_idx | join(forum_idx, (f, (rid, n), (title, _, _)) -> (rid, ((n neg, f), title)));
let ranked_idx2 = ranked_join | arrange;
let ranked = ranked_idx2 | reduce((_, vals) -> let positive = (vals map ((_, d) -> (d, 0) gt), (0, vals len) range) zip filter in let indices = ((0, (positive len, 20) min) range, positive) gather in let prefix = (indices, vals) gather in let ends = prefix map ((_, d) -> (d, 20) min) scan_add in let chosen = (prefix, ends) zip map (((item, d), end) -> let count = (d, 20) min in let before = (end, count) sub in let keep = (((20, before) sub, 0) max, count) min in ((keep, 0) gt, (item, keep))) filter in let ends = chosen map ((_, d) -> d) scan_add in (chosen, ends) zip map (((item, d), end) -> (item, ((end, d) sub, end) range) cap_list map ((item, rank) -> ((rank, item), 1))) flatten .1);
let answer = ranked | map((rid, (rank, ((neg, _), title))) -> ((rid, rank), (title, neg neg)));
let answer_idx = answer | arrange;
-- Renderer: publish the existing arrangement.
export "ic5x1.answer" = answer_idx;
