let request = input 0 : ((int, int, int), ());
let person = import "ldbc.person" : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let message = import "ldbc.message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let friend = import "ldbc.friend" : (int, (int, int));
let place = import "ldbc.place" : (int, (List(int), List(int), int));
let tags_of = import "ldbc.mtag.by_message" : (int, int);
let interest = import "ldbc.interest.by_person" : (int, int);
let people = import "ic10.s.people" : (int, (List(int), List(int), List(int), List(int), int, int));
let posts = import "ic10.s.posts" : (int, int);
let likes = import "ic10.s.likes" : ((int, int), ());
let hop1 = request | map(((rid, who, month), ()) -> (who, (rid, who, month))) | join(friend, (_, req, (f, _)) -> (f, (req, 1)));
let hop2 = hop1 | join(friend, (_, (req, _), (g, _)) -> (g, (req, 2)));
let twohop = hop1 + hop2 | filter((node, ((_, who, _), _)) -> (node, who) ne) | map((node, ((rid, who, month), d)) -> ((rid, who, month, node), d)) | reduce(limit 1, (_, vals) -> let first = vals head in (first.0, 1) enlist) | filter((_, d) -> (d, 2) eq);
let cands = twohop | map(((rid, who, month, node), _) -> (node, (rid, who, month))) | join(people, (node, (rid, who, month), (first, last, gender, town, bmonth, bday)) -> ((rid, who, node), (first, last, gender, town, month, bmonth, bday))) | filter((_, (_, _, _, _, month, bmonth, bday)) -> (((bmonth, month) eq, (bday, 21) ge) all, ((bmonth, ((month, 12) eq, 1, (month, 1) add) select) eq, (bday, 22) lt) all) any) | map((key, (first, last, gender, town, _, _, _)) -> (key, (first, last, gender, town)));
let wrote = cands | map(((rid, who, node), _) -> (node, (rid, who))) | join(posts, (node, (rid, who), m) -> ((rid, who, node, m), ()));
let liked = wrote | map(((rid, who, node, m), ()) -> (m, (rid, who, node))) | join(tags_of, (m, (rid, who, node), t) -> ((who, t), (rid, node, m))) | join(likes, ((who, _), (rid, node, m), ()) -> ((rid, who, node, m), ())) | map((k, v) -> ((k, v), ())) | reduce((_, vals) -> vals map (((), _) -> ((), 1))) | map((kv, ()) -> kv);
let points = (liked | map(((rid, who, node, _), ()) -> ((rid, who, node), 1))) + (wrote + (liked | negate) | map(((rid, who, node, _), ()) -> ((rid, who, node), -1)));
let summed = points | join_function((key, p) -> ((key, ()), (0), p) enlist) | reduce((_, vals) -> let diffs = vals map ((_, d) -> d) in let n = diffs fold_add in (n, (n, 1)) enlist filter);
let keys = cands | map((key, _) -> (key, ()));
let score = summed + (keys + (keys | join(summed, (key, (), _) -> (key, ())) | negate) | map((key, ()) -> (key, 0)));
let ranked = score | join(cands, ((rid, _, node), s, (first, last, gender, town)) -> (rid, ((s neg, node), (first, last, s, gender, town)))) | reduce((_, vals) -> let positive = (vals map ((_, d) -> (d, 0) gt), (0, vals len) range) zip filter in let indices = ((0, (positive len, 10) min) range, positive) gather in let prefix = (indices, vals) gather in let ends = prefix map ((_, d) -> (d, 10) min) scan_add in let chosen = (prefix, ends) zip map (((item, d), end) -> let count = (d, 10) min in let before = (end, count) sub in let keep = (((10, before) sub, 0) max, count) min in ((keep, 0) gt, (item, keep))) filter in let ends = chosen map ((_, d) -> d) scan_add in (chosen, ends) zip map (((item, d), end) -> (item, ((end, d) sub, end) range) cap_list map ((item, rank) -> ((rank, item), 1))) flatten .1);
let answer = ranked | map((rid, (rank, ((_, node), (first, last, s, gender, town)))) -> ((rid, rank), (node, first, last, s, gender, town)));
export "ic10x1.answer" = answer | arrange;
