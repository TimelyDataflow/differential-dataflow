-- Time lanes: epoch.
-- Bound inputs use provider arrangements; history advances to G = (0, []).
let raw = input "edges" : (int, int);
let down_rows = raw | filter((a, b) -> (a, b) ne) | map((a, b) -> ((((a, b) gt, a, b) select, ((a, b) gt, b, a) select), ()));
let down_idx = down_rows | arrange;
let down = down_idx | reduce((_, vals) -> vals map (((), _) -> ((), 1)));
let out = down | map(((a, b), ()) -> (a, b));
let rev = down | map(((a, b), ()) -> (b, a));
let p1_rows = out | lift;
let p1_filter = p1_rows | filter((_, (_, (t0))) -> (t0, 0) ne);
let out_idx = out | arrange;
let p1_join = p1_rows | half_join(out_idx, 0, (a, ((b, c), t)) -> ((b, c), (a, t)));
let p1_filter2 = p1_join | filter(((b, c), _) -> (b, c) gt);
let p1 = p1_filter2 | half_join(down, 0, ((b, c), ((a, ()), t)) -> (a, ((b, c), t)));
let p2_join = p1_filter | half_join(out_idx, 1, (a, ((c, b), t)) -> ((b, c), (a, t)));
let p2_filter = p2_join | filter(((b, c), _) -> (b, c) gt);
let p2 = p2_filter | half_join(down, 0, ((b, c), ((a, ()), t)) -> (a, ((b, c), t)));
let rev_idx = rev | arrange;
let p3_join = p1_filter | half_join(rev_idx, 1, (b, ((c, a), t)) -> ((a, c), (b, t)));
let p3 = p3_join | half_join(down, 1, ((a, c), ((b, ()), t)) -> (a, ((b, c), t)));
let triangles_rows = p1 + p2 + p3;
let triangles = triangles_rows | join_function((k, v) -> let _call0 = let input = (k, v) in let (_, (_, t)) = input in t in ((k, v), _call0, 1) enlist) | map((a, (bc, _)) -> (a, bc));
let total_map = triangles | map(_ -> ((), ()));
let total_idx = total_map | arrange;
let total_reduce = total_idx | reduce((_, vals) -> let diffs = vals map ((_, d) -> d) in let n = diffs fold_add in (n, (n, 1)) enlist filter);
-- Renderer: build an export arrangement.
output "triangles" = triangles;
-- Renderer: publish the existing arrangement.
output "total" = total_reduce;
