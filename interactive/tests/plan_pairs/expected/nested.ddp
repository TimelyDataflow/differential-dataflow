-- Time lanes: epoch.
let edges = input 0 : (int, int);
let seeds = input 1 : (int, ());
outer: {
    -- Time lanes: epoch, then 1 scope coordinates; this scope enters at zero.
    var again : (int, ());
    let starts = ::seeds + again;
    inner: {
        -- Time lanes: epoch, then 2 scope coordinates; this scope enters at zero.
        var reached : (int, ());
        let reached_idx = reached | arrange;
        let edges_idx = ::edges | arrange;
        let step = reached_idx | join(edges_idx, (_, (), dst) -> (dst, ()));
        let reached_rows = outer::starts + step;
        let reached_idx2 = reached_rows | arrange;
        let reached_reduce = reached_idx2 | reduce((_, vals) -> vals map (((), _) -> ((), 1)));
        set reached = reached_reduce;
    }
    let again_filter = inner::reached | filter((k, ()) -> 0);
    set again = again_filter;
}
-- Renderer: build an export arrangement.
export "out" = ::outer::inner::reached;
