-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (1, []), placeholder install epoch 2.
let request = input 0 : ((int, int, int), ());
let friend = import "ldbc.friend" : (int, (int, int));
let starts_map = request | map(((rid, from, _), ()) -> ((rid, 0, from, 0), ()));
let starts_map2 = request | map(((rid, _, to), ()) -> ((rid, 1, to, 0), ()));
let starts = starts_map + starts_map2;
search: {
    -- Time lanes: epoch, then 1 scope coordinates; this scope enters at zero.
    var search;
    let side0 = search | filter(((_, side, _, _), ()) -> (side, 0) eq) | map(((rid, _, node, d), ()) -> ((rid, node), d));
    let side1 = search | filter(((_, side, _, _), ()) -> (side, 1) eq) | map(((rid, _, node, d), ()) -> ((rid, node), d));
    let side0_idx = side0 | arrange;
    let side1_idx = side1 | arrange;
    let best_join = side0_idx | join(side1_idx, ((rid, _), d0, d1) -> (rid, (d0, d1) add));
    let best_idx = best_join | arrange;
    let best = best_idx | reduce((_, vals) -> let first = vals head in (first.0, 1) enlist);
    let by_rid = search | map(((rid, side, node, d), ()) -> (rid, (side, node, d)));
    let met = best | map((rid, _) -> (rid, ()));
    let by_rid_idx = by_rid | arrange;
    let met_idx = met | arrange;
    let open_join = by_rid_idx | join(met_idx, (rid, row, ()) -> (rid, row));
    let open_neg = open_join | negate;
    let open = by_rid + open_neg;
    let near_join = by_rid_idx | join(best, (rid, (side, node, d), b) -> (rid, (side, node, d, b)));
    let near = near_join | filter((_, (_, _, d, b)) -> ((d, d) add, b) lt) | map((rid, (side, node, d, _)) -> (rid, (side, node, d)));
    let grow_rows = open + near;
    let grow_map = grow_rows | map((rid, (side, node, d)) -> (node, (rid, side, d)));
    let grow_idx = grow_map | arrange;
    let grow = grow_idx | join(::friend, (_, (rid, side, d), (next, _)) -> ((rid, side, next, (d, 1) add), ()));
    let search_rows = ::starts + search + grow;
    let search_map = search_rows | map(((rid, side, node, d), ()) -> ((rid, side, node), d));
    let search_idx = search_map | arrange;
    let search_reduce = search_idx | reduce((_, vals) -> let first = vals head in (first.0, 1) enlist);
    let search_map2 = search_reduce | map(((rid, side, node), d) -> ((rid, side, node, d), ()));
    set search = search_map2;
}
let side0 = search::search | filter(((_, side, _, _), ()) -> (side, 0) eq) | map(((rid, _, node, d), ()) -> ((rid, node), d));
let side1 = search::search | filter(((_, side, _, _), ()) -> (side, 1) eq) | map(((rid, _, node, d), ()) -> ((rid, node), d));
let side0_idx = side0 | arrange;
let side1_idx = side1 | arrange;
let best_join = side0_idx | join(side1_idx, ((rid, _), d0, d1) -> (rid, (d0, d1) add));
let best_idx = best_join | arrange;
let best = best_idx | reduce((_, vals) -> let first = vals head in (first.0, 1) enlist);
let asked = request | map(((rid, _, _), ()) -> (rid, ()));
let asked_idx = asked | arrange;
let never_join = asked_idx | join(best, (rid, (), _) -> (rid, ()));
let never_neg = never_join | negate;
let never = asked + never_neg;
let answer_map = best | map((rid, d) -> ((rid, 0), (d)));
let answer_map2 = never | map((rid, ()) -> ((rid, 0), (-1)));
let answer = answer_map + answer_map2;
let answer_idx = answer | arrange;
-- Renderer: publish the existing arrangement.
export "ic13x1.answer" = answer_idx;
