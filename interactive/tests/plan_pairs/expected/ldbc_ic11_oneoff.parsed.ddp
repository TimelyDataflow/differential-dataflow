let request = input 0 : ((int, int, List(int), int), ());
let person = import "ldbc.person" : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let friend = import "ldbc.friend" : (int, (int, int));
let work = import "ldbc.work.by_person" : (int, (int, int));
let org = import "ldbc.org" : (int, (List(int), List(int), int));
let place = import "ldbc.place" : (int, (List(int), List(int), int));
let hop1 = request | map(((rid, who, country, year), ()) -> (who, (rid, who, country, year))) | join(person, (who, req, _) -> (who, req)) | join(friend, (_, req, (f, _)) -> (f, req));
let hop2 = hop1 | join(friend, (_, req, (g, _)) -> (g, req));
let circle = hop1 + hop2 | filter((node, (_, who, _, _)) -> (node, who) ne) | map((node, (rid, _, country, year)) -> ((node, rid, country, year), ())) | map((k, v) -> ((k, v), ())) | reduce((_, vals) -> vals map (((), _) -> ((), 1))) | map((kv, ()) -> kv);
let jobs = circle | map(((node, rid, country, year), ()) -> (node, (rid, country, year))) | join(work, (node, (rid, country, year), (at, since)) -> (at, (rid, node, country, year, since))) | filter((_, (_, _, _, year, since)) -> (since, year) lt) | join(org, (_, (rid, node, country, _, since), (company, _, located)) -> (located, ((rid, since, node), (company, country)))) | join(place, (_, (key, (company, country)), (there, _, _)) -> (key, (company, country, there))) | filter((_, (_, country, there)) -> (country, there) eq) | map((key, (company, _, _)) -> (key, company));
let named = jobs | reduce((_, vals) -> let lists = vals map ((v, d) -> (v, (0, d) range) cap_list map ((v, _) -> v)) in let flat = lists flatten in (flat.1, 1) enlist) | flatmap((_, entries) -> entries);
let ranked = named | map(((rid, since, node), (pos, company)) -> (node, (rid, since, pos, company))) | join(person, (node, (rid, since, pos, company), (first, last, _, _, _, _, _, _, _, _, _)) -> (rid, ((since, node, pos neg), (first, last, company)))) | reduce((_, vals) -> let positive = (vals map ((_, d) -> (d, 0) gt), (0, vals len) range) zip filter in let indices = ((0, (positive len, 10) min) range, positive) gather in let prefix = (indices, vals) gather in let ends = prefix map ((_, d) -> (d, 10) min) scan_add in let chosen = (prefix, ends) zip map (((item, d), end) -> let count = (d, 10) min in let before = (end, count) sub in let keep = (((10, before) sub, 0) max, count) min in ((keep, 0) gt, (item, keep))) filter in let ends = chosen map ((_, d) -> d) scan_add in (chosen, ends) zip map (((item, d), end) -> (item, ((end, d) sub, end) range) cap_list map ((item, rank) -> ((rank, item), 1))) flatten .1);
let answer = ranked | map((rid, (rank, ((since, node, _), (first, last, company)))) -> ((rid, rank), (node, first, last, company, since)));
export "ic11x1.answer" = answer | arrange;
