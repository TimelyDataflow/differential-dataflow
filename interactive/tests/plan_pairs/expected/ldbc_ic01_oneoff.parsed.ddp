let request = input 0 : ((int, int, List(int)), ());
let person = import "ldbc.person" : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let friend = import "ldbc.friend" : (int, (int, int));
let place = import "ldbc.place" : (int, (List(int), List(int), int));
let org = import "ldbc.org" : (int, (List(int), List(int), int));
let study = import "ldbc.study.by_person" : (int, (int, int));
let work = import "ldbc.work.by_person" : (int, (int, int));
let email = import "ldbc.email.by_person" : (int, List(int));
let language = import "ldbc.language.by_person" : (int, List(int));
let hop1 = request | map(((rid, who, name), ()) -> (who, (rid, who, name))) | join(friend, (_, req, (f, _)) -> (f, (req, 1)));
let hop2 = hop1 | join(friend, (_, (req, _), (g, _)) -> (g, (req, 2)));
let hop3 = hop2 | join(friend, (_, (req, _), (h, _)) -> (h, (req, 3)));
let circle = hop1 + hop2 + hop3 | filter((node, ((_, who, _), _)) -> (node, who) ne) | map((node, ((rid, _, name), d)) -> ((rid, node, name), d)) | reduce(limit 1, (_, vals) -> let first = vals head in (first.0, 1) enlist);
let found = circle | map(((rid, node, name), d) -> (node, (rid, name, d))) | join(person, (node, (rid, name, d), (first, last, gender, birthday, created, ip, browser, home, _, _, _)) -> ((first, name) eq, (home, (rid, node, d, last, gender, birthday, created, ip, browser)))) | filter((named, _) -> named) | map((_, row) -> row) | join(place, (_, (rid, node, d, last, gender, birthday, created, ip, browser), (town, _, _)) -> ((rid, node), (d, (last, gender, birthday, created, ip, browser, town))));
let who = found | map(((rid, node), _) -> (node, rid));
let emails = who | join(email, (node, rid, value) -> ((rid, node), value)) | reduce((_, vals) -> let lists = vals map ((v, d) -> (v, (0, d) range) cap_list map ((v, _) -> v)) in let flat = lists flatten in (flat.1, 1) enlist);
let langs = who | join(language, (node, rid, value) -> ((rid, node), value)) | reduce((_, vals) -> let lists = vals map ((v, d) -> (v, (0, d) range) cap_list map ((v, _) -> v)) in let flat = lists flatten in (flat.1, 1) enlist);
let school = who | join(study, (node, rid, (at, year)) -> (at, (rid, node, year))) | join(org, (_, (rid, node, year), (name, _, at)) -> (at, (rid, node, name, year))) | join(place, (_, (rid, node, name, year), (where, _, _)) -> ((rid, node), (name, year, where))) | reduce((_, vals) -> let lists = vals map ((v, d) -> (v, (0, d) range) cap_list map ((v, _) -> v)) in let flat = lists flatten in (flat.1, 1) enlist);
let jobs = who | join(work, (node, rid, (at, year)) -> (at, (rid, node, year))) | join(org, (_, (rid, node, year), (name, _, at)) -> (at, (rid, node, name, year))) | join(place, (_, (rid, node, name, year), (where, _, _)) -> ((rid, node), (name, year, where))) | reduce((_, vals) -> let lists = vals map ((v, d) -> (v, (0, d) range) cap_list map ((v, _) -> v)) in let flat = lists flatten in (flat.1, 1) enlist);
let with1 = (found | join(emails, (key, row, list) -> (key, (row, list)))) + (found + (found | join(emails, (key, row, _) -> (key, row)) | negate) | map((key, row) -> (key, (row, [] : List(List(int))))));
let with2 = (with1 | join(langs, (key, (row, e), list) -> (key, (row, e, list)))) + (with1 + (with1 | join(langs, (key, row, _) -> (key, row)) | negate) | map((key, (row, e)) -> (key, (row, e, [] : List(List(int))))));
let with3 = (with2 | join(school, (key, (row, e, l), list) -> (key, (row, e, l, list)))) + (with2 + (with2 | join(school, (key, row, _) -> (key, row)) | negate) | map((key, (row, e, l)) -> (key, (row, e, l, [] : List((List(int), int, List(int)))))));
let with4 = (with3 | join(jobs, (key, (row, e, l, s), list) -> (key, (row, e, l, s, list)))) + (with3 + (with3 | join(jobs, (key, row, _) -> (key, row)) | negate) | map((key, (row, e, l, s)) -> (key, (row, e, l, s, [] : List((List(int), int, List(int)))))));
let ranked = with4 | map(((rid, node), ((d, (last, gender, birthday, created, ip, browser, town)), e, l, s, w)) -> (rid, ((d, last, node), (gender, birthday, created, ip, browser, town, e, l, s, w)))) | reduce((_, vals) -> let positive = (vals map ((_, d) -> (d, 0) gt), (0, vals len) range) zip filter in let indices = ((0, (positive len, 20) min) range, positive) gather in let prefix = (indices, vals) gather in let ends = prefix map ((_, d) -> (d, 20) min) scan_add in let chosen = (prefix, ends) zip map (((item, d), end) -> let count = (d, 20) min in let before = (end, count) sub in let keep = (((20, before) sub, 0) max, count) min in ((keep, 0) gt, (item, keep))) filter in let ends = chosen map ((_, d) -> d) scan_add in (chosen, ends) zip map (((item, d), end) -> (item, ((end, d) sub, end) range) cap_list map ((item, rank) -> ((rank, item), 1))) flatten .1);
let answer = ranked | map((rid, (rank, ((d, last, node), (gender, birthday, created, ip, browser, town, e, l, s, w)))) -> ((rid, rank), (node, last, d, birthday, created, gender, browser, ip, e, l, town, s, w)));
export "ic1x1.answer" = answer | arrange;
