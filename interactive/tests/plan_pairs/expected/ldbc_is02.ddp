-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (1, []), placeholder install epoch 2.
let request = input 0 : ((int, int), ());
let person = import "ldbc.person" : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let message = import "ldbc.message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let by_creator = import "ldbc.message.by_creator" : (int, int);
let root_of = import "ldbc.message.root" : (int, int);
let mine_map = request | map(((rid, who), ()) -> (who, rid));
let mine_idx = mine_map | arrange;
let by_creator_idx = by_creator | arrange;
let mine_join = mine_idx | join(by_creator_idx, (_, rid, id) -> (id, rid));
let mine_idx2 = mine_join | arrange;
let message_idx = message | arrange;
let mine_join2 = mine_idx2 | join(message_idx, (id, rid, (_, created, _, _, _, _, _, _, _, _, _, _, _)) -> (id, (rid, created)));
let mine_idx3 = mine_join2 | arrange;
let root_of_idx = root_of | arrange;
let mine = mine_idx3 | join(root_of_idx, (id, (rid, created), root) -> (rid, ((created neg, id neg), (id, created, root))));
let mine_idx4 = mine | arrange;
let top = mine_idx4 | reduce((_, vals) -> let positive = (vals map ((_, d) -> (d, 0) gt), (0, vals len) range) zip filter in let indices = ((0, (positive len, 10) min) range, positive) gather in let prefix = (indices, vals) gather in let ends = prefix map ((_, d) -> (d, 10) min) scan_add in let chosen = (prefix, ends) zip map (((item, d), end) -> let count = (d, 10) min in let before = (end, count) sub in let keep = (((10, before) sub, 0) max, count) min in ((keep, 0) gt, (item, keep))) filter in let ends = chosen map ((_, d) -> d) scan_add in (chosen, ends) zip map (((item, d), end) -> (item, ((end, d) sub, end) range) cap_list map ((item, rank) -> ((rank, item), 1))) flatten .1);
let answer_map = top | map((rid, (rank, (_, (id, created, root)))) -> (id, (rid, rank, created, root)));
let answer_idx = answer_map | arrange;
let answer_join = answer_idx | join(message_idx, (id, (rid, rank, created, root), (_, _, _, _, content, image, _, _, _, _, _, _, _)) -> (root, (rid, rank, id, ((content len, 0) gt, content, image) select, created)));
let answer_idx2 = answer_join | arrange;
let answer_join2 = answer_idx2 | join(message_idx, (root, (rid, rank, id, body, created), (_, _, op, _, _, _, _, _, _, _, _, _, _)) -> (op, (rid, rank, id, body, created, root)));
let answer_idx3 = answer_join2 | arrange;
let person_idx = person | arrange;
let answer = answer_idx3 | join(person_idx, (op, (rid, rank, id, body, created, root), (first, last, _, _, _, _, _, _, _, _, _)) -> ((rid, rank), (id, body, created, root, op, first, last)));
let answer_idx4 = answer | arrange;
-- Renderer: publish the existing arrangement.
export "is2.answer" = answer_idx4;
