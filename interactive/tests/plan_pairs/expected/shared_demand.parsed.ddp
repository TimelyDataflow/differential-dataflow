let rows = input 0 : (int, (int, int)) | map((k, v) -> (k, v));
export "first" = rows | map((k, (a, _)) -> (k, a));
export "second" = rows | map((k, (_, b)) -> (k, b));
export "counts" = rows | reduce((_, vals) -> let diffs = vals map ((_, d) -> d) in let n = diffs fold_add in (n, (n, 1)) enlist filter);
