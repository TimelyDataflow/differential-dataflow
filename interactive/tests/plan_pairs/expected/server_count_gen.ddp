-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (0, []).
let edges = import "random:nodes=8,edges=12" : ((int, int), ());
let edge_count_map = edges | map(_ -> ((), ()));
let edge_count_idx = edge_count_map | arrange;
let edge_count_reduce = edge_count_idx | reduce((_, a) -> let v0 = a map ((_, a) -> a) fold_add in (v0, (v0, 1)) enlist filter map ((a, b) -> ((a), b)));
-- Renderer: publish the existing arrangement.
export "edge_count" = edge_count_reduce;
