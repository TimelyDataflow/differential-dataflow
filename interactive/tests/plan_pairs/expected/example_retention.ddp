-- Time lanes: epoch.
-- Bound inputs use provider arrangements; history advances to G = (0, []).
let orders = input "orders" : (int, (int, int));
let events = orders | map((_, (customer, _)) -> (customer, ()));
let recent_rows = events | lift | join_function((k, v) -> let _call0 = let input = (k, v) in let (_, (_, (t))) = input in (t, 3) add in ((k, v), _call0, 1) enlist) | map((k, _) -> (k, ())) | negate;
let recent = events + recent_rows;
let recent_idx = recent | arrange;
let recent_reduce = recent_idx | reduce((_, vals) -> let diffs = vals map ((_, d) -> d) in let n = diffs fold_add in (n, (n, 1)) enlist filter);
-- Renderer: publish the existing arrangement.
output "recent" = recent_reduce;
