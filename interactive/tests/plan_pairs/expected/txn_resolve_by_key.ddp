-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (1, []), placeholder install epoch 2.
let store = import "store" : ((int), (int, int));
let intents = input 0 : ((int, int, int), (int));
let wid = intents | filter(((_, r, _), _) -> (r, 0) eq) | map(((wid, _, k), (v)) -> ((wid, k), (v))) | map(((wid, k), (v)) -> ((wid), (k, v)));
let read_entries = intents | filter(((_, r, _), _) -> (r, 1) eq) | map(((rid, _, k), (e)) -> ((rid, k), (e))) | map(((rid, k), (e)) -> ((k), (1, rid, e)));
let read_entries_idx = read_entries | arrange;
let store_idx = store | arrange;
let store_entries = read_entries_idx | join(store_idx, ((k), _, (sw, v)) -> ((k), (0, sw, v)));
res: {
    -- Time lanes: epoch, then 1 scope coordinates; this scope enters at zero.
    var rollback : ((int), ());
    let wid_idx = ::wid | arrange;
    let rollback_idx = rollback | arrange;
    let wr_bad = wid_idx | join(rollback_idx, (wid, kv, ()) -> (wid, kv));
    let writes_neg = wr_bad | negate;
    let writes = ::wid + writes_neg;
    let write_entries = writes | map(((wid), (k, v)) -> ((k), (0, wid, v)));
    let bad_rows = ::read_entries + ::store_entries + write_entries;
    let bad_idx = bad_rows | arrange;
    let bad_reduce = bad_idx | reduce((_, vals) -> let entries = vals map ((e, _) -> e) in
        let ws = (entries map ((t, _, _) -> (t, 0) eq), entries) zip filter in
        let rs = (entries map ((t, _, _) -> (t, 1) eq), entries) zip filter in
        let judged = (ws, rs) cap_list map ((ws, (_, i, x)) ->
            let best = ((-1, -1), (i, ws) cap_list) fold (((bid, bv), (i, (_, j, y))) ->
                (((j, i) lt, (j, bid) gt) and, (j, y), (bid, bv)) select) in
            let (bid, bv) = best in
            (((bid, -1) eq, (x, -1) ne, (bv, x) ne) select, ((i), 1))) in
        (judged map ((b, _) -> b), judged map ((_, o) -> o)) zip filter);
    let bad = bad_reduce | map((_, (a)) -> ((()), (a)));
    let rollback_map = bad | map((_, (rid)) -> ((rid), ()));
    let rollback_idx2 = rollback_map | arrange;
    let rollback_reduce = rollback_idx2 | distinct;
    set rollback = rollback_reduce;
}
let rb = res::rollback;
let wid_idx = wid | arrange;
let rb_idx = rb | arrange;
let wbad = wid_idx | join(rb_idx, (wid, kv, ()) -> (wid, kv));
let committed_neg = wbad | negate;
let committed = wid + committed_neg;
let latest_map = committed | map(((wid), (k, v)) -> ((k), (wid neg, v)));
let latest_idx = latest_map | arrange;
let latest = latest_idx | min;
let new_rows = latest | map(((k), (nw, v)) -> ((k), (nw neg, v)));
let old_rows = latest | join(store_idx, ((k), _, (sw, sv)) -> ((k), (sw, sv)));
let delta_neg = old_rows | negate;
let delta_rows = new_rows + delta_neg;
-- Renderer: build an export arrangement.
export "rollback" = rb;
-- Renderer: build an export arrangement.
export "delta" = delta_rows;
