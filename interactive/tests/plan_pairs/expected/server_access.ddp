type Access = Owner | Edit | View;
type Member = User int | Group int;
-- Time lanes: epoch.
let grants = input 0 : (int, (Member, Access));
let groups = input 1 : (int, Member);
let blocks = input 2 : (int, Member);
let members = groups | map((grp, who) -> (grp inject Member::Group, who));
let members_idx = members | arrange;
barring: {
    -- Time lanes: epoch, then 1 scope coordinates; this scope enters at zero.
    var barred : (Member, int);
    let barred_idx = barred | arrange;
    let beyond = barred_idx | join(::members_idx, (_grp, doc, who) -> (who, doc));
    let barred_map = ::blocks | map((doc, who) -> (who, doc));
    let barred_rows = barred_map + beyond;
    let barred_map2 = barred_rows | map((k, v) -> ((k, v), ()));
    let barred_idx2 = barred_map2 | arrange;
    let barred_reduce = barred_idx2 | reduce((_, vals) -> vals map (((), _) -> ((), 1)));
    let barred_map3 = barred_reduce | map((kv, ()) -> kv);
    set barred = barred_map3;
}
let barred = barring::barred | map((who, doc) -> ((who, doc), ()));
sharing: {
    -- Time lanes: epoch, then 1 scope coordinates; this scope enters at zero.
    var allowed : ((Member, int), Access);
    let inherited_map = allowed | map(((who, doc), acc) -> (who, (doc, acc)));
    let inherited_idx = inherited_map | arrange;
    let inherited = inherited_idx | join(::members_idx, (_grp, (doc, acc), who) -> ((who, doc), acc));
    let offered_map = ::grants | map((doc, (who, acc)) -> ((who, doc), acc));
    let offered = offered_map + inherited;
    let offered_idx = offered | arrange;
    let barred_idx = ::barred | arrange;
    let allowed_join = offered_idx | join(barred_idx, (pair, acc, ()) -> (pair, acc));
    let allowed_neg = allowed_join | negate;
    let allowed_rows = offered + allowed_neg;
    let allowed_idx = allowed_rows | arrange;
    let allowed_reduce = allowed_idx | reduce((_, vals) -> let first = vals head in (first.0, 1) enlist);
    set allowed = allowed_reduce;
}
-- Renderer: build an export arrangement.
export "access" = sharing::allowed;
