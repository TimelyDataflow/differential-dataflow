-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (0, []).
let message = import "ldbc.message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let pals = import "ldbc.friend.pair" : ((int, int), ());
let answered_rows = message | filter((_, (kind, _, _, _, _, _, _, _, _, _, _, _, _)) -> (kind, 1) eq) | map((_, (_, _, who, _, _, _, _, _, _, parent, _, _, _)) -> (parent, who));
let answered_idx = answered_rows | arrange;
let message_idx = message | arrange;
let answered_join = answered_idx | join(message_idx, (_, who, (_, _, to, _, _, _, _, _, _, _, _, _, _)) -> (who, to));
let answered = answered_join | filter((who, to) -> (who, to) ne);
let talks_map = answered | map((a, b) -> ((a, b), ()));
let talks_map2 = answered | map((a, b) -> ((b, a), ()));
let talks = talks_map + talks_map2;
let talks_idx = talks | arrange;
let weighted_reduce = talks_idx | reduce((_, vals) -> let diffs = vals map ((_, d) -> d) in let n = diffs fold_add in (n, (n, 1)) enlist filter);
let pals_idx = pals | arrange;
let weighted_join = weighted_reduce | join(pals_idx, (pair, n, ()) -> (pair, n));
let weighted = weighted_join | map(((a, b), n) -> (a, (b, (((0, n), (1, 40) range) fold (((acc, n), k) ->
                           ((acc, ((((k, (k, 1) sub) mul, 1) add, n) gt, 1, 0) select) add, n)) .0, 1) add)));
let weighted_idx = weighted | arrange;
-- Renderer: publish the existing arrangement.
export "ic14.s.weighted" = weighted_idx;
