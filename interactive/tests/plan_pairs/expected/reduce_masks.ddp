-- Time lanes: epoch.
let rows = input 0 : ((int, int), ());
let values = input 1 : (int, (int, int));
let rows_idx = rows | arrange;
let counted = rows_idx | reduce((_, vals) -> let diffs = vals map ((_, d) -> d) in let n = diffs fold_add in (n, (n, 1)) enlist filter);
let values_idx = values | arrange;
let custom = values_idx | reduce((_, a) -> a map ((a, b) -> (((), a.1), (b, 2) mul)));
let out_map = counted | map(((a, _), n) -> (a, n));
let minimum_reduce = values_idx | reduce(limit 1, (_, a) -> (((), a head.0.1), 1) enlist);
let unique_map = values | map((k, v) -> ((k, v), ()));
let unique_idx = unique_map | arrange;
let unique_reduce = unique_idx | reduce((_, vals) -> vals map (((), _) -> ((), 1)));
let unique_map2 = unique_reduce | map(((a, (_, b)), _) -> (a, ((), b)));
let counted_reduce = values_idx | reduce((_, a) -> let v0 = a map ((_, a) -> a) fold_add in (v0, (v0, 1)) enlist filter map ((_, a) -> ((), a)));
let collected_reduce = values_idx | reduce(_ -> ((), 1) enlist);
let custom_map = custom | map((k, (_, v)) -> ((k, v), ()));
-- Renderer: build an export arrangement.
output "out" = out_map;
-- Renderer: publish the existing arrangement.
output "minimum" = minimum_reduce;
-- Renderer: build an export arrangement.
output "unique" = unique_map2;
-- Renderer: publish the existing arrangement.
output "counted" = counted_reduce;
-- Renderer: publish the existing arrangement.
output "collected" = collected_reduce;
-- Renderer: build an export arrangement.
output "custom" = custom_map;
