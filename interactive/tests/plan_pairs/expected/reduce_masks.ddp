-- Time lanes: epoch.
let rows = input 0 : ((int, int), ());
let values = input 1 : (int, (int, int));
let rows_idx = rows | arrange;
let counted = rows_idx | reduce((_, vals) -> let diffs = vals map ((_, d) -> d) in let n = diffs fold_add in (n, (n, 1)) enlist filter);
let values_idx = values | arrange;
let custom = values_idx | reduce(arg -> let _call0 = let input = arg in let (_, vals) = input in vals map ((v, d) -> (v, (d, 2) mul)) in (arg.0, _call0) cap_list map ((_key, (_value, _diff)) -> (((), (_key, _value).1.1), _diff)));
let out_map = counted | map(((a, _), n) -> (a, n));
let minimum_reduce = values_idx | reduce(limit 1, arg -> let _call0 = let input = arg in let (_, vals) = input in let first = vals head in (first.0, 1) enlist in (arg.0, _call0) cap_list map (row -> (let (k, (_, v)) = (row.0, row.1.0) in (k, ((), v)).1, row.1.1)));
let unique_map = values | map((k, v) -> ((k, v), ()));
let unique_idx = unique_map | arrange;
let unique_reduce = unique_idx | reduce((_, vals) -> vals map (((), _) -> ((), 1)));
let unique_map2 = unique_reduce | map((kv, ()) -> let (k, (_, v)) = kv in (k, ((), v)));
let counted_reduce = values_idx | reduce(arg -> let _call0 = let input = arg in let (_, vals) = input in let diffs = vals map ((_, d) -> d) in let n = diffs fold_add in (n, (n, 1)) enlist filter in (arg.0, _call0) cap_list map (row -> (let (k, _) = (row.0, row.1.0) in (k, ()).1, row.1.1)));
let collected_reduce = values_idx | reduce(arg -> let _call0 = let input = arg in let (_, vals) = input in let lists = vals map ((v, d) -> (v, (0, d) range) cap_list map ((v, _) -> v)) in let flat = lists flatten in (flat.1, 1) enlist in (arg.0, _call0) cap_list map (row -> (let (k, _) = (row.0, row.1.0) in (k, ()).1, row.1.1)));
let custom_map = custom | map((k, (_, v)) -> ((k, v), ()));
-- Renderer: build an export arrangement.
output "out" = out_map;
-- Renderer: publish the existing arrangement.
output "minimum" = minimum_reduce;
-- Renderer: build an export arrangement.
output "unique" = unique_map2;
-- Renderer: publish the existing arrangement.
output "counted" = counted_reduce;
-- Renderer: publish the existing arrangement.
output "collected" = collected_reduce;
-- Renderer: build an export arrangement.
output "custom" = custom_map;
