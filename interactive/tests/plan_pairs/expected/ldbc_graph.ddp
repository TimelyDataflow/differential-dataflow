-- Time lanes: epoch.
let person = input 0 : ((int, List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int), ());
let message = input 1 : ((int, int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int), ());
