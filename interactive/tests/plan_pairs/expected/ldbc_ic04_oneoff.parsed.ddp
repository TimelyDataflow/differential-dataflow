let request = input 0 : ((int, int, int, int), ());
let message = import "ldbc.message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let friend = import "ldbc.friend" : (int, (int, int));
let tag = import "ldbc.tag" : (int, (List(int), int));
let mtag = import "ldbc.mtag.by_tag" : (int, int);
let posts = import "ic4.s.posts" : (int, (int, int));
let tags = import "ic4.s.tags" : (int, (int, List(int)));
let seen = request | map(((rid, who, start, days), ()) -> (who, (rid, start, (start, (days, 86400000) mul) add))) | join(friend, (_, req, (f, _)) -> (f, req)) | join(posts, (_, (rid, start, end), (m, created)) -> (m, (rid, created, start, end))) | join(tags, (_, (rid, created, start, end), (t, name)) -> ((rid, t), (name, created, start, end)));
let before = seen | filter((_, (_, created, start, _)) -> (created, start) lt) | map((key, _) -> (key, ())) | distinct;
let during = seen | filter((_, (_, created, start, end)) -> ((created, start) ge, (created, end) lt) all);
let fresh = during + (during | join(before, (key, row, ()) -> (key, row)) | negate);
let counts = fresh | map(((rid, _), (name, _, _, _)) -> ((rid, name), ())) | count;
let ranked = counts | map(((rid, name), n) -> (rid, (n neg, name))) | reduce((_, vals) -> let positive = (vals map ((_, d) -> (d, 0) gt), (0, vals len) range) zip filter in let indices = ((0, (positive len, 10) min) range, positive) gather in let prefix = (indices, vals) gather in let ends = prefix map ((_, d) -> (d, 10) min) scan_add in let chosen = (prefix, ends) zip map (((item, d), end) -> let count = (d, 10) min in let before = (end, count) sub in let keep = (((10, before) sub, 0) max, count) min in ((keep, 0) gt, (item, keep))) filter in let ends = chosen map ((_, d) -> d) scan_add in (chosen, ends) zip map (((item, d), end) -> (item, ((end, d) sub, end) range) cap_list map ((item, rank) -> ((rank, item), 1))) flatten .1);
let answer = ranked | map((rid, (rank, (neg, name))) -> ((rid, rank), (name, neg neg)));
export "ic4x1.answer" = answer | arrange;
