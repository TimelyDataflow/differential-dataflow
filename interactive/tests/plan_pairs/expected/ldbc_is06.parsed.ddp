let request = input 0 : ((int, int), ());
let person = input "person" : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let message = input "message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let forum = input "forum" : (int, (List(int), int, int));
let root_of = input "message_root" : (int, int);
let answer = request | map(((rid, m), ()) -> (m, rid)) | join(root_of, (_, (rid, root)) -> (root, rid)) | join(message, (_, (rid, (_, _, _, _, _, _, _, _, f, _, _, _, _))) -> (f, rid)) | join(forum, (f, (rid, (title, _, moderator))) -> (moderator, (rid, f, title))) | join(person, (moderator, ((rid, f, title), (first, last, _, _, _, _, _, _, _, _, _))) -> ((rid, 0), (f, title, moderator, first, last)));
output "answer" = answer | arrange;
