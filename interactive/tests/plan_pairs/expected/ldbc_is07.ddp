-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (1, []), placeholder install epoch 2.
let request = input 0 : ((int, int), ());
let person = import "ldbc.person" : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let message = import "ldbc.message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let by_parent = import "ldbc.message.by_parent" : (int, int);
let friend = import "ldbc.friend" : (int, (int, int));
let reply_map = request | map(((rid, m), ()) -> (m, rid));
let reply_idx = reply_map | arrange;
let message_idx = message | arrange;
let reply_join = reply_idx | join(message_idx, (m, rid, (_, _, op, _, _, _, _, _, _, _, _, _, _)) -> (m, (rid, op)));
let reply_idx2 = reply_join | arrange;
let by_parent_idx = by_parent | arrange;
let reply_join2 = reply_idx2 | join(by_parent_idx, (_, (rid, op), id) -> (id, (rid, op)));
let reply_idx3 = reply_join2 | arrange;
let reply_join3 = reply_idx3 | join(message_idx, (id, (rid, op), (kind, created, who, _, text, _, _, _, _, _, _, _, _)) -> (kind, ((who, op), (rid, id, text, created))));
let reply = reply_join3 | filter((kind, _) -> (kind, 1) eq) | map((_, row) -> row);
let known_map = reply | map(((who, op), row) -> (who, (op, row)));
let known_idx = known_map | arrange;
let friend_idx = friend | arrange;
let known_join = known_idx | join(friend_idx, (who, (op, row), (f, _)) -> ((f, op) eq, ((who, op), row)));
let known_rows = known_join | filter((same, _) -> same) | map((_, (pair, row)) -> ((pair, row), ()));
let known_idx2 = known_rows | arrange;
let known_reduce = known_idx2 | distinct;
let known = known_reduce | map((((a, _), (b, c, d, e)), _) -> ((a, ()), (b, c, d, e)));
let marked_map = known | map(((who, _), row) -> (who, (row, 1)));
let marked_neg = known | negate;
let marked_map2 = reply | map(((a, _), (b, c, d, e)) -> ((a, ()), (b, c, d, e)));
let marked_map3 = marked_neg | map(((a, _), (b, c, d, e)) -> ((a, ()), (b, c, d, e)));
let marked_rows = marked_map2 + marked_map3;
let marked_map4 = marked_rows | map(((who, _), row) -> (who, (row, 0)));
let marked = marked_map + marked_map4;
let marked_idx = marked | arrange;
let person_idx = person | arrange;
let ranked_join = marked_idx | join(person_idx, (who, ((rid, id, text, created), k), (first, last, _, _, _, _, _, _, _, _, _)) -> (rid, ((created neg, who), (id, text, first, last, k))));
let ranked_idx = ranked_join | arrange;
let ranked_reduce = ranked_idx | collect;
let answer = ranked_reduce | flatmap((_, entries) -> entries) | map((rid, (rank, ((neg, who), (id, text, first, last, k)))) -> ((rid, rank), (id, text, neg neg, who, first, last, k)));
let answer_idx = answer | arrange;
-- Renderer: publish the existing arrangement.
export "is7.answer" = answer_idx;
