-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (0, []).
let request = input 0 : ((int, int), ());
let person = import "graph::person" : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let message = import "graph::message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let by_parent = import "graph::message.by_parent" : (int, int);
let friend = import "graph::friend" : (int, (int, int));
let reply_map = request | map(((rid, m), ()) -> (m, rid));
let reply_idx = reply_map | arrange;
let reply_join = reply_idx | join(message, (m, rid, (_, _, op, _, _, _, _, _, _, _, _, _, _)) -> (m, (rid, op)));
let reply_idx2 = reply_join | arrange;
let reply_join2 = reply_idx2 | join(by_parent, (_, (rid, op), id) -> (id, (rid, op)));
let reply_idx3 = reply_join2 | arrange;
let reply_join3 = reply_idx3 | join(message, (id, (rid, op), (kind, created, who, _, text, _, _, _, _, _, _, _, _)) -> (kind, ((who, op), (rid, id, text, created))));
let reply = reply_join3 | filter((kind, _) -> (kind, 1) eq) | map((_, row) -> row);
let known_map = reply | map(((who, op), row) -> (who, (op, row)));
let known_idx = known_map | arrange;
let known_join = known_idx | join(friend, (who, (op, row), (f, _)) -> ((f, op) eq, ((who, op), row)));
let known_rows = known_join | filter((same, _) -> same) | map((_, (pair, row)) -> ((pair, row), ()));
let known_idx2 = known_rows | arrange;
let known_reduce = known_idx2 | reduce((_, vals) -> vals map (((), _) -> ((), 1)));
let known = known_reduce | map(arg -> let _call0 = let input = arg in let ((pair, row), ()) = input in (pair, row) in ((_call0.0.0, ()), (_call0.1.0, _call0.1.1, _call0.1.2, _call0.1.3)));
let marked_map = known | map(((who, _), row) -> (who, (row, 1)));
let marked_map2 = reply | map(arg -> let _call0 = let input = arg in input in ((_call0.0.0, ()), (_call0.1.0, _call0.1.1, _call0.1.2, _call0.1.3)));
let marked_neg = known | negate;
let marked_rows = marked_map2 + marked_neg;
let marked_map3 = marked_rows | map(((who, _), row) -> (who, (row, 0)));
let marked = marked_map + marked_map3;
let marked_idx = marked | arrange;
let ranked_join = marked_idx | join(person, (who, ((rid, id, text, created), k), (first, last, _, _, _, _, _, _, _, _, _)) -> (rid, ((created neg, who), (id, text, first, last, k))));
let ranked_idx = ranked_join | arrange;
let ranked_reduce = ranked_idx | reduce((_, vals) -> let lists = vals map ((v, d) -> (v, (0, d) range) cap_list map ((v, _) -> v)) in let flat = lists flatten in (flat.1, 1) enlist);
let answer = ranked_reduce | flatmap((_, entries) -> entries) | map((rid, (rank, ((neg, who), (id, text, first, last, k)))) -> ((rid, rank), (id, text, neg neg, who, first, last, k)));
let answer_idx = answer | arrange;
-- Renderer: publish the existing arrangement.
output "answer" = answer_idx;
