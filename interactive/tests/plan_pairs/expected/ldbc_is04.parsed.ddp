let request = input 0 : ((int, int), ());
let message = import "ldbc.message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let answer = request | map(((rid, m), ()) -> (m, rid)) | join(message, (_, rid, (_, created, _, _, text, image, _, _, _, _, _, _, _)) -> ((rid, 0), (created, ((text len, 0) gt, text, image) select)));
export "is4.answer" = answer | arrange;
