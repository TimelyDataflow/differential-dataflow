-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (0, []).
let request = input 0 : ((int, int, int), ());
let friend = import "ldbc.friend" : (int, (int, int));
let tags_of = import "ldbc.mtag.by_message" : (int, int);
let people = import "ic10.s.people" : (int, (List(int), List(int), List(int), List(int), int, int));
let posts = import "ic10.s.posts" : (int, int);
let likes = import "ic10.s.likes" : ((int, int), ());
let hop1_map = request | map(((rid, who, month), ()) -> (who, (rid, who, month)));
let hop1_idx = hop1_map | arrange;
let friend_idx = friend | arrange;
let hop1 = hop1_idx | join(friend_idx, (_, req, (f, _)) -> (f, (req, 1)));
let hop1_idx2 = hop1 | arrange;
let hop2 = hop1_idx2 | join(friend_idx, (_, (req, _), (g, _)) -> (g, (req, 2)));
let twohop_rows = hop1 + hop2;
let twohop_rows2 = twohop_rows | filter((node, ((_, who, _), _)) -> (node, who) ne) | map((node, ((rid, who, month), d)) -> ((rid, who, month, node), d));
let twohop_idx = twohop_rows2 | arrange;
let twohop_reduce = twohop_idx | reduce(limit 1, (_, vals) -> let first = vals head in (first.0, 1) enlist);
let cands_rows = twohop_reduce | filter((_, d) -> (d, 2) eq) | map(((rid, who, month, node), _) -> (node, (rid, who, month)));
let cands_idx = cands_rows | arrange;
let people_idx = people | arrange;
let cands_join = cands_idx | join(people_idx, (node, (rid, who, month), (first, last, gender, town, bmonth, bday)) -> ((rid, who, node), (first, last, gender, town, month, bmonth, bday)));
let cands = cands_join | filter((_, (_, _, _, _, month, bmonth, bday)) -> (((bmonth, month) eq, (bday, 21) ge) all, ((bmonth, ((month, 12) eq, 1, (month, 1) add) select) eq, (bday, 22) lt) all) any) | map((key, (first, last, gender, town, _, _, _)) -> (key, (first, last, gender, town)));
let wrote_map = cands | map(((rid, who, node), _) -> (node, (rid, who)));
let wrote_idx = wrote_map | arrange;
let posts_idx = posts | arrange;
let wrote = wrote_idx | join(posts_idx, (node, (rid, who), m) -> ((rid, who, node, m), ()));
let liked_map = wrote | map(((rid, who, node, m), ()) -> (m, (rid, who, node)));
let liked_idx = liked_map | arrange;
let tags_of_idx = tags_of | arrange;
let liked_join = liked_idx | join(tags_of_idx, (m, (rid, who, node), t) -> ((who, t), (rid, node, m)));
let liked_idx2 = liked_join | arrange;
let likes_idx = likes | arrange;
let liked_join2 = liked_idx2 | join(likes_idx, ((who, _), (rid, node, m), ()) -> ((rid, who, node, m), ()));
let liked_idx3 = liked_join2 | arrange;
let liked = liked_idx3 | reduce((_, vals) -> vals map (((), _) -> ((), 1)));
let points_map = liked | map(((rid, who, node, _), ()) -> ((rid, who, node), 1));
let points_map2 = wrote | map(arg -> let _call0 = let input = arg in input in ((_call0.0.0, _call0.0.1, _call0.0.2, ()), ()));
let points_rows = liked | negate | map(arg -> let _call0 = let input = arg in input in ((_call0.0.0, _call0.0.1, _call0.0.2, ()), ()));
let points_rows2 = points_map2 + points_rows;
let points_map3 = points_rows2 | map(((rid, who, node, _), ()) -> ((rid, who, node), -1));
let points = points_map + points_map3;
let summed_rows = points | join_function((key, p) -> ((key, ()), (0), p) enlist);
let summed_idx = summed_rows | arrange;
let summed = summed_idx | reduce((_, vals) -> let diffs = vals map ((_, d) -> d) in let n = diffs fold_add in (n, (n, 1)) enlist filter);
let keys = cands | map((key, _) -> (key, ()));
let keys_idx = keys | arrange;
let score_join = keys_idx | join(summed, (key, (), _) -> (key, ()));
let score_neg = score_join | negate;
let score_rows = keys + score_neg;
let score_map = score_rows | map((key, ()) -> (key, 0));
let score = summed + score_map;
let score_idx = score | arrange;
let cands_idx2 = cands | arrange;
let ranked_join = score_idx | join(cands_idx2, ((rid, _, node), s, (first, last, gender, town)) -> (rid, ((s neg, node), (first, last, s, gender, town))));
let ranked_idx = ranked_join | arrange;
let ranked = ranked_idx | reduce((_, vals) -> let positive = (vals map ((_, d) -> (d, 0) gt), (0, vals len) range) zip filter in let indices = ((0, (positive len, 10) min) range, positive) gather in let prefix = (indices, vals) gather in let ends = prefix map ((_, d) -> (d, 10) min) scan_add in let chosen = (prefix, ends) zip map (((item, d), end) -> let count = (d, 10) min in let before = (end, count) sub in let keep = (((10, before) sub, 0) max, count) min in ((keep, 0) gt, (item, keep))) filter in let ends = chosen map ((_, d) -> d) scan_add in (chosen, ends) zip map (((item, d), end) -> (item, ((end, d) sub, end) range) cap_list map ((item, rank) -> ((rank, item), 1))) flatten .1);
let answer = ranked | map((rid, (rank, ((_, node), (first, last, s, gender, town)))) -> ((rid, rank), (node, first, last, s, gender, town)));
let answer_idx = answer | arrange;
-- Renderer: publish the existing arrangement.
export "ic10x1.answer" = answer_idx;
