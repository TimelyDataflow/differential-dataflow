-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (0, []).
let person = import "graph::person" : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let message = import "graph::message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let place = import "graph::place" : (int, (List(int), List(int), int));
let interest = import "graph::interest.by_person" : (int, int);
let people_map = person | map((id, (first, last, gender, _, _, _, _, home, bmonth, bday, _)) -> (home, (id, first, last, gender, bmonth, bday)));
let people_idx = people_map | arrange;
let people = people_idx | join(place, (_, (id, first, last, gender, bmonth, bday), (town, _, _)) -> (id, (first, last, gender, town, bmonth, bday)));
let posts = message | filter((_, (kind, _, _, _, _, _, _, _, _, _, _, _, _)) -> (kind, 0) eq) | map((id, (_, _, who, _, _, _, _, _, _, _, _, _, _)) -> (who, id));
let likes = interest | map((p, t) -> ((p, t), ()));
let people_idx2 = people | arrange;
let posts_idx = posts | arrange;
let likes_idx = likes | arrange;
-- Renderer: publish the existing arrangement.
output "people" = people_idx2;
-- Renderer: publish the existing arrangement.
output "posts" = posts_idx;
-- Renderer: publish the existing arrangement.
output "likes" = likes_idx;
