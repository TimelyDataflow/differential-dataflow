-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (1, []), placeholder install epoch 2.
let person = import "ldbc.person" : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let message = import "ldbc.message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let place = import "ldbc.place" : (int, (List(int), List(int), int));
let interest = import "ldbc.interest.by_person" : (int, int);
let people_map = person | map((id, (first, last, gender, _, _, _, _, home, bmonth, bday, _)) -> (home, (id, first, last, gender, bmonth, bday)));
let people_idx = people_map | arrange;
let place_idx = place | arrange;
let people = people_idx | join(place_idx, (_, (id, first, last, gender, bmonth, bday), (town, _, _)) -> (id, (first, last, gender, town, bmonth, bday)));
let posts = message | filter((_, (kind, _, _, _, _, _, _, _, _, _, _, _, _)) -> (kind, 0) eq) | map((id, (_, _, who, _, _, _, _, _, _, _, _, _, _)) -> (who, id));
let likes = interest | map((p, t) -> ((p, t), ()));
let people_idx2 = people | arrange;
let posts_idx = posts | arrange;
let likes_idx = likes | arrange;
-- Renderer: publish the existing arrangement.
export "ic10.s.people" = people_idx2;
-- Renderer: publish the existing arrangement.
export "ic10.s.posts" = posts_idx;
-- Renderer: publish the existing arrangement.
export "ic10.s.likes" = likes_idx;
