let raw = input "edges" : (int, int);
let down = raw | filter((a, b) -> (a, b) ne) | map((a, b) -> ((((a, b) gt, a, b) select, ((a, b) gt, b, a) select), ())) | map((k, v) -> ((k, v), ())) | reduce((_, vals) -> vals map (((), _) -> ((), 1))) | map((kv, ()) -> kv);
let out = down | map(((a, b), ()) -> (a, b));
let rev = down | map(((a, b), ()) -> (b, a));
let pairs = down | arrange;
let p1 = out | lift | half_join(out, 0, (a, ((b, c), t)) -> ((b, c), (a, t))) | filter(((b, c), _) -> (b, c) gt) | half_join(pairs, 0, ((b, c), ((a, ()), t)) -> (a, ((b, c), t)));
let p2 = out | lift | half_join(out, 1, (a, ((c, b), t)) -> ((b, c), (a, t))) | filter(((b, c), _) -> (b, c) gt) | half_join(pairs, 0, ((b, c), ((a, ()), t)) -> (a, ((b, c), t)));
let p3 = down | map(((b, c), ()) -> (b, c)) | lift | half_join(rev, 1, (b, ((c, a), t)) -> ((a, c), (b, t))) | half_join(pairs, 1, ((a, c), ((b, ()), t)) -> (a, ((b, c), t)));
let triangles = p1 + p2 + p3 | join_function((k, v) -> let _call0 = let input = (k, v) in let (_, (_, t)) = input in t in ((k, v), _call0, 1) enlist) | map((a, (bc, _)) -> (a, bc));
output "triangles" = triangles;
output "total" = triangles | map(_ -> ((), ())) | map((k, _) -> (k, ())) | reduce((_, vals) -> let diffs = vals map ((_, d) -> d) in let n = diffs fold_add in (n, (n, 1)) enlist filter);
