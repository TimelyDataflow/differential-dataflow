-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (1, []), placeholder install epoch 2.
let request = input 0 : ((int, int, List(int)), ());
let person = import "ldbc.person" : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let friend = import "ldbc.friend" : (int, (int, int));
let place = import "ldbc.place" : (int, (List(int), List(int), int));
let org = import "ldbc.org" : (int, (List(int), List(int), int));
let study = import "ldbc.study.by_person" : (int, (int, int));
let work = import "ldbc.work.by_person" : (int, (int, int));
let email = import "ldbc.email.by_person" : (int, List(int));
let language = import "ldbc.language.by_person" : (int, List(int));
let hop1_map = request | map(((rid, who, name), ()) -> (who, (rid, who, name)));
let hop1_idx = hop1_map | arrange;
let friend_idx = friend | arrange;
let hop1 = hop1_idx | join(friend_idx, (_, req, (f, _)) -> (f, (req, 1)));
let hop1_idx2 = hop1 | arrange;
let hop2 = hop1_idx2 | join(friend_idx, (_, (req, _), (g, _)) -> (g, (req, 2)));
let hop2_idx = hop2 | arrange;
let hop3 = hop2_idx | join(friend_idx, (_, (req, _), (h, _)) -> (h, (req, 3)));
let circle_rows = hop1 + hop2 + hop3;
let circle_rows2 = circle_rows | filter((node, ((_, who, _), _)) -> (node, who) ne) | map((node, ((rid, _, name), d)) -> ((rid, node, name), d));
let circle_idx = circle_rows2 | arrange;
let circle = circle_idx | reduce((_, vals) -> let first = vals head in (first.0, 1) enlist);
let found_map = circle | map(((rid, node, name), d) -> (node, (rid, name, d)));
let found_idx = found_map | arrange;
let person_idx = person | arrange;
let found_join = found_idx | join(person_idx, (node, (rid, name, d), (first, last, gender, birthday, created, ip, browser, home, _, _, _)) -> ((first, name) eq, (home, (rid, node, d, last, gender, birthday, created, ip, browser))));
let found_rows = found_join | filter((named, _) -> named) | map((_, row) -> row);
let found_idx2 = found_rows | arrange;
let place_idx = place | arrange;
let found = found_idx2 | join(place_idx, (_, (rid, node, d, last, gender, birthday, created, ip, browser), (town, _, _)) -> ((rid, node), (d, (last, gender, birthday, created, ip, browser, town))));
let who = found | map(((rid, node), _) -> (node, rid));
let who_idx = who | arrange;
let email_idx = email | arrange;
let emails_join = who_idx | join(email_idx, (node, rid, value) -> ((rid, node), value));
let emails_idx = emails_join | arrange;
let emails = emails_idx | reduce((_, vals) -> let lists = vals map ((v, d) -> (v, (0, d) range) cap_list map ((v, _) -> v)) in let flat = lists flatten in (flat.1, 1) enlist);
let language_idx = language | arrange;
let langs_join = who_idx | join(language_idx, (node, rid, value) -> ((rid, node), value));
let langs_idx = langs_join | arrange;
let langs = langs_idx | reduce((_, vals) -> let lists = vals map ((v, d) -> (v, (0, d) range) cap_list map ((v, _) -> v)) in let flat = lists flatten in (flat.1, 1) enlist);
let study_idx = study | arrange;
let school_join = who_idx | join(study_idx, (node, rid, (at, year)) -> (at, (rid, node, year)));
let school_idx = school_join | arrange;
let org_idx = org | arrange;
let school_join2 = school_idx | join(org_idx, (_, (rid, node, year), (name, _, at)) -> (at, (rid, node, name, year)));
let school_idx2 = school_join2 | arrange;
let school_join3 = school_idx2 | join(place_idx, (_, (rid, node, name, year), (where, _, _)) -> ((rid, node), (name, year, where)));
let school_idx3 = school_join3 | arrange;
let school = school_idx3 | reduce((_, vals) -> let lists = vals map ((v, d) -> (v, (0, d) range) cap_list map ((v, _) -> v)) in let flat = lists flatten in (flat.1, 1) enlist);
let work_idx = work | arrange;
let jobs_join = who_idx | join(work_idx, (node, rid, (at, year)) -> (at, (rid, node, year)));
let jobs_idx = jobs_join | arrange;
let jobs_join2 = jobs_idx | join(org_idx, (_, (rid, node, year), (name, _, at)) -> (at, (rid, node, name, year)));
let jobs_idx2 = jobs_join2 | arrange;
let jobs_join3 = jobs_idx2 | join(place_idx, (_, (rid, node, name, year), (where, _, _)) -> ((rid, node), (name, year, where)));
let jobs_idx3 = jobs_join3 | arrange;
let jobs = jobs_idx3 | reduce((_, vals) -> let lists = vals map ((v, d) -> (v, (0, d) range) cap_list map ((v, _) -> v)) in let flat = lists flatten in (flat.1, 1) enlist);
let found_idx3 = found | arrange;
let with1_join = found_idx3 | join(emails, (key, row, list) -> (key, (row, list)));
let with1_join2 = found_idx3 | join(emails, (key, row, _) -> (key, row));
let with1_neg = with1_join2 | negate;
let with1_rows = found + with1_neg;
let with1_map = with1_rows | map((key, row) -> (key, (row, [] : List(List(int)))));
let with1 = with1_join + with1_map;
let with1_idx = with1 | arrange;
let with2_join = with1_idx | join(langs, (key, (row, e), list) -> (key, (row, e, list)));
let with2_join2 = with1_idx | join(langs, (key, row, _) -> (key, row));
let with2_neg = with2_join2 | negate;
let with2_rows = with1 + with2_neg;
let with2_map = with2_rows | map((key, (row, e)) -> (key, (row, e, [] : List(List(int)))));
let with2 = with2_join + with2_map;
let with2_idx = with2 | arrange;
let with3_join = with2_idx | join(school, (key, (row, e, l), list) -> (key, (row, e, l, list)));
let with3_join2 = with2_idx | join(school, (key, row, _) -> (key, row));
let with3_neg = with3_join2 | negate;
let with3_rows = with2 + with3_neg;
let with3_map = with3_rows | map((key, (row, e, l)) -> (key, (row, e, l, [] : List((List(int), int, List(int))))));
let with3 = with3_join + with3_map;
let with3_idx = with3 | arrange;
let with4_join = with3_idx | join(jobs, (key, (row, e, l, s), list) -> (key, (row, e, l, s, list)));
let with4_join2 = with3_idx | join(jobs, (key, row, _) -> (key, row));
let with4_neg = with4_join2 | negate;
let with4_rows = with3 + with4_neg;
let with4_map = with4_rows | map((key, (row, e, l, s)) -> (key, (row, e, l, s, [] : List((List(int), int, List(int))))));
let with4 = with4_join + with4_map;
let ranked_map = with4 | map(((rid, node), ((d, (last, gender, birthday, created, ip, browser, town)), e, l, s, w)) -> (rid, ((d, last, node), (gender, birthday, created, ip, browser, town, e, l, s, w))));
let ranked_idx = ranked_map | arrange;
let ranked = ranked_idx | reduce((_, vals) -> let positive = (vals map ((_, d) -> (d, 0) gt), (0, vals len) range) zip filter in let indices = ((0, (positive len, 20) min) range, positive) gather in let prefix = (indices, vals) gather in let ends = prefix map ((_, d) -> (d, 20) min) scan_add in let chosen = (prefix, ends) zip map (((item, d), end) -> let count = (d, 20) min in let before = (end, count) sub in let keep = (((20, before) sub, 0) max, count) min in ((keep, 0) gt, (item, keep))) filter in let ends = chosen map ((_, d) -> d) scan_add in (chosen, ends) zip map (((item, d), end) -> (item, ((end, d) sub, end) range) cap_list map ((item, rank) -> ((rank, item), 1))) flatten .1);
let answer = ranked | map((rid, (rank, ((d, last, node), (gender, birthday, created, ip, browser, town, e, l, s, w)))) -> ((rid, rank), (node, last, d, birthday, created, gender, browser, ip, e, l, town, s, w)));
let answer_idx = answer | arrange;
-- Renderer: publish the existing arrangement.
export "ic1x1.answer" = answer_idx;
