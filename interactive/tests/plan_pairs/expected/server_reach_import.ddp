-- Time lanes: epoch.
let edges = input "edges" : ((int), (int));
let roots = input "roots" : ((int), ());
let edges_idx = edges | arrange;
reach: {
    -- Time lanes: epoch, then 1 scope coordinates; this scope enters at zero.
    var reach;
    let reach_idx = reach | arrange;
    let proposals = reach_idx | join(::edges_idx, (_, _, dst) -> (dst, ()));
    let reach_rows = ::roots + proposals;
    let reach_idx2 = reach_rows | arrange;
    let reach_reduce = reach_idx2 | reduce((_, vals) -> vals map (((), _) -> ((), 1)));
    set reach = reach_reduce;
}
let result_inspect = reach::reach | inspect(reach);
-- Renderer: build an export arrangement.
output "result" = result_inspect;
