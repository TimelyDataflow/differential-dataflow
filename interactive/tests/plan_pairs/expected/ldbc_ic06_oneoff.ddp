-- Time lanes: epoch.
-- Trace imports use provider arrangements; history advances to G = (1, []), placeholder install epoch 2.
let request = input 0 : ((int, int, List(int)), ());
let person = import "ldbc.person" : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let message = import "ldbc.message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let friend = import "ldbc.friend" : (int, (int, int));
let tag = import "ldbc.tag" : (int, (List(int), int));
let by_name = import "ldbc.tag.by_name" : (List(int), int);
let tagged = import "ldbc.mtag.by_tag" : (int, int);
let tags_of = import "ldbc.mtag.by_message" : (int, int);
let hop1_map = request | map(((rid, who, _), ()) -> (who, (rid, who)));
let hop1_idx = hop1_map | arrange;
let person_idx = person | arrange;
let hop1_join = hop1_idx | join(person_idx, (who, req, _) -> (who, req));
let hop1_idx2 = hop1_join | arrange;
let friend_idx = friend | arrange;
let hop1 = hop1_idx2 | join(friend_idx, (_, (rid, who), (f, _)) -> (f, (rid, who)));
let hop1_idx3 = hop1 | arrange;
let hop2 = hop1_idx3 | join(friend_idx, (_, (rid, who), (g, _)) -> (g, (rid, who)));
let circle_rows = hop1 + hop2;
let circle_rows2 = circle_rows | filter((node, (_, who)) -> (node, who) ne) | map((node, (rid, _)) -> ((rid, node), ()));
let circle_idx = circle_rows2 | arrange;
let circle = circle_idx | distinct;
let with_it_map = request | map(((rid, _, name), ()) -> (name, rid));
let with_it_idx = with_it_map | arrange;
let by_name_idx = by_name | arrange;
let with_it_join = with_it_idx | join(by_name_idx, (_, rid, t) -> (t, rid));
let with_it_idx2 = with_it_join | arrange;
let tagged_idx = tagged | arrange;
let with_it_join2 = with_it_idx2 | join(tagged_idx, (t, rid, m) -> (m, (rid, t)));
let with_it_idx3 = with_it_join2 | arrange;
let message_idx = message | arrange;
let with_it_join3 = with_it_idx3 | join(message_idx, (m, (rid, t), (kind, _, author, _, _, _, _, _, _, _, _, _, _)) -> ((rid, author), (kind, m, t)));
let with_it_filter = with_it_join3 | filter((_, (kind, _, _)) -> (kind, 0) eq);
let with_it_idx4 = with_it_filter | arrange;
let with_it = with_it_idx4 | join(circle, ((rid, _), (_, m, t), ()) -> (m, (rid, t)));
let with_it_idx5 = with_it | arrange;
let tags_of_idx = tags_of | arrange;
let others_join = with_it_idx5 | join(tags_of_idx, (_, (rid, t), other) -> ((rid, t, other), ()));
let others_rows = others_join | filter(((_, t, other), ()) -> (t, other) ne) | map(((rid, _, other), ()) -> ((rid, other), ()));
let others_idx = others_rows | arrange;
let others = others_idx | count;
let ranked_map = others | map(((rid, other), n) -> (other, (rid, n)));
let ranked_idx = ranked_map | arrange;
let tag_idx = tag | arrange;
let ranked_join = ranked_idx | join(tag_idx, (_, (rid, n), (name, _)) -> (rid, (n neg, name)));
let ranked_idx2 = ranked_join | arrange;
let ranked = ranked_idx2 | reduce((_, vals) -> let positive = (vals map ((_, d) -> (d, 0) gt), (0, vals len) range) zip filter in let indices = ((0, (positive len, 10) min) range, positive) gather in let prefix = (indices, vals) gather in let ends = prefix map ((_, d) -> (d, 10) min) scan_add in let chosen = (prefix, ends) zip map (((item, d), end) -> let count = (d, 10) min in let before = (end, count) sub in let keep = (((10, before) sub, 0) max, count) min in ((keep, 0) gt, (item, keep))) filter in let ends = chosen map ((_, d) -> d) scan_add in (chosen, ends) zip map (((item, d), end) -> (item, ((end, d) sub, end) range) cap_list map ((item, rank) -> ((rank, item), 1))) flatten .1);
let answer = ranked | map((rid, (rank, (neg, other))) -> ((rid, rank), (other, neg neg)));
let answer_idx = answer | arrange;
-- Renderer: publish the existing arrangement.
export "ic6x1.answer" = answer_idx;
