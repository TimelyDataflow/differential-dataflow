let message = input "message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let friend = input "friend" : (int, (int, int));
let tag = input "tag" : (int, (List(int), int));
let mtag = input "mtag_by_tag" : (int, int);
let posts = message | filter((_, (kind, _, _, _, _, _, _, _, _, _, _, _, _)) -> (kind, 0) eq) | map((id, (_, created, who, _, _, _, _, _, _, _, _, _, _)) -> (who, (id, created)));
let tags = mtag | join(tag, (t, (m, (name, _))) -> (m, (t, name)));
output "posts" = posts | arrange;
output "tags" = tags | arrange;
