-- Time lanes: epoch.
let intents = input 0 : ((int, int, int), (int));
let reads = intents | filter(((_, r, _), _) -> (r, 1) eq) | map(((rid, _, k), (e)) -> ((rid, k), (e)));
let wid = intents | filter(((_, r, _), _) -> (r, 0) eq) | map(((wid, _, k), (v)) -> ((wid, k), (v))) | map(((wid, k), (v)) -> ((wid), (k, v)));
res: {
    -- Time lanes: epoch, then 1 scope coordinates; this scope enters at zero.
    var rollback : ((int), ());
    let wid_idx = ::wid | arrange;
    let rollback_idx = rollback | arrange;
    let wr_bad = wid_idx | join(rollback_idx, (wid, kv, ()) -> (wid, kv));
    let writes_neg = wr_bad | negate;
    let writes = ::wid + writes_neg;
    let wk = writes | map(((wid), (k, v)) -> ((k), (wid, v)));
    let rk = ::reads | map(((rid, k), (e)) -> ((k), (rid, e)));
    let rk_idx = rk | arrange;
    let wk_idx = wk | arrange;
    let pairs_join = rk_idx | join(wk_idx, ((k), (rid, e), (wid, v)) -> ((k, rid, e), (wid, v)));
    let best_rows = pairs_join | filter(((_, rid, _), (wid, _)) -> (wid, rid) lt) | map((kre, (wid, v)) -> (kre, (wid neg, v)));
    let best_idx = best_rows | arrange;
    let best = best_idx | reduce((_, a) -> (a head.0, 1) enlist map ((a, b) -> (((), a.1), b)));
    let bad_seen = best | filter(((_, _, e), (_, v)) -> (v, e) ne) | map(((_, rid, _), _) -> ((rid), ()));
    let rkk = ::reads | map((rk, _) -> (rk, ()));
    let unseen_rows = best | map(((k, rid, _), _) -> ((rid, k), ())) | negate;
    let unseen = rkk + unseen_rows;
    let unseen_idx = unseen | arrange;
    let reads_idx = ::reads | arrange;
    let bad_absent_join = unseen_idx | join(reads_idx, ((rid, _), (), (e)) -> ((rid, e), ()));
    let bad_absent = bad_absent_join | filter(((_, e), ()) -> (e, -1) ne) | map(((rid, _), ()) -> ((rid), ()));
    let rollback_rows = bad_seen + bad_absent;
    let rollback_idx2 = rollback_rows | arrange;
    let rollback_reduce = rollback_idx2 | reduce((_, vals) -> vals map (((), _) -> ((), 1)));
    set rollback = rollback_reduce;
}
let rb = res::rollback;
let wid_idx = wid | arrange;
let rb_idx = rb | arrange;
let wbad = wid_idx | join(rb_idx, (wid, kv, ()) -> (wid, kv));
let committed_neg = wbad | negate;
let committed = wid + committed_neg;
let current_map = committed | map(((wid), (k, v)) -> ((k), (wid neg, v)));
let current_idx = current_map | arrange;
let current = current_idx | reduce((_, vals) -> let first = vals head in (first.0, 1) enlist);
let state_map = current | map((k, (_, v)) -> (k, (v)));
let retire_rows = current | map(((k), (nw, v)) -> ((nw neg, 0, k), (v))) | negate;
let retire_rows2 = intents + retire_rows;
-- Renderer: build an export arrangement.
export "rollback" = rb;
-- Renderer: build an export arrangement.
export "state" = state_map;
-- Renderer: build an export arrangement.
export "retire" = retire_rows2;
