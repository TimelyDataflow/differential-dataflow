let person_in = input 0 : ((int, List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int), ());
let message_in = input 1 : ((int, int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int), ());
let forum_in = input 2 : ((int, List(int), int, int), ());
let knows_in = input 3 : ((int, int, int), ());
let member_in = input 4 : ((int, int, int), ());
let tag_in = input 5 : ((int, List(int), int), ());
let tagclass_in = input 6 : ((int, List(int), int), ());
let place_in = input 7 : ((int, List(int), List(int), int), ());
let org_in = input 8 : ((int, List(int), List(int), int), ());
let interest_in = input 9 : ((int, int), ());
let mtag_in = input 10 : ((int, int), ());
let ftag_in = input 11 : ((int, int), ());
let likes_in = input 12 : ((int, int, int), ());
let study_in = input 13 : ((int, int, int), ());
let work_in = input 14 : ((int, int, int), ());
let email_in = input 15 : ((int, List(int)), ());
let language_in = input 16 : ((int, List(int)), ());
let del_person = input 17 : ((int, int), ());
let del_forum = input 18 : ((int, int), ());
let del_message = input 19 : ((int, int), ());
let del_knows = input 20 : ((int, int, int), ());
let del_member = input 21 : ((int, int, int), ());
let del_likes = input 22 : ((int, int, int), ());

-- People deleted, and the forums they moderated: Walls and Albums are deleted, Groups lose their moderator.
let dead_p = del_person | map(((id, _), ()) -> (id, ())) | distinct;
let owned  = forum_in | map(((id, title, created, moderator), ()) -> (moderator, (id, title, created)))
                      | join(dead_p, (moderator, (id, title, created), ()) -> (id, (title, created, moderator)));
let dead_f = ((del_forum | map(((id, _), ()) -> (id, ()))) + (owned | filter((_, (title, _, _)) -> ((((0, (title len, 6) min) range, title) gather, "Album ") eq, (((0, (title len, 5) min) range, title) gather, "Wall ") eq) any)
                                                                  | map((id, _) -> (id, ())))) | distinct;
let groups = owned | filter((_, (title, _, _)) -> (((0, (title len, 6) min) range, title) gather, "Group ") eq);
let kept   = groups - (groups | join(dead_f, (id, v, ()) -> (id, v)));

-- Messages deleted: explicit targets, those of deleted people, the posts of deleted forums,
-- and every reply below any of them.
let seeds = (del_message | map(((id, _), ()) -> (id, ())))
          + (message_in | map(((id, kind, created, creator, country, content, image, length, language, forum, parent, year, month, day), ()) -> (creator, id)) | join(dead_p, (_, id, ()) -> (id, ())))
          + (message_in | filter(((id, kind, created, creator, country, content, image, length, language, forum, parent, year, month, day), ()) -> (kind, 0) eq) | map(((id, kind, created, creator, country, content, image, length, language, forum, parent, year, month, day), ()) -> (forum, id)) | join(dead_f, (_, id, ()) -> (id, ())));
let children = message_in | filter(((id, kind, created, creator, country, content, image, length, language, forum, parent, year, month, day), ()) -> (kind, 1) eq) | map(((id, kind, created, creator, country, content, image, length, language, forum, parent, year, month, day), ()) -> (parent, id));
dead_m: {
    let kids   = dead_m | join(children, (_, (), child) -> (child, ()));
    set dead_m = (seeds + kids) | distinct;
}
let dead_msg = dead_m::dead_m;
let gone_knows  = del_knows  | map(((a, b, _), ()) -> ((a, b), ())) | distinct;
let gone_member = del_member | map(((f, p, _), ()) -> ((f, p), ())) | distinct;
let gone_likes  = del_likes  | map(((p, x, _), ()) -> ((p, x), ())) | distinct;

let person = person_in - (((person_in | map(((id, first, last, gender, birthday, created, ip, browser, city, birthmonth, birthdaynum, creationmonth), ()) -> (id, (id, first, last, gender, birthday, created, ip, browser, city, birthmonth, birthdaynum, creationmonth))) | join(dead_p, (_, r, ()) -> (r, ())))) | distinct);
let message = message_in - (((message_in | map(((id, kind, created, creator, country, content, image, length, language, forum, parent, year, month, day), ()) -> (id, (id, kind, created, creator, country, content, image, length, language, forum, parent, year, month, day))) | join(dead_msg, (_, r, ()) -> (r, ())))) | distinct);
let forum = forum_in - (((forum_in | map(((id, title, created, moderator), ()) -> (id, (id, title, created, moderator))) | join(dead_f, (_, r, ()) -> (r, ()))) + (kept | map((id, (title, created, moderator)) -> ((id, title, created, moderator), ())))) | distinct)
          + (kept | map((id, (title, created, _)) -> ((id, title, created, -1), ())));
let knows = knows_in - (((knows_in | map(((src, dst, created), ()) -> ((src, dst), (src, dst, created))) | join(gone_knows, (_, r, ()) -> (r, ()))) + (knows_in | map(((src, dst, created), ()) -> (src, (src, dst, created))) | join(dead_p, (_, r, ()) -> (r, ()))) + (knows_in | map(((src, dst, created), ()) -> (dst, (src, dst, created))) | join(dead_p, (_, r, ()) -> (r, ())))) | distinct);
let member = member_in - (((member_in | map(((forum, person, created), ()) -> ((forum, person), (forum, person, created))) | join(gone_member, (_, r, ()) -> (r, ()))) + (member_in | map(((forum, person, created), ()) -> (forum, (forum, person, created))) | join(dead_f, (_, r, ()) -> (r, ()))) + (member_in | map(((forum, person, created), ()) -> (person, (forum, person, created))) | join(dead_p, (_, r, ()) -> (r, ())))) | distinct);
let tag = tag_in;
let tagclass = tagclass_in;
let place = place_in;
let org = org_in;
let interest = interest_in - (((interest_in | map(((person, tag), ()) -> (person, (person, tag))) | join(dead_p, (_, r, ()) -> (r, ())))) | distinct);
let mtag = mtag_in - (((mtag_in | map(((message, tag), ()) -> (message, (message, tag))) | join(dead_msg, (_, r, ()) -> (r, ())))) | distinct);
let ftag = ftag_in - (((ftag_in | map(((forum, tag), ()) -> (forum, (forum, tag))) | join(dead_f, (_, r, ()) -> (r, ())))) | distinct);
let likes = likes_in - (((likes_in | map(((person, message, created), ()) -> ((person, message), (person, message, created))) | join(gone_likes, (_, r, ()) -> (r, ()))) + (likes_in | map(((person, message, created), ()) -> (person, (person, message, created))) | join(dead_p, (_, r, ()) -> (r, ()))) + (likes_in | map(((person, message, created), ()) -> (message, (person, message, created))) | join(dead_msg, (_, r, ()) -> (r, ())))) | distinct);
let study = study_in - (((study_in | map(((person, org, year), ()) -> (person, (person, org, year))) | join(dead_p, (_, r, ()) -> (r, ())))) | distinct);
let work = work_in - (((work_in | map(((person, org, year), ()) -> (person, (person, org, year))) | join(dead_p, (_, r, ()) -> (r, ())))) | distinct);
let email = email_in - (((email_in | map(((person, value), ()) -> (person, (person, value))) | join(dead_p, (_, r, ()) -> (r, ())))) | distinct);
let language = language_in - (((language_in | map(((person, value), ()) -> (person, (person, value))) | join(dead_p, (_, r, ()) -> (r, ())))) | distinct);
export "ldbc.person" = person | map(((id, first, last, gender, birthday, created, ip, browser, city, birthmonth, birthdaynum, creationmonth), ()) -> (id, (first, last, gender, birthday, created, ip, browser, city, birthmonth, birthdaynum, creationmonth))) | arrange;
export "ldbc.person.by_city" = person | map(((id, first, last, gender, birthday, created, ip, browser, city, birthmonth, birthdaynum, creationmonth), ()) -> (city, id)) | arrange;
export "ldbc.message" = message | map(((id, kind, created, creator, country, content, image, length, language, forum, parent, year, month, day), ()) -> (id, (kind, created, creator, country, content, image, length, language, forum, parent, year, month, day))) | arrange;
export "ldbc.message.by_creator" = message | map(((id, kind, created, creator, country, content, image, length, language, forum, parent, year, month, day), ()) -> (creator, id)) | arrange;
export "ldbc.message.by_parent" = message | map(((id, kind, created, creator, country, content, image, length, language, forum, parent, year, month, day), ()) -> (parent, id)) | arrange;
export "ldbc.message.by_forum" = message | map(((id, kind, created, creator, country, content, image, length, language, forum, parent, year, month, day), ()) -> (forum, id)) | arrange;
export "ldbc.forum" = forum | map(((id, title, created, moderator), ()) -> (id, (title, created, moderator))) | arrange;
export "ldbc.forum.by_moderator" = forum | map(((id, title, created, moderator), ()) -> (moderator, id)) | arrange;
export "ldbc.knows.by_src" = knows | map(((src, dst, created), ()) -> (src, (dst, created))) | arrange;
export "ldbc.member.by_forum" = member | map(((forum, person, created), ()) -> (forum, (person, created))) | arrange;
export "ldbc.member.by_person" = member | map(((forum, person, created), ()) -> (person, (forum, created))) | arrange;
export "ldbc.tag" = tag | map(((id, name, class), ()) -> (id, (name, class))) | arrange;
export "ldbc.tag.by_name" = tag | map(((id, name, class), ()) -> (name, id)) | arrange;
export "ldbc.tag.by_class" = tag | map(((id, name, class), ()) -> (class, id)) | arrange;
export "ldbc.tagclass" = tagclass | map(((id, name, parent), ()) -> (id, (name, parent))) | arrange;
export "ldbc.tagclass.by_name" = tagclass | map(((id, name, parent), ()) -> (name, id)) | arrange;
export "ldbc.tagclass.by_parent" = tagclass | map(((id, name, parent), ()) -> (parent, id)) | arrange;
export "ldbc.place" = place | map(((id, name, typ, parent), ()) -> (id, (name, typ, parent))) | arrange;
export "ldbc.place.by_name" = place | map(((id, name, typ, parent), ()) -> (name, id)) | arrange;
export "ldbc.place.by_parent" = place | map(((id, name, typ, parent), ()) -> (parent, id)) | arrange;
export "ldbc.org" = org | map(((id, name, typ, place), ()) -> (id, (name, typ, place))) | arrange;
export "ldbc.org.by_name" = org | map(((id, name, typ, place), ()) -> (name, id)) | arrange;
export "ldbc.interest.by_person" = interest | map(((person, tag), ()) -> (person, tag)) | arrange;
export "ldbc.interest.by_tag" = interest | map(((person, tag), ()) -> (tag, person)) | arrange;
export "ldbc.mtag.by_message" = mtag | map(((message, tag), ()) -> (message, tag)) | arrange;
export "ldbc.mtag.by_tag" = mtag | map(((message, tag), ()) -> (tag, message)) | arrange;
export "ldbc.ftag.by_forum" = ftag | map(((forum, tag), ()) -> (forum, tag)) | arrange;
export "ldbc.likes.by_person" = likes | map(((person, message, created), ()) -> (person, (message, created))) | arrange;
export "ldbc.likes.by_message" = likes | map(((person, message, created), ()) -> (message, (person, created))) | arrange;
export "ldbc.study.by_person" = study | map(((person, org, year), ()) -> (person, (org, year))) | arrange;
export "ldbc.work.by_person" = work | map(((person, org, year), ()) -> (person, (org, year))) | arrange;
export "ldbc.work.by_org" = work | map(((person, org, year), ()) -> (org, (person, year))) | arrange;
export "ldbc.email.by_person" = email | map(((person, value), ()) -> (person, value)) | arrange;
export "ldbc.language.by_person" = language | map(((person, value), ()) -> (person, value)) | arrange;
-- Friendships in both directions, between people who exist: (person, (friend, since)).
let exists = person | map(((id, _, _, _, _, _, _, _, _, _, _, _), ()) -> (id, ())) | distinct;
let either = (knows | map(((a, b, t), ()) -> (a, (b, t)))) + (knows | map(((a, b, t), ()) -> (b, (a, t))));
let friends = either | join(exists, (a, (b, t), ()) -> (b, (a, t)))
                     | join(exists, (b, (a, t), ()) -> ((a, b, t), ())) | distinct
                     | map(((a, b, t), ()) -> (a, (b, t)));
export "ldbc.friend" = friends | arrange;
export "ldbc.friend.pair" = friends | map((a, (b, _)) -> ((a, b), ())) | arrange;
-- Threads: every post is its own root; a comment's root is its parent's.
let posts   = message | filter(((_, kind, _, _, _, _, _, _, _, _, _, _, _, _), ()) -> (kind, 0) eq)
                      | map(((id, _, _, _, _, _, _, _, _, _, _, _, _, _), ()) -> ((id, id), ()));
let replies = message | filter(((_, kind, _, _, _, _, _, _, _, _, _, _, _, _), ()) -> (kind, 1) eq)
                      | map(((id, _, _, _, _, _, _, _, _, _, parent, _, _, _), ()) -> (parent, id));
thread: {
    let below  = thread | map(((mid, root), ()) -> (mid, root))
                        | join(replies, (_, root, child) -> ((child, root), ()));
    set thread = (posts + below) | distinct;
}
export "ldbc.message.root" = thread::thread | map(((mid, root), ()) -> (mid, root)) | arrange;
export "ldbc.message.by_root" = thread::thread | map(((mid, root), ()) -> (root, mid)) | arrange;
