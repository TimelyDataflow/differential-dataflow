let request = input 0 : ((int, int, int), ());
let person  = import "ldbc.person" : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let message = import "ldbc.message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let friend  = import "ldbc.friend" : (int, (int, int));
let by_author = import "ic9.s.by_author" : (int, (int, int));
let latest = import "ic9.s.latest" : (int, (int, int));
let newest = import "ic9.s.newest" : (int, int);
let hop1    = request | map(((rid, who, max), ()) -> (who, (rid, who, max))) | join(person, (who, req, _) -> (who, req))
                      | join(friend, (_, req, (f, _)) -> (f, req));
let hop2    = hop1 | join(friend, (_, req, (g, _)) -> (g, req));
let friends = (hop1 + hop2) | filter((node, (_, who, _)) -> (node, who) ne)
                            | map((node, (rid, _, max)) -> ((node, rid, max), ())) | distinct
                            | map(((node, rid, max), ()) -> (node, (rid, max)));
let ahead   = friends | join(newest, (f, (rid, max), neg) -> (f, (rid, max, neg neg)));
let fast    = ahead | filter((_, (_, max, last)) -> (last, max) lt)
                    | join(latest, (f, (rid, _, _), (neg, id)) -> (rid, ((neg, id), f)));
let slow    = ahead | filter((_, (_, max, last)) -> (last, max) ge)
                    | join(by_author, (f, (rid, max, _), (neg, id)) -> ((rid, f), ((neg, id), max)))
                    | filter((_, ((neg, _), max)) -> (neg neg, max) lt)
                    | map((key, (order, _)) -> (key, order))
                    | reduce((_, vals) -> let positive = (vals map ((_, d) -> (d, 0) gt), (0, vals len) range) zip filter in let indices = ((0, (positive len, 20) min) range, positive) gather in let prefix = (indices, vals) gather in let ends = prefix map ((_, d) -> (d, 20) min) scan_add in let chosen = (prefix, ends) zip map (((item, d), end) -> let count = (d, 20) min in let before = (end, count) sub in let keep = (((20, before) sub, 0) max, count) min in ((keep, 0) gt, (item, keep))) filter in let ends = chosen map ((_, d) -> d) scan_add in (chosen, ends) zip map (((item, d), end) -> (item, ((end, d) sub, end) range) cap_list map ((item, rank) -> ((rank, item), 1))) flatten .1)
                    | map(((rid, f), (_, order)) -> (rid, (order, f)));
let top     = (fast + slow) | reduce((_, vals) -> let positive = (vals map ((_, d) -> (d, 0) gt), (0, vals len) range) zip filter in let indices = ((0, (positive len, 20) min) range, positive) gather in let prefix = (indices, vals) gather in let ends = prefix map ((_, d) -> (d, 20) min) scan_add in let chosen = (prefix, ends) zip map (((item, d), end) -> let count = (d, 20) min in let before = (end, count) sub in let keep = (((20, before) sub, 0) max, count) min in ((keep, 0) gt, (item, keep))) filter in let ends = chosen map ((_, d) -> d) scan_add in (chosen, ends) zip map (((item, d), end) -> (item, ((end, d) sub, end) range) cap_list map ((item, rank) -> ((rank, item), 1))) flatten .1);
let answer  = top | map((rid, (rank, ((neg, id), f))) -> (id, (rid, rank, neg neg, f)))
                  | join(message, (id, (rid, rank, created, f), (_, _, _, _, content, image, _, _, _, _, _, _, _)) ->
                         (f, (rid, rank, id, ((content len, 0) gt, content, image) select, created)))
                  | join(person, (f, (rid, rank, id, body, created), (first, last, _, _, _, _, _, _, _, _, _)) -> ((rid, rank), (f, first, last, id, body, created)));
export "ic9.answer" = answer | arrange;
