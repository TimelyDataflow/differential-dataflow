let person   = input "person" : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let message  = input "message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let friend   = input "friend" : (int, (int, int));
let place    = input "place" : (int, (List(int), List(int), int));
let tags_of  = input "mtag_by_message" : (int, int);
let interest = input "interest_by_person" : (int, int);
let people = person | map((id, (first, last, gender, _, _, _, _, home, bmonth, bday, _)) -> (home, (id, first, last, gender, bmonth, bday)))
                    | join(place, (_, ((id, first, last, gender, bmonth, bday), (town, _, _))) -> (id, (first, last, gender, town, bmonth, bday)));
let posts  = message | filter((_, (kind, _, _, _, _, _, _, _, _, _, _, _, _)) -> (kind, 0) eq)
                     | map((id, (_, _, who, _, _, _, _, _, _, _, _, _, _)) -> (who, id));
let likes  = interest | map((p, t) -> ((p, t), ()));
output "people" = people | arrange;
output "posts" = posts | arrange;
output "likes" = likes | arrange;
