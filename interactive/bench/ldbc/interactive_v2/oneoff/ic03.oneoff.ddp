let request = input 0 : ((int, int, List(int), List(int), int, int), ());
let person  = import "ldbc.person"  : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let message = import "ldbc.message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let friend  = import "ldbc.friend"  : (int, (int, int));
let place   = import "ldbc.place"   : (int, (List(int), List(int), int));
let by_name = import "ldbc.place.by_name" : (List(int), int);
let sent_from = import "ic3.s.sent_from" : (int, (int, int));
let asked = request | map(((rid, who, x, y, start, days), ()) -> (x, (rid, who, y, start, (start, (days, 86400000) mul) add)))
                    | join(by_name, (_, req, x) -> (x, req))
                    | join(place, (x, (rid, who, y, start, end), (_, kind, _)) -> ((kind, [67,111,117,110,116,114,121]) eq, (y, (rid, who, x, start, end))))
                    | filter((country, _) -> country) | map((_, row) -> row)
                    | join(by_name, (_, req, y) -> (y, req))
                    | join(place, (y, (rid, who, x, start, end), (_, kind, _)) -> ((kind, [67,111,117,110,116,114,121]) eq, (rid, (who, x, y, start, end))))
                    | filter((country, _) -> country) | map((_, row) -> row);
let window    = (asked | map((rid, (_, x, _, start, end)) -> (x, (rid, start, end, 1, 0))))
              + (asked | map((rid, (_, _, y, start, end)) -> (y, (rid, start, end, 0, 1))));
let visits    = window | join(sent_from, (_, (rid, start, end, ix, iy), (author, created)) -> ((rid, author), (created, start, end, ix, iy)))
                       | filter((_, (created, start, end, _, _)) -> ((created, start) ge, (created, end) lt) all)
                       | map((key, (_, _, _, ix, iy)) -> (key, (ix, iy)));
let hop1   = asked | map((rid, (who, x, y, _, _)) -> (who, (rid, who, x, y)))
                   | join(friend, (_, req, (f, _)) -> (f, req));
let hop2   = hop1 | join(friend, (_, req, (g, _)) -> (g, req));
let circle = (hop1 + hop2) | filter((node, (_, who, _, _)) -> (node, who) ne)
                           | join(person, (node, (rid, _, x, y), (_, _, _, _, _, _, _, city, _, _, _)) -> (city, (rid, node, x, y)))
                           | join(place, (_, (rid, node, x, y), (_, _, home)) -> ((rid, node), (x, y, home)))
                           | filter((_, (x, y, home)) -> ((home, x) ne, (home, y) ne) all)
                           | map((key, _) -> (key, ())) | distinct;
let seen   = visits | join(circle, (key, (ix, iy), ()) -> (key, (ix, iy)));
let in_x   = seen | filter((_, (ix, _)) -> (ix, 1) eq) | map((key, _) -> (key, ())) | count;
let in_y   = seen | filter((_, (_, iy)) -> (iy, 1) eq) | map((key, _) -> (key, ())) | count;
let counts = in_x | join(in_y, (key, nx, ny) -> (key, (nx, ny)));
let ranked = counts | map(((rid, node), (nx, ny)) -> (node, (rid, nx, ny)))
                    | join(person, (node, (rid, nx, ny), (first, last, _, _, _, _, _, _, _, _, _)) -> (rid, (((nx, ny) add neg, node), (first, last, nx, ny))))
                    | reduce((_, vals) -> let positive = (vals map ((_, d) -> (d, 0) gt), (0, vals len) range) zip filter in let indices = ((0, (positive len, 20) min) range, positive) gather in let prefix = (indices, vals) gather in let ends = prefix map ((_, d) -> (d, 20) min) scan_add in let chosen = (prefix, ends) zip map (((item, d), end) -> let count = (d, 20) min in let before = (end, count) sub in let keep = (((20, before) sub, 0) max, count) min in ((keep, 0) gt, (item, keep))) filter in let ends = chosen map ((_, d) -> d) scan_add in (chosen, ends) zip map (((item, d), end) -> (item, ((end, d) sub, end) range) cap_list map ((item, rank) -> ((rank, item), 1))) flatten .1);
let answer = ranked | map((rid, (rank, ((_, node), (first, last, nx, ny)))) -> ((rid, rank), (node, first, last, nx, ny, (nx, ny) add)));
export "ic3.answer" = answer | arrange;
