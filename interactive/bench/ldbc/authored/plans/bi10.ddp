-- BI10. Experts in a social circle: people between `minimum` and `maximum` hops away who
-- live in a country, and the tags on their messages that carry a tag of the class;
-- top 100 by count. The search stops growing at `maximum` hops; the people it reaches
-- are checked against the country through their city; the class's messages are found
-- first, then kept if their author qualifies.

let request  = input 0 : ((int, int, List(int), List(int), int, int), ());   -- (rid, person, country, class, minimum, maximum)
let message = import "ldbc.message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
    -- (id, (kind, created, creator, country, content, image, length, language, forum, parent, year, month, day))
let person  = import "ldbc.person"  : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
    -- (id, (first, last, gender, birthday, created, ip, browser, city, birth month, birth day, creation month))
let friend   = import "ldbc.friend"          : (int, (int, int));             -- (person, (friend, since))
let place    = import "ldbc.place"           : (int, (List(int), List(int), int));  -- (id, (name, type, parent))
let tag      = import "ldbc.tag"             : (int, (List(int), int));        -- (id, (name, class))
let class_id = import "ldbc.tagclass.by_name" : (List(int), int);              -- (name, id)
let in_class = import "ldbc.tag.by_class"    : (int, int);                     -- (class, tag)
let tagged   = import "ldbc.mtag.by_tag"     : (int, int);                     -- (tag, message)
let tags_of  = import "ldbc.mtag.by_message" : (int, int);                     -- (message, tag)

-- Breadth-first search from the person, growing only below `maximum` hops.
let starts = request | map(((rid, who, _, _, _, most), ()) -> ((rid, most, who, 0), ()));
search: {
    let grow   = search | filter(((_, most, _, d), ()) -> (d, most) lt)
                        | map(((rid, most, node, d), ()) -> (node, (rid, most, d)))
                        | join(friend, (_, (rid, most, d), (next, _)) -> ((rid, most, next, (d, 1) add), ()));
    set search = (starts + grow) | map(((rid, most, node, d), ()) -> ((rid, most, node), d)) | min
                                 | map(((rid, most, node), d) -> ((rid, most, node, d), ()));
}

-- People in range whose city is in the country.
let asked  = request | map(((rid, who, country, _, least, _), ()) -> (rid, (who, country, least)));
let people = search::search | map(((rid, _, node, d), ()) -> (rid, (node, d)))
                            | join(asked, (rid, (node, d), (who, country, least)) -> (node, (rid, d, who, country, least)))
                            | filter((node, (_, d, who, _, least)) -> ((d, least) ge, (node, who) ne) all)
                            | join(person, (node, (rid, _, _, country, _), (_, _, _, _, _, _, _, city, _, _, _)) -> (city, (rid, node, country)))
                            | join(place, (_, (rid, node, country), (_, _, up)) -> (up, (rid, node, country)))
                            | join(place, (_, (rid, node, country), (kname, _, _)) -> ((rid, node), (country, kname)))
                            | filter((_, (country, kname)) -> (country, kname) eq)
                            | map((key, _) -> (key, ()));

-- The class's messages, by author, kept if the author qualifies; then all their tags.
let inclass = request | map(((rid, _, _, cls, _, _), ()) -> (cls, rid))
                      | join(class_id, (_, rid, c) -> (c, rid))
                      | join(in_class, (_, rid, t) -> (t, rid))
                      | join(tagged, (_, rid, m) -> ((rid, m), ())) | distinct
                      | map(((rid, m), ()) -> (m, rid))
                      | join(message, (m, rid, (_, _, who, _, _, _, _, _, _, _, _, _, _)) -> ((rid, who), m))
                      | join(people, ((rid, who), m, ()) -> (m, (rid, who)));
let counts  = inclass | join(tags_of, (_, (rid, who), t) -> (t, (rid, who)))
                      | join(tag, (_, (rid, who), (name, _)) -> ((rid, who, name), ())) | count;
-- Top k: `reduce` sees a key's values in sort order and keeps the first k (copies capped
-- at k), emitting (rank, value). Changes below the top k produce no output.
let ranked  = counts | map(((rid, who, name), n) -> (rid, (n neg, name, who)))
                     | reduce((_, vals) -> let positive = (vals map ((_, d) -> (d, 0) gt), (0, vals len) range) zip filter in let indices = ((0, (positive len, 100) min) range, positive) gather in let prefix = (indices, vals) gather in let ends = prefix map ((_, d) -> (d, 100) min) scan_add in let chosen = (prefix, ends) zip map (((item, d), end) -> let count = (d, 100) min in let before = (end, count) sub in let keep = (((100, before) sub, 0) max, count) min in ((keep, 0) gt, (item, keep))) filter in let ends = chosen map ((_, d) -> d) scan_add in (chosen, ends) zip map (((item, d), end) -> (item, ((end, d) sub, end) range) cap_list map ((item, rank) -> ((rank, item), 1))) flatten .1);
let answer  = ranked | map((rid, (rank, (neg, name, who))) -> ((rid, rank), (who, name, neg neg)));

export "bi10.answer" = answer | arrange;
