-- BI8. Central people for a tag: 100 points for an interest in it, 1 per tagged message
-- inside (start, end); plus the sum of their friends' points; top 100 by the total.
-- Looked up from the request: the tag's fans and messages, the messages' authors, and
-- the scored people's friends.

let request  = input 0 : ((int, List(int), int, int), ());   -- (rid, tag name, start, end)
let message = import "ldbc.message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
    -- (id, (kind, created, creator, country, content, image, length, language, forum, parent, year, month, day))
let friend   = import "ldbc.friend"       : (int, (int, int));         -- (person, (friend, since))
let tag_id   = import "ldbc.tag.by_name"  : (List(int), int);          -- (name, id)
let tagged   = import "ldbc.mtag.by_tag"  : (int, int);                -- (tag, message)
let fans_of  = import "ldbc.interest.by_tag" : (int, int);             -- (tag, person)

let tag_rid = request | map(((rid, name, _, _), ()) -> (name, rid)) | join(tag_id, (_, rid, t) -> (t, rid));
let fans    = tag_rid | join(fans_of, (_, rid, who) -> ((rid, who), 100));
let window  = request | map(((rid, _, start, end), ()) -> (rid, (start, end)));
let recent  = tag_rid | join(tagged, (_, rid, m) -> (m, rid))
                      | join(message, (_, rid, (_, created, who, _, _, _, _, _, _, _, _, _, _)) -> (rid, (who, created)))
                      | join(window, (rid, (who, created), (start, end)) -> ((rid, who), (created, start, end)))
                      | filter((_, (created, start, end)) -> ((created, start) gt, (created, end) lt) all)
                      | map((key, _) -> (key, 1));
-- Sums: move each value into the multiplicity (join_function) and let `count` add them up.
let score   = (fans + recent) | join_function((key, p) -> ((key, ()), (0), p) enlist) | count;

-- Friends' points: for each scored person, the points of their scored friends.
let theirs  = score | map(((rid, f), s) -> (f, (rid, s)))
                    | join(friend, (_, (rid, s), (p, _)) -> ((rid, p), s))
                    | join(score, (key, s, _) -> (key, s));
let summed  = theirs | join_function((key, s) -> ((key, ()), (0), s) enlist) | count;
let friends = summed + ((score - (score | join(summed, (key, s, _) -> (key, s)))) | map((key, _) -> (key, 0)));
-- Top k: `reduce` sees a key's values in sort order and keeps the first k (copies capped
-- at k), emitting (rank, value). Changes below the top k produce no output.
let ranked  = score | join(friends, ((rid, who), s, fs) -> (rid, (((s, fs) add neg, who), (s, fs))))
                    | reduce((_, vals) -> let positive = (vals map ((_, d) -> (d, 0) gt), (0, vals len) range) zip filter in let indices = ((0, (positive len, 100) min) range, positive) gather in let prefix = (indices, vals) gather in let ends = prefix map ((_, d) -> (d, 100) min) scan_add in let chosen = (prefix, ends) zip map (((item, d), end) -> let count = (d, 100) min in let before = (end, count) sub in let keep = (((100, before) sub, 0) max, count) min in ((keep, 0) gt, (item, keep))) filter in let ends = chosen map ((_, d) -> d) scan_add in (chosen, ends) zip map (((item, d), end) -> (item, ((end, d) sub, end) range) cap_list map ((item, rank) -> ((rank, item), 1))) flatten .1);
let answer  = ranked | map((rid, (rank, ((_, who), (s, fs)))) -> ((rid, rank), (who, s, fs)));

export "bi8.answer" = answer | arrange;
