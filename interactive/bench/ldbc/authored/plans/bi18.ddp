-- BI18. Friend recommendation: pairs of people interested in a tag who are not friends
-- yet, ranked by how many friends they share; top 20. Paths go person -> shared
-- friend <- other, and the second hop is restricted to interested people before the
-- paths are built (meeting in the middle).

let request  = input 0 : ((int, List(int)), ());             -- (rid, tag name)
let tag_by_name      = import "ldbc.tag.by_name"      : (List(int), int);   -- (name, tag)
let interest_by_tag  = import "ldbc.interest.by_tag"  : (int, int);         -- (tag, person)
let friend           = import "ldbc.friend"           : (int, (int, int));  -- (person, (friend, since))

-- People interested in the tag: (rid, person).
let fans    = request | map(((rid, name), ()) -> (name, rid))
                      | join(tag_by_name, (_, rid, t) -> (t, rid))
                      | join(interest_by_tag, (_, rid, who) -> ((rid, who), ()));   -- one tag; (person, tag) is a set

-- Each fan's friends, as both ends of a path: (rid, shared friend) -> fan.
let reach   = fans | map(((rid, who), ()) -> (who, rid)) | join(friend, (who, rid, (mid, _)) -> ((rid, mid), who));
let paths   = reach | join(reach, ((rid, _), one, other) -> ((rid, one, other), ()))
                    | filter(((_, one, other), ()) -> (one, other) ne);

-- Drop pairs who are already friends (both are fans, so `reach` holds their
-- friendships), count shared friends, rank.
let known   = reach | map(((rid, mid), who) -> ((rid, who, mid), ()));
let fresh   = paths - (paths | join(known, (key, (), ()) -> (key, ())));
let pairs   = fresh | count;
-- Top k: `reduce` sees a key's values in sort order and keeps the first k (copies capped
-- at k), emitting (rank, value). Changes below the top k produce no output.
let ranked  = pairs | map(((rid, one, other), n) -> (rid, (n neg, one, other)))
                    | reduce((_, vals) -> let positive = (vals map ((_, d) -> (d, 0) gt), (0, vals len) range) zip filter in let indices = ((0, (positive len, 20) min) range, positive) gather in let prefix = (indices, vals) gather in let ends = prefix map ((_, d) -> (d, 20) min) scan_add in let chosen = (prefix, ends) zip map (((item, d), end) -> let count = (d, 20) min in let before = (end, count) sub in let keep = (((20, before) sub, 0) max, count) min in ((keep, 0) gt, (item, keep))) filter in let ends = chosen map ((_, d) -> d) scan_add in (chosen, ends) zip map (((item, d), end) -> (item, ((end, d) sub, end) range) cap_list map ((item, rank) -> ((rank, item), 1))) flatten .1);
let answer  = ranked | map((rid, (rank, (neg, one, other))) -> ((rid, rank), (one, other, neg neg)));

export "bi18.answer" = answer | arrange;
