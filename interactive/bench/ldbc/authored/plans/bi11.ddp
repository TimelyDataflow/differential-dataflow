-- BI11. Friend triangles: how many triangles of friendships are there among the
-- residents of a country, with all three friendships made inside [start, end]?

let request = input 0 : ((int, List(int), int, int), ());     -- (rid, country, start, end)
let place_by_name   = import "ldbc.place.by_name"   : (List(int), int);     -- (name, place)
let place_by_parent = import "ldbc.place.by_parent" : (int, int);           -- (country, city)
let person_by_city  = import "ldbc.person.by_city"  : (int, int);           -- (city, person)
let friend          = import "ldbc.friend"          : (int, (int, int));    -- (person, (friend, since))

-- Each request's residents, keyed by person, carrying the request and its window:
-- country name -> country -> its cities -> the people living there.
let residents = request | map(((rid, country, start, end), ()) -> (country, (rid, start, end)))
                        | join(place_by_name,   (_, req, country) -> (country, req))
                        | join(place_by_parent, (_, req, city)    -> (city, req))
                        | join(person_by_city,  (_, req, who)     -> (who, req));

-- Each request's friendships among its residents, made inside the window.
let member = residents | map((who, (rid, _, _)) -> ((rid, who), ()));
let inside = residents | join(friend, (a, (rid, start, end), (b, t)) -> ((rid, a, b, t, start, end), ()))
                       | filter(((_, _, _, t, start, end), ()) -> ((t, start) ge, (t, end) le) all)
                       | map(((rid, a, b, _, _, _), ()) -> ((rid, b), a))
                       | join(member, ((rid, b), a, ()) -> ((rid, a, b), ()));

-- Triangles a < b < c: each friendship oriented a < b, so the path a-b-c is built
-- only in increasing order, and closed by the friendship a-c.
let oriented  = inside | filter(((_, a, b), ()) -> (a, b) lt);
let by_first  = oriented | map(((rid, a, b), ()) -> ((rid, a), b));
let by_second = oriented | map(((rid, a, b), ()) -> ((rid, b), a));
let triangles = by_second | join(by_first, ((rid, b), a, c) -> ((rid, a, c), b))
                          | join(oriented, ((rid, _, _), _, ()) -> (rid, ()));

-- One row per request, zero when there are no triangles.
let counted = triangles | count;
let none    = request | map(((rid, _, _, _), ()) -> (rid, ()));
let zero    = none - (none | join(counted, (rid, (), _) -> (rid, ())));
let answer  = (counted | map((rid, n) -> ((rid, 0), (n)))) + (zero | map((rid, ()) -> ((rid, 0), (0))));

export "bi11.answer" = answer | arrange;
