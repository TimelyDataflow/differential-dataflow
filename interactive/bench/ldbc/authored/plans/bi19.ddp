-- BI19. The cheapest interaction-weighted paths from anyone in city 1 to anyone in
-- city 2: every (person1, person2) pair at the least cost, ordered by the pair.

let request = input 0 : ((int, int, int), ());               -- (rid, city 1, city 2)
let person  = import "ldbc.person"  : (int, (List(int), List(int), List(int), int, int, List(int), List(int), int, int, int, int));
let message = import "ldbc.message" : (int, (int, int, int, int, List(int), List(int), int, List(int), int, int, int, int, int));
let pals    = import "ldbc.friend.pair" : ((int, int), ());        -- ((person, friend), ())
let person_by_city = import "ldbc.person.by_city" : (int, int);     -- (city, person)

-- Interaction weights between friends: replies in either direction are counted per
-- pair (n), and a friendship costs max(round(40 - sqrt(n)), 1), computed exactly as
-- 1 + the number of k in 1..39 with k(k-1) + 1 > n.
let answered = message | filter((_, (kind, _, _, _, _, _, _, _, _, _, _, _, _)) -> (kind, 1) eq)
                       | map((_, (_, _, who, _, _, _, _, _, _, parent, _, _, _)) -> (parent, who))
                       | join(message, (_, who, (_, _, to, _, _, _, _, _, _, _, _, _, _)) -> (who, to))
                       | filter((who, to) -> (who, to) ne);
let talks    = (answered | map((a, b) -> ((a, b), ()))) + (answered | map((a, b) -> ((b, a), ())));
let weighted = talks | count
                     | join(pals, (pair, n, ()) -> (pair, n))
                     | map(((a, b), n) -> (a, (b, (((0, n), (1, 40) range) fold (((acc, n), k) ->
                           ((acc, ((((k, (k, 1) sub) mul, 1) add, n) gt, 1, 0) select) add, n)) .0, 1) add)));

-- One search per (request, source in city 1).
let starts = request | map(((rid, c1, _), ()) -> (c1, rid))
                     | join(person_by_city, (_, rid, who) -> ((rid, who, who, 0), ()));
search: {
    let grow   = search | map(((rid, source, node, cost), ()) -> (node, (rid, source, cost)))
                        | join(weighted, (_, (rid, source, cost), (next, w)) -> ((rid, source, next, (cost, w) add), ()));
    set search = (starts + grow) | map(((rid, source, node, cost), ()) -> ((rid, source, node), cost)) | min
                                 | map(((rid, source, node), cost) -> ((rid, source, node, cost), ()));
}

-- Paths that end in city 2, and the least cost among them.
let ends   = search::search | map(((rid, source, node, cost), ()) -> (node, (rid, source, cost)))
                            | join(person, (node, (rid, source, cost), (_, _, _, _, _, _, _, city, _, _, _)) -> ((rid, city), (source, node, cost)))
                            | join(request | map(((rid, _, c2), ()) -> ((rid, c2), ())), ((rid, _), row, ()) -> (rid, row));
let best   = ends | map((rid, (_, _, cost)) -> (rid, cost)) | min;
let ranked = ends | join(best, (rid, (source, node, cost), least) -> (rid, (source, node, cost, least)))
                  | filter((_, (_, _, cost, least)) -> (cost, least) eq)
                  | map((rid, (source, node, cost, _)) -> (rid, ((source, node), cost)))
                  | collect | flatmap((_, entries) -> entries);
let answer = ranked | map((rid, (rank, ((source, node), cost))) -> ((rid, rank), (source, node, cost)));

export "bi19.answer" = answer | arrange;
