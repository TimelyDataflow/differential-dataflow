-- Shortest paths with delta stepping.
--
-- Plain relaxation keeps improving long distances that a shorter path later replaces. Here
-- `delay` puts a distance d at round (d / 64) * 16, so nearer buckets settle first, with room
-- for each bucket's hops. Choose the width near a typical weight and the spacing above the hops
-- a bucket needs. On a 500 x 500 grid with weights 1 to 100 this took 64.5 s to 0.9 s.

let edges = input "edges" : (int, (int, int));   -- (src, (dst, weight))
let roots = input "roots" : (int, ());           -- the sources, at distance 0

sssp: {
    let proposals = dist
        | join(edges, (_, (d, (dst, w))) -> (dst, (d, w) add))
        | delay((_, d) -> (0, ((d, 64) div, 16) mul));
    set dist = (roots | map((n, ()) -> (n, 0))) + proposals | min;
}

output "dist" = sssp::dist;
