-- Backward field demand over a program's scope graph. Rust supplies one fact id
-- for each key/value field and each collection's presence. The dependencies
-- include operator-local rules and lambda reads; this DDIR program computes
-- their least fixed point through scopes and feedback variables.

let seeds = input 0 : (int ; ());
let dependencies = input 1 : ((int, int) ; ())
                 | map(((consumer, producer), ()) -> (consumer, producer));

demand: {
    let reached = live | join(dependencies, (_, (), producer) -> (producer, ()));
    var live = seeds + reached | distinct;
}

export "live" = demand::live;
