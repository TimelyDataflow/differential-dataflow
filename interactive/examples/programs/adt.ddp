-- Named constructors (`inject`) + `match`. Each edge is tagged by orientation,
-- carrying the field-sum as payload, then matched back out to a (bucket, sum)
-- and counted per bucket. (Contrived — exercises sum intro/outro + fold.)

type Dir = Fwd int   -- src < dst
         | Bwd int;  -- otherwise

let edges = input 0 : ((int, int), ()) | map(((a, b), ()) -> (a, b));

let tagged = edges
    | map((a, b) ->
           let fwd = (a, b) lt in
           let sum = (0, (a enlist, b enlist) append) fold ((acc, x) -> (acc, x) add) in
           ( (fwd, 0, 1) select
           , (fwd, sum inject Fwd, sum inject Bwd) select match (Fwd (s -> s), Bwd (s -> s))
           ));

let buckets = tagged | count;

export "result" = buckets | arrange | inspect(adt);
