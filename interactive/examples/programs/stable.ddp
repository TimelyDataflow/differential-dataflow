-- Stable Matching (Gale-Shapley) — pipe syntax
-- input 0: edges (l_node, l_pref, r_node, r_pref ;)

let edges = input 0 : ((int, int, int, int) ; ()) | key(((a, b, c, d), ()) -> ((a), (b, c, d)));

matching: {
    let active = edges + removals;
    let props = active | min;
    let by_b = props | key(((l), (lp, r, rp)) -> ((r), (rp, l, lp)));
    let accpt = by_b | min;
    let by_a = accpt | key(((r), (rp, l, lp)) -> ((l), (lp, r, rp)));
    var removals = removals + by_a - props | arrange;
}

export "result" = matching::props | key(_ -> ((), ())) | arrange | inspect(total);
