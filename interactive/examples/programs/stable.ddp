-- Stable Matching (Gale-Shapley) — pipe syntax
-- input 0: edges (l_node, l_pref, r_node, r_pref ;)

let edges = input 0 : ((int, int, int, int) ; ()) | map(((a, b, c, d), ()) -> (a, (b, c, d)));

matching: {
    let active = edges + removals;
    let props = active | min;
    let by_b = props | map((l, (lp, r, rp)) -> (r, (rp, l, lp)));
    let accpt = by_b | min;
    let by_a = accpt | map((r, (rp, l, lp)) -> (l, (lp, r, rp)));
    var removals = removals + by_a - props | arrange;
}

export "result" = matching::props | map(_ -> ((), ())) | arrange | inspect(total);
