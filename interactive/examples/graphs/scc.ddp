-- Strongly connected components: the edges whose two ends lie in one component.
--
-- Each outer round keeps the edges whose ends get the same least label, propagated forward
-- along the edges and then backward, and repeats until no edge goes. As in `components.ddp`,
-- `delay` holds back large labels so small ones spread first; here the time has an outer and an inner round.

let edges = input "edges" : (int, int);   -- (src, dst)
let trans = edges | map((src, dst) -> (dst, src));

outer: {
    let scc = edges + trim;

    fwd: {
        let nodes = edges | map((_, dst) -> (dst, dst)) | delay((_, n) -> (0, 0, (256, n call bit_length) mul));
        let labels = proposals + nodes | min;
        set proposals = labels | join(scc, (_, (label, dst)) -> (dst, label));
    }

    let trim_fwd = edges
        | join(fwd::labels, (src, (dst, label)) -> (dst, (src, label)))
        | join(fwd::labels, (dst, ((src, label), other)) -> (dst, (src, label, other)))
        | filter((_, (_, a, b)) -> (a, b) eq)
        | map((dst, (src, _, _)) -> (dst, src));

    bwd: {
        let nodes = trans | map((_, dst) -> (dst, dst)) | delay((_, n) -> (0, 0, (256, n call bit_length) mul));
        let labels = proposals + nodes | min;
        set proposals = labels | join(trim_fwd, (_, (label, dst)) -> (dst, label));
    }

    let trim_bwd = trans
        | join(bwd::labels, (src, (dst, label)) -> (dst, (src, label)))
        | join(bwd::labels, (dst, ((src, label), other)) -> (dst, (src, label, other)))
        | filter((_, (_, a, b)) -> (a, b) eq)
        | map((dst, (src, _, _)) -> (dst, src));

    set trim = trim_bwd - edges;
}

output "within" = outer::scc;
