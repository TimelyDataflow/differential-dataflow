-- The program the tour installs: rows of a declared sum type, and a count of them by variant.

enum Shape = Circle int | Rect (int, int);   -- a radius, or a width and a height

let shapes = input "shapes" : (int, Shape);   -- (id, shape)

output "shapes" = shapes;
output "kinds" = shapes | map((_, s) -> (s match (Circle (_ -> 0), Rect (_ -> 1)), ())) | count;
