-- Single-source shortest paths with delta stepping.
--
-- Plain relaxation in a loop finds every path, but on weighted graphs it keeps improving long
-- tentative distances that a shorter path later replaces. Delta stepping settles distances in
-- buckets of width Δ, nearest first. Here `delay` puts a proposed distance d at round
-- (d / 64) * 16: bucket d / 64, spaced 16 rounds apart, so a bucket's hop-by-hop relaxations
-- finish before the next bucket starts. With the spacing at 1 a bucket's relaxations run into
-- the next bucket's and the delay gains nothing.
-- On a 500 x 500 grid with weights 1 to 100 this took the first computation from 64.5 s to 0.9 s.
-- Choose Δ near the typical edge weight, and the spacing above the hops a bucket needs.

let edges = input 0 : (int, (int, int));   -- (src, (dst, weight))
let roots = input 1 : (int, ());           -- the sources, at distance 0

sssp: {
    let proposals = dist
        | join(edges, (_, (d, (dst, w))) -> (dst, (d, w) add))
        | delay((_, d) -> (0, ((d, 64) div, 16) mul));
    set dist = (roots | map((n, ()) -> (n, 0))) + proposals | min;
}

output "dist" = sssp::dist;
