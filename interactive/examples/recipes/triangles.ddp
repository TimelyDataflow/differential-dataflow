-- Triangle counting as a delta join: no collection of wedges is ever built.
--
-- Triangles are T(a, b, c) :- E(a, b), E(a, c), E(b, c), with each edge pointed from its larger
-- end to its smaller, and b > c. The plain plan joins E with itself into every wedge (a path of
-- two edges) and arranges them all: 60.8M wedges for a 1M-edge graph. A delta join instead
-- handles each change to E once per use of E in the rule, and joins that change against the
-- other two uses with `half_join`, which reads the arranged edges as of the change's time.
-- For the use numbered i, a change meets later uses at or before its time (strict 0) and earlier
-- uses strictly before it (strict 1), so a change that touches two uses counts once.
-- On the 1M-edge graph a single edge update went from 2.86 ms to 0.25 ms.

let raw = input 0 : (int, int);   -- an undirected edge, either way round
let down = raw
    | filter((a, b) -> (a, b) ne)
    | map((a, b) -> ((((a, b) gt, a, b) select, ((a, b) gt, b, a) select), ()))
    | distinct;
let out = down | map(((a, b), ()) -> (a, b));    -- keyed by the larger end
let rev = down | map(((a, b), ()) -> (b, a));    -- keyed by the smaller end
let pairs = down | arrange;                      -- keyed by the whole edge

-- A change to E(a, b): find E(a, c), then check E(b, c).
let p1 = out | lift
    | half_join(out, 0, (a, ((b, c), t)) -> ((b, c), (a, t)))
    | filter(((b, c), _) -> (b, c) gt)
    | half_join(pairs, 0, ((b, c), ((a, ()), t)) -> (a, ((b, c), t)));
-- A change to E(a, c): find E(a, b) strictly earlier, then check E(b, c).
let p2 = out | lift
    | half_join(out, 1, (a, ((c, b), t)) -> ((b, c), (a, t)))
    | filter(((b, c), _) -> (b, c) gt)
    | half_join(pairs, 0, ((b, c), ((a, ()), t)) -> (a, ((b, c), t)));
-- A change to E(b, c): find E(a, b) and then E(a, c), both strictly earlier.
let p3 = down | map(((b, c), ()) -> (b, c)) | lift
    | half_join(rev, 1, (b, ((c, a), t)) -> ((a, c), (b, t)))
    | half_join(pairs, 1, ((a, c), ((b, ()), t)) -> (a, ((b, c), t)));

-- Each found triangle carries the time of the change that found it; `delay` puts it there.
let triangles = (p1 + p2 + p3) | delay((_, (_, t)) -> t) | map((a, (bc, _)) -> (a, bc));

output "triangles" = triangles;
output "total" = triangles | map(_ -> ((), ())) | count;
