-- Reachability over an edge set read from another installed program.
-- input `edges` : ((int), (int)), (src, dst): bound at load to another program's output, as in
--   `load reach from examples/server/programs/reach_import.ddp edges=prod::edges`
--   for `producer.ddp` installed as `prod`.
-- input `roots` : ((int), ()): the nodes to start from, fed.

let edges = input "edges" : ((int), (int));
let roots = input "roots" : ((int), ());

reach: {
    let proposals = reach | join(edges, (_, _, dst) -> (dst, ()));
    set reach = roots + proposals | distinct;
}

output "result" = reach::reach | inspect(reach);
