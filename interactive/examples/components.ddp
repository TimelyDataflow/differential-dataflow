-- Connected components by label propagation, with prioritized iteration.
--
-- Each node takes the least label among its neighbors. Small labels win, so `delay` holds node
-- n's own label back to round 256 * bit_length(n), letting small labels spread before large ones
-- start work that would be undone. On a 1M-edge graph this took 1.39 s to 0.55 s; some later
-- edits got slower (a bridge in a 300-node path: 37 ms to 3.4 s).

let raw = input "edges" : (int, int);   -- an undirected edge, either way round
let edges = raw + (raw | map((a, b) -> (b, a))) | distinct;
let nodes = edges | map((a, _) -> (a, ())) | distinct;

cc: {
    -- The inner time is (epoch, round): `0` leaves the epoch alone and sets the round.
    let seeds = nodes | map((n, _) -> (n, n)) | delay((_, n) -> (0, (256, n call bit_length) mul));
    let proposals = labels | join(edges, (_, (label, dst)) -> (dst, label));
    set labels = seeds + proposals | min;
}

output "labels" = cc::labels;
