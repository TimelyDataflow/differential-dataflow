-- AoC 2023 day 16 part 1: beam bouncing; count energized cells.
-- dirs: r=0 l=1 u=2 d=3; '.'=46 '-'=45 '|'=124 '/'=47 '\'=92
-- input 0: (row, col, code) 1-indexed

let cells = input 0 | key($0[0], $0[1] ; $0[2]);

let shift = cells | key(;) | distinct | flatmap(list(
    tuple(0,46,0,1,0),  tuple(0,45,0,1,0),  tuple(0,124,1,0,3), tuple(0,124,-1,0,2),
    tuple(0,47,-1,0,2), tuple(0,92,1,0,3),
    tuple(1,46,0,-1,1), tuple(1,45,0,-1,1), tuple(1,124,1,0,3), tuple(1,124,-1,0,2),
    tuple(1,47,1,0,3),  tuple(1,92,-1,0,2),
    tuple(2,46,-1,0,2), tuple(2,45,0,1,0),  tuple(2,45,0,-1,1), tuple(2,124,-1,0,2),
    tuple(2,47,0,1,0),  tuple(2,92,0,-1,1),
    tuple(3,46,1,0,3),  tuple(3,45,0,1,0),  tuple(3,45,0,-1,1), tuple(3,124,1,0,3),
    tuple(3,47,0,-1,1), tuple(3,92,0,1,0)))
    | key($1[1][0], $1[1][1] ; $1[1][2], $1[1][3], $1[1][4]);
-- (dir, sym ; dr, dc, newdir)

beam: {
    let onsym = l | map($0[0], $0[1] ; $0[2]) | join(cells, ($1[0], $2[0] ; $0[0], $0[1]));
    -- (dir, sym ; r, c)
    let next = onsym | join(shift, ($1[0] + $2[0], $1[1] + $2[1], $2[2] ;));
    var l = (cells | filter($0[0] == 1 && $0[1] == 1) | map(1, 1, 0 ;)) + next | distinct;
}

export "result" = beam::l | map($0[0], $0[1] ;)
    | join(cells, ($0 ;)) | distinct
    | key(;) | count | arrange | inspect(part1);
