-- AoC 2023 day 16 part 1: beam bouncing; count energized cells.
-- dirs: r=0 l=1 u=2 d=3; '.'=46 '-'=45 '|'=124 '/'=47 '\'=92
-- input 0: (row, col, code) 1-indexed

let cells = input 0 : ((int, int, int), ()) | map(((r, c, code), ()) -> ((r, c), code));

let shift = cells | map(_ -> ((), ())) | distinct | flatmap(_ -> [
      (0, 46, 0, 1, 0), (0, 45, 0, 1, 0), (0, 124, 1, 0, 3), (0, 124, -1, 0, 2),
      (0, 47, -1, 0, 2), (0, 92, 1, 0, 3), (1, 46, 0, -1, 1), (1, 45, 0, -1, 1),
      (1, 124, 1, 0, 3), (1, 124, -1, 0, 2), (1, 47, 1, 0, 3), (1, 92, -1, 0, 2),
      (2, 46, -1, 0, 2), (2, 45, 0, 1, 0), (2, 45, 0, -1, 1), (2, 124, -1, 0, 2),
      (2, 47, 0, 1, 0), (2, 92, 0, -1, 1), (3, 46, 1, 0, 3), (3, 45, 0, 1, 0),
      (3, 45, 0, -1, 1), (3, 124, 1, 0, 3), (3, 47, 0, -1, 1), (3, 92, 0, 1, 0) ])
    | map((_, (_, (d, s, dr, dc, nd))) -> ((d, s), (dr, dc, nd)));
-- ((dir, sym), (dr, dc, newdir))

beam: {
    let onsym = l | map(((r, c, d), _) -> ((r, c), d)) | join(cells, (rc, d, s) -> ((d, s), rc));
    -- ((dir, sym), (r, c))
    let next = onsym | join(shift, (_, (r, c), (dr, dc, nd)) -> (((r, dr) add, (c, dc) add, nd), ()));
    var l = (cells | filter(((r, c), _) -> ((r, 1) eq, (c, 1) eq) all) | map(_ -> ((1, 1, 0), ()))) + next | distinct;
}

export "result" = beam::l | map(((r, c, _), _) -> ((r, c), ()))
    | join(cells, (rc, _, _) -> (rc, ())) | distinct
    | map(_ -> ((), ())) | count | arrange | inspect(part1);
