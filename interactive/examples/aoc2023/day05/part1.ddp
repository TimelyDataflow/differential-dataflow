-- AoC 2023 day 5 part 1: chain each seed through 7 remapping stages; min.
-- input 0: seeds (seed)
-- input 1: map entries (stage, dst, src, len)

let seeds   = input 0 : ((int) ; ()) | map(((seed), _) -> ((0, seed), ()));
let entries = input 1 : ((int, int, int, int) ; ()) | map(((stage, dst, src, len), _) -> (stage, (dst, src, len)));
-- (stage ; dst, src, len)

chain: {
    let cur = active | filter(((stage, _), _) -> (stage, 6) le);
    let cands = cur | map(((stage, idx), _) -> (stage, idx))
        | join(entries, (stage, idx, (dst, src, len)) -> ((stage, idx, dst, src, len), ()))
        | filter(((_, idx, _, src, len), _) -> ((src, idx) le, (idx, (src, len) add) lt) all);
    -- key (stage, idx, dst, src, len)
    let mapped  = cands | map(((stage, idx, dst, src, _), _) -> (((stage, 1) add, ((idx, dst) add, src) sub), ()));
    let covered = cands | map(((stage, idx, _, _, _), _) -> ((stage, idx), ())) | distinct;
    let unmapped = (cur - covered) | map(((stage, idx), _) -> (((stage, 1) add, idx), ()));
    var active = seeds + mapped + unmapped | distinct;
}

export "result" = chain::active | filter(((stage, _), _) -> (stage, 7) eq)
    | map(((_, idx), _) -> ((), idx)) | min | arrange | inspect(part1);
