-- AoC 2023 day 19 part 1: run each part through the workflows; first
-- matching rule (min priority) decides; sum x+m+a+s of accepted.
-- input 0: rules (state, prio, field, cmp, val, next)
-- input 1: parts (x, m, a, s)

let rulesbys = input 0 : ((int, int, int, int, int, int) ; ()) | key(((st, prio, f, cmp, v, nx), ()) -> (st, (prio, f, cmp, v, nx)));
-- (state ; prio, field, cmp, val, next)
let parts = input 1 : ((int, int, int, int) ; ()) | key(((x, m, a, s), ()) -> ((0, x, m, a, s), ()));

move: {
    let mtch = mv | map(((st, x, m, a, s), ()) -> (st, (x, m, a, s)))
        | join(rulesbys, (st, (x, m, a, s), (prio, f, cmp, v, nx)) ->
            let sel = ((f, 0) eq, x, ((f, 1) eq, m, ((f, 2) eq, a, s) select) select) select in
            ((st, x, m, a, s), (((cmp, 0) eq, (sel, v) lt, (sel, v) gt) select, prio, nx)))
        | filter((_, (hit, _, _)) -> (hit, 1) eq) | map((k, (_, prio, nx)) -> (k, (prio, nx)))
        | min;
    -- (state,x,m,a,s ; first prio, next)
    let moved = mtch | map(((_, x, m, a, s), (_, nx)) -> ((nx, x, m, a, s), ()));
    var mv = parts + moved | distinct;
}

export "result" = move::mv | filter(((st, _, _, _, _), _) -> (st, -1) eq)
    | key(((_, x, m, a, s), _) -> ((), (((x, m) add, a) add, s) add))
    | collect | map((_, vs) -> ((), vs fold_add))
    | arrange | inspect(part1);
