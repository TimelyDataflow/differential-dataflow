-- AoC 2023 day 19 part 2: hypercube regions through the workflow tree.
-- Faithful to the slt: no emptiness clamping, so impossible regions
-- contribute negative products (their oracle answer is negative too).
-- input 0: rules (state, prio, field, cmp, val, next)

let rules = input 0 : ((int, int, int, int, int, int), ()) | map(((st, prio, f, cmp, v, nx), ()) -> ((st, prio), (f, cmp, v, nx)));
-- ((state, prio), (field, cmp, val, next))

flow: {
    let cur = reg | map(((st, prio, xl, xh, ml, mh, al, ah, sl, sh), ()) -> ((st, prio), (xl, xh, ml, mh, al, ah, sl, sh)));
    let b1 = cur | join(rules, (_, (xl, xh, ml, mh, al, ah, sl, sh), (f, cmp, v, nx)) ->
          let isgt = (cmp, 1) eq in
          let islt = (cmp, 0) eq in
          let up = (v, 1) add in
          let dn = (v, 1) sub in
          ((nx, 1,
            (((f, 0) eq, isgt) all, (up, xl) max, xl) select,
            (((f, 0) eq, islt) all, (dn, xh) min, xh) select,
            (((f, 1) eq, isgt) all, (up, ml) max, ml) select,
            (((f, 1) eq, islt) all, (dn, mh) min, mh) select,
            (((f, 2) eq, isgt) all, (up, al) max, al) select,
            (((f, 2) eq, islt) all, (dn, ah) min, ah) select,
            (((f, 3) eq, isgt) all, (up, sl) max, sl) select,
            (((f, 3) eq, islt) all, (dn, sh) min, sh) select), ()));
    let b2 = cur | join(rules, ((st, prio), (xl, xh, ml, mh, al, ah, sl, sh), (f, cmp, v, _)) ->
          let isgt = (cmp, 1) eq in
          let islt = (cmp, 0) eq in
          ((st, (prio, 1) add,
            (((f, 0) eq, islt) all, (v, xl) max, xl) select,
            (((f, 0) eq, isgt) all, (v, xh) min, xh) select,
            (((f, 1) eq, islt) all, (v, ml) max, ml) select,
            (((f, 1) eq, isgt) all, (v, mh) min, mh) select,
            (((f, 2) eq, islt) all, (v, al) max, al) select,
            (((f, 2) eq, isgt) all, (v, ah) min, ah) select,
            (((f, 3) eq, islt) all, (v, sl) max, sl) select,
            (((f, 3) eq, isgt) all, (v, sh) min, sh) select), ()));
    set reg = (rules | map(_ -> ((), ())) | distinct | map(_ -> ((0, 1, 1, 4000, 1, 4000, 1, 4000, 1, 4000), ())))
        + b1 + b2 | arrange;
}

export "result" = flow::reg | filter(((st, _, _, _, _, _, _, _, _, _), _) -> (st, -1) eq)
    | map(((_, _, xl, xh, ml, mh, al, ah, sl, sh), _) ->
        let wx = ((1, xh) add, xl) sub in
        let wm = ((1, mh) add, ml) sub in
        let wa = ((1, ah) add, al) sub in
        let ws = ((1, sh) add, sl) sub in
        ((), (((wx, wm) mul, wa) mul, ws) mul))
    | collect | map((_, vs) -> ((), vs fold_add))
    | arrange | inspect(part2);
