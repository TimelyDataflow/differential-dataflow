-- AoC 2023 day 22 part 1: bricks fall (interval overlap + max-rest fixpoint);
-- count bricks that uniquely support nothing.
-- input 0: (r, x1,y1,z1, x2,y2,z2)

-- slt's generate_series drops bricks with ANY reversed axis; mirror that.
let lines = input 0 : ((int, int, int, int, int, int, int), ());
let bricks = lines | filter(((_, x1, y1, z1, x2, y2, z2), _) -> ((x1, x2) le, (y1, y2) le, (z1, z2) le) all)
    | map(((r, x1, y1, z1, x2, y2, z2), ()) -> (r, (x1, y1, z1, x2, y2, z2)));
-- (r, (xlo, ylo, zlo, xhi, yhi, zhi))

let bu = bricks | map((r, (xl, yl, zl, xh, yh, zh)) -> ((), (r, xl, yl, zl, xh, yh, zh)));
let ovl = bu | join(bu, (_, (r1, xl1, yl1, zl1, xh1, yh1, zh1), (r2, xl2, yl2, zl2, xh2, yh2, zh2)) ->
        ((r1, r2), (
            (((xl1, xl2) max, (xh1, xh2) min) le,
             ((yl1, yl2) max, (yh1, yh2) min) le,
             (zl1, zl2) lt) all,
            ((zh1, zl1) sub, 1) add)))
    | filter((_, (hit, _)) -> (hit, 1) eq) | map(((lo, up), (_, h)) -> (lo, (up, h)));
-- (lower, (upper, height_lower)) for xy-overlapping pairs

-- resting z per brick, stored negated (mz = BIG - z) so `min` computes max
rests: {
    let lifted = rest | join(ovl, (_, mz, (up, h)) -> (up, (mz, h) sub));
    var rest = (bricks | map((r, _) -> (r, 999999))) + lifted | min;
}
let rest = rests::rest;
-- (r, BIG - resting z), BIG = 1000000

-- direct supports: rest_top(lower) + 1 == rest_z(upper)
let s1 = ovl | join(rest, (lo, (up, h), mz) -> (up, (lo, (mz, h) sub)));
-- (upper, (lower, required mz_upper))
let sup = s1 | join(rest, (up, (lo, req), mz) -> ((lo, up, (req, mz) eq), ()))
    | filter(((_, _, hit), _) -> (hit, 1) eq) | map(((lo, up, _), _) -> ((lo, up), ()));
-- (lower, upper)

let uniq2 = sup | map(((_, up), _) -> (up, ())) | count | filter((_, n) -> (n, 1) eq) | map((k, _) -> (k, ()));

let critical = sup | map(((lo, up), _) -> (up, lo)) | join(uniq2, (_, lo, ()) -> (lo, ())) | distinct;
let total = lines | map(_ -> ((), ())) | count;   -- ALL lines, per the slt
export "result" = total | join(critical | map(_ -> ((), ())) | count, (_, a, b) -> ((), (a, b) sub))
    | arrange | inspect(part1);
