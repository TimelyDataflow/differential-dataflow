-- AoC 2023 day 13 part 1: mirror axes. Axis before row a is valid when no
-- row pair (x, 2a-1-x) has differing lines. Lines/columns compared as
-- collected list values (structural ==). Sum 100*(a-1) + (c-1).
-- input 0: (block, row, col, code), 1-indexed

let cells = input 0 : ((int, int, int, int) ; ()) | key(((b, r, c, s), ()) -> ((b, r, c), s));

let rlines = cells | map(((b, r, c), s) -> ((b, r), (c, s))) | collect;
-- (b, r ; [(c, code)...])
let clines = cells | map(((b, r, c), s) -> ((b, c), (r, s))) | collect;
-- (b, c ; [(r, code)...])

-- row axes ------------------------------------------------------------
let rcand = cells | map(((b, r, _), _) -> ((b, r), ())) | distinct;   -- (b, a)
let rlk = rlines | map(((b, x), l) -> (b, (x, l)));  -- (b ; x, L)
let t1 = rcand | map(((b, a), _) -> (b, a)) | join(rlk, (b, a, (x, l)) -> ((b, a, x), l));
-- (b, a, x ; Lx)
let t2 = t1 | map(((b, a, x), l) -> ((b, (((2, a) mul, 1) sub, x) sub), (a, x, l)));
-- (b, y ; a, x, Lx)
let rviol = t2 | join(rlines, ((b, y), (a, x, lx), ly) -> ((b, a), ((x, y) lt, ((lx, ly) eq, 0) eq) all))
    | filter((_, m) -> (m, 1) eq) | map((k, _) -> (k, ())) | distinct;
-- (b, a) with a mismatched pair
let rvalid = rcand - rviol;
let rscore = rvalid | key(((_, a), _) -> ((), (100, (a, 1) sub) mul));

-- column axes ---------------------------------------------------------
let ccand = cells | map(((b, _, c), _) -> ((b, c), ())) | distinct;
let clk = clines | map(((b, x), l) -> (b, (x, l)));
let s1 = ccand | map(((b, a), _) -> (b, a)) | join(clk, (b, a, (x, l)) -> ((b, a, x), l));
let s2 = s1 | map(((b, a, x), l) -> ((b, (((2, a) mul, 1) sub, x) sub), (a, x, l)));
let cviol = s2 | join(clines, ((b, y), (a, x, lx), ly) -> ((b, a), ((x, y) lt, ((lx, ly) eq, 0) eq) all))
    | filter((_, m) -> (m, 1) eq) | map((k, _) -> (k, ())) | distinct;
let cvalid = ccand - cviol;
let cscore = cvalid | key(((_, a), _) -> ((), (a, 1) sub));

export "result" = rscore + cscore
    | collect | map((_, xs) -> ((), xs fold_add))
    | arrange | inspect(part1);
