-- AoC 2023 day 13 part 2: axes with EXACTLY ONE mismatched mirrored cell
-- pair. Sum 100*(a-1) for rows + (c-1) for cols.
-- input 0: (block, row, col, code), 1-indexed

let cells = input 0 : ((int, int, int, int) ; ()) | map(((b, r, c, s), ()) -> ((b, r, c), s));
let cb = cells | map(((b, r, c), s) -> (b, (r, c, s)));      -- (b ; r, c, s)

-- row axes
let rcand = cells | map(((b, r, _), _) -> ((b, r), ())) | distinct;
let u1 = rcand | map(((b, a), _) -> (b, a))
    | join(cb, (b, a, (x, c, s)) -> ((b, (((2, a) mul, 1) sub, x) sub, c), (a, x, s)));
-- (b, y, c ; a, x, s)
let rmis = u1 | join(cells, ((b, y, _), (a, x, s), s2) -> ((b, a), ((x, y) lt, ((s, s2) eq, 0) eq) all))
    | filter((_, m) -> (m, 1) eq) | map((k, _) -> (k, ())) | count | filter((_, n) -> (n, 1) eq);
-- (b, a ; 1): exactly one smudge
let rscore = rmis | map(((_, a), _) -> ((), (100, (a, 1) sub) mul));

-- column axes
let ccand = cells | map(((b, _, c), _) -> ((b, c), ())) | distinct;
let v1 = ccand | map(((b, a), _) -> (b, a))
    | join(cb, (b, a, (r, x, s)) -> ((b, r, (((2, a) mul, 1) sub, x) sub), (a, x, s)));
-- (b, r, y ; a, x, s)
let cmis = v1 | join(cells, ((b, _, y), (a, x, s), s2) -> ((b, a), ((x, y) lt, ((s, s2) eq, 0) eq) all))
    | filter((_, m) -> (m, 1) eq) | map((k, _) -> (k, ())) | count | filter((_, n) -> (n, 1) eq);
let cscore = cmis | map(((_, a), _) -> ((), (a, 1) sub));

export "result" = rscore + cscore
    | collect | map((_, xs) -> ((), xs fold_add))
    | arrange | inspect(part2);
