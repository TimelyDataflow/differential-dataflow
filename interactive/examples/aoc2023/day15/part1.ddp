-- AoC 2023 day 15 part 1: HASH each command; sum. h = ((h+c)*17) % 256.
-- No % operator: modulo done relationally (cross join a k-table, keep the
-- residue in [0,256)).
-- input 0: (r, pos, code), 1-indexed

let chars = input 0 : ((int, int, int) ; ()) | key(((r, pos, code), ()) -> ((r, pos), (code)));
let lens = chars | map(((r, _), _) -> ((r), ())) | count;   -- (r ; len)

let ktab = chars | key(_ -> ((), ())) | distinct
    | flatmap(_ -> (0, 34) range)
    | key((_, (_, k)) -> ((), (k)));
-- (; k)

hash: {
    let t = st | map(((r, i, h), _) -> ((r, (i, 1) add), (h)))
        | join(chars, ((r, i), (h), (c)) -> ((), (r, i, ((h, c) add, 17) mul)));
    -- (; r, i, t)
    let next = t | join(ktab, (_, (r, i, t), (k)) -> ((r, i, (t, (256, k) mul) sub), ()))
        | filter(((_, _, t), _) -> ((t, 0) ge, (t, 256) lt) all);
    var st = (lens | map(((r), _) -> ((r, 0, 0), ()))) + next | distinct;
}

export "result" = hash::st | map(((r, i, h), _) -> ((r), (i, h)))
    | join(lens, ((r), (i, h), (n)) -> ((r), (i, h, n))) | filter((_, (i, _, n)) -> (i, n) eq)
    | key((_, (_, h, _)) -> ((), (h))) | collect | map((_, ps) -> ((), (ps map (p -> p.0) fold_add)))
    | arrange | inspect(part1);
