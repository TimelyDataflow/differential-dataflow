-- AoC 2023 day 7 part 1: rank hands (type, then card order); sum rank*bid.
-- Type from the pairwise-equality count: 5oak=10 4oak=6 FH=4 3oak=3 2p=2 p=1 hi=0.
-- input 0: (id, c1..c5, bid) charcodes

let hands = input 0 | key(;
    $0[0],
    ($0[1]==$0[2]) + ($0[1]==$0[3]) + ($0[1]==$0[4]) + ($0[1]==$0[5])
  + ($0[2]==$0[3]) + ($0[2]==$0[4]) + ($0[2]==$0[5])
  + ($0[3]==$0[4]) + ($0[3]==$0[5])
  + ($0[4]==$0[5]),
    if($0[1] < 58, $0[1] - 48, if($0[1] == 84, 10, if($0[1] == 74, 11, if($0[1] == 81, 12, if($0[1] == 75, 13, 14))))),
    if($0[2] < 58, $0[2] - 48, if($0[2] == 84, 10, if($0[2] == 74, 11, if($0[2] == 81, 12, if($0[2] == 75, 13, 14))))),
    if($0[3] < 58, $0[3] - 48, if($0[3] == 84, 10, if($0[3] == 74, 11, if($0[3] == 81, 12, if($0[3] == 75, 13, 14))))),
    if($0[4] < 58, $0[4] - 48, if($0[4] == 84, 10, if($0[4] == 74, 11, if($0[4] == 81, 12, if($0[4] == 75, 13, 14))))),
    if($0[5] < 58, $0[5] - 48, if($0[5] == 84, 10, if($0[5] == 74, 11, if($0[5] == 81, 12, if($0[5] == 75, 13, 14))))),
    $0[6]);
-- (; id, t, v1..v5, bid)

let less = hands | join(hands, (
    if($1[1] < $2[1], 1, if($1[1] > $2[1], 0,
    if($1[2] < $2[2], 1, if($1[2] > $2[2], 0,
    if($1[3] < $2[3], 1, if($1[3] > $2[3], 0,
    if($1[4] < $2[4], 1, if($1[4] > $2[4], 0,
    if($1[5] < $2[5], 1, if($1[5] > $2[5], 0,
    if($1[6] < $2[6], 1, 0))))))))))),
    $2[0] ;));
-- key (left_is_less, right_id)

let ranks = less | filter($0[0] == 1) | map($0[1] ;) | count;
-- (id ; #smaller)

let bids = hands | map($1[0] ; $1[7]);

-- ranks misses the weakest hand (zero smaller); add every bid once instead.
let above = ranks | join(bids, ($0 ; $1[0] * $2[0]));

export "result" = above + bids
    | key(; $1[0]) | collect
    | map(; fold($1, 0, ^1 + ^0[0]))
    | arrange | inspect(part1);
