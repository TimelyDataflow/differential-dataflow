-- AoC 2023 day 7 part 2: J is a joker (worth 1; joins the largest group).
-- Doubled pair-count type: hi=0 p=2 2p=4 3=6 FH=8 4=12 5=20; jokers add
-- (g1+j)(g1+j-1) - g1(g1-1). No scalar let: stage via successive maps.
-- input 0: (id, c1..c5, bid) charcodes

let stage = input 0 : ((int, int, int, int, int, int, int), ()) | map(((id, c1, c2, c3, c4, c5, bid), ()) ->
    # doubled non-joker pair count
    let n1 = (c1, 74) ne in
    let n2 = (c2, 74) ne in
    let n3 = (c3, 74) ne in
    let n4 = (c4, 74) ne in
    let p1 = ((((c1, c2) eq, n1) all, ((c1, c3) eq, n1) all) add, (((c1, c4) eq, n1) all, ((c1, c5) eq, n1) all) add) add in
    let p2 = ((((c2, c3) eq, n2) all, ((c2, c4) eq, n2) all) add, ((c2, c5) eq, n2) all) add in
    let p3 = (((c3, c4) eq, n3) all, ((c3, c5) eq, n3) all) add in
    let p4 = ((c4, c5) eq, n4) all in
    let pc2 = (2, (((p1, p2) add, p3) add, p4) add) mul in
    # joker count
    let j = ((((c1, 74) eq, (c2, 74) eq) add, ((c3, 74) eq, (c4, 74) eq) add) add, (c5, 74) eq) add in
    # largest non-joker group
    let g1 = ((c1, 74) eq, 0, (((1, (c2, c1) eq) add, (c3, c1) eq) add, ((c4, c1) eq, (c5, c1) eq) add) add) select in
    let g2 = ((c2, 74) eq, 0, (((1, (c1, c2) eq) add, (c3, c2) eq) add, ((c4, c2) eq, (c5, c2) eq) add) add) select in
    let g3 = ((c3, 74) eq, 0, (((1, (c1, c3) eq) add, (c2, c3) eq) add, ((c4, c3) eq, (c5, c3) eq) add) add) select in
    let g4 = ((c4, 74) eq, 0, (((1, (c1, c4) eq) add, (c2, c4) eq) add, ((c3, c4) eq, (c5, c4) eq) add) add) select in
    let g5 = ((c5, 74) eq, 0, (((1, (c1, c5) eq) add, (c2, c5) eq) add, ((c3, c5) eq, (c4, c5) eq) add) add) select in
    let g = (0, (((g1, g2) max, (g3, g4) max) max, g5) max) max in
    let v1 = ((c1, 74) eq, 1, ((c1, 58) lt, (c1, 48) sub, ((c1, 84) eq, 10, ((c1, 81) eq, 12, ((c1, 75) eq, 13, 14) select) select) select) select) select in
    let v2 = ((c2, 74) eq, 1, ((c2, 58) lt, (c2, 48) sub, ((c2, 84) eq, 10, ((c2, 81) eq, 12, ((c2, 75) eq, 13, 14) select) select) select) select) select in
    let v3 = ((c3, 74) eq, 1, ((c3, 58) lt, (c3, 48) sub, ((c3, 84) eq, 10, ((c3, 81) eq, 12, ((c3, 75) eq, 13, 14) select) select) select) select) select in
    let v4 = ((c4, 74) eq, 1, ((c4, 58) lt, (c4, 48) sub, ((c4, 84) eq, 10, ((c4, 81) eq, 12, ((c4, 75) eq, 13, 14) select) select) select) select) select in
    let v5 = ((c5, 74) eq, 1, ((c5, 58) lt, (c5, 48) sub, ((c5, 84) eq, 10, ((c5, 81) eq, 12, ((c5, 75) eq, 13, 14) select) select) select) select) select in
    ((), (id, pc2, j, g, v1, v2, v3, v4, v5, bid)));
-- ((), (id, pc2, j, g1, v1..v5, bid))

let hands = stage | map((_, (id, pc2, j, g1, v1, v2, v3, v4, v5, bid)) ->
    let gj = (g1, j) add in
    ((), (id, ((pc2, (gj, (gj, 1) sub) mul) add, (g1, (g1, 1) sub) mul) sub, v1, v2, v3, v4, v5, bid)));
-- ((), (id, type2, v1..v5, bid))

let less = hands | join(hands, (_, (_, l1, l2, l3, l4, l5, l6, _), (rid, r1, r2, r3, r4, r5, r6, _)) -> ((
    ((l1, r1) lt, 1, ((l1, r1) gt, 0,
    ((l2, r2) lt, 1, ((l2, r2) gt, 0,
    ((l3, r3) lt, 1, ((l3, r3) gt, 0,
    ((l4, r4) lt, 1, ((l4, r4) gt, 0,
    ((l5, r5) lt, 1, ((l5, r5) gt, 0,
    ((l6, r6) lt, 1, 0) select) select) select) select) select) select) select) select) select) select) select,
    rid), ()));

let ranks = less | filter(((m, _), ()) -> (m, 1) eq) | map(((_, id), ()) -> (id, ())) | count;
let bids = hands | map((_, (id, _, _, _, _, _, _, bid)) -> (id, bid));
let above = ranks | join(bids, (id, n, bid) -> (id, (n, bid) mul));

export "result" = above + bids
    | map((_, x) -> ((), x)) | collect
    | map((_, xs) -> ((), xs fold_add))
    | arrange | inspect(part2);
