-- AoC 2023 day 1 part 1: per line, first digit * 10 + last digit; sum.
-- input 0: (line, pos, charcode)

let digits = input 0 : ((int, int, int), ())
    | filter(((_, _, c), _) -> ((c, 48) ge, (c, 57) le) all)
    | map(((line, pos, c), _) -> (line, (pos, (c, 48) sub)));
-- (line, (pos, digit))

let first = digits | min | map((line, (_, d)) -> (line, d));
let last  = digits | map((line, (pos, d)) -> (line, (pos neg, d))) | min | map((line, (_, d)) -> (line, d));

let calib = first | join(last, (line, f, l) -> (line, ((f, 10) mul, l) add));
-- (line, value)

export "result" = calib
    | map((_, v) -> ((), v)) | collect
    | value((_, vs) -> vs fold_add)
    | arrange | inspect(part1);
