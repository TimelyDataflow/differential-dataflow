-- AoC 2023 day 10 part 2: cells enclosed by the loop. Diagonal parity walk:
-- Enclosed(r+1,c+1) = Enclosed(r,c) toggled by loop pipes J - | F at (r,c).
-- (The slt resolves S to '???', which never toggles; we mirror that.)
-- input 0: (row, col, code), 1-indexed

let symbols = input 0 : ((int, int, int) ; ()) | key(((r, c, s), ()) -> ((r, c), s));
let pipes = symbols | filter((_, s) -> ((s, 46) ne, (s, 83) ne) all);

let e1 = pipes | map(((r, c), s) -> ((r, c,
    ((s, 124) eq, (r, 1) sub, ((s, 70) eq, (r, 1) add, ((s, 76) eq, (r, 1) sub, r) select) select) select,
    ((s, 45) eq, (c, 1) sub, ((s, 74) eq, (c, 1) sub, ((s, 55) eq, (c, 1) sub, c) select) select) select), ()));
let e2 = pipes | map(((r, c), s) -> ((r, c,
    ((s, 124) eq, (r, 1) add, ((s, 74) eq, (r, 1) sub, ((s, 55) eq, (r, 1) add, r) select) select) select,
    ((s, 45) eq, (c, 1) add, ((s, 70) eq, (c, 1) add, ((s, 76) eq, (c, 1) add, c) select) select) select), ()));
let r1 = e1 | map(((r, c, r2, c2), ()) -> ((r2, c2, r, c), ()));
let r2 = e2 | map(((r, c, r2, c2), ()) -> ((r2, c2, r, c), ()));
let scell = symbols | filter((_, s) -> (s, 83) eq);
let s4 = (scell | map(((r, c), _) -> ((r, c, (r, 1) add, c), ())))
       + (scell | map(((r, c), _) -> ((r, c, r, (c, 1) add), ())))
       + (scell | map(((r, c), _) -> ((r, c, (r, 1) sub, c), ())))
       + (scell | map(((r, c), _) -> ((r, c, r, (c, 1) sub), ())));

let symm = e1 + e2 + r1 + r2 + s4 | count | filter((_, (n)) -> (n, 2) eq)
    | map(((r, c, r2, c2), _) -> ((r, c), (r2, c2)));

reach: {
    let next = r | join(symm, (_, (), rc) -> (rc, ()));
    var r = (scell | map(((r, c), _) -> ((r, c), ()))) + next | distinct;
}
let loop = reach::r;
-- key (r, c) of loop cells (incl. S)

-- loop cells whose ORIGINAL symbol toggles parity (S resolves to '???': never)
let toggles = loop | join(symbols, (rc, _, s) -> (rc, s))
    | filter((_, s) -> ((s, 74) eq, (s, 45) eq, (s, 124) eq, (s, 70) eq) any)
    | map((rc, _) -> (rc, ()));

status: {
    let cur = st | map(((r, c, e), _) -> ((r, c), e)) | join(symbols, (rc, e, _) -> (rc, e));
    -- in-grid status cells (r, c ; e)
    let tog = cur | join(toggles, ((r, c), e, _) -> (((r, 1) add, (c, 1) add, (1, e) sub), ()));
    let matched = cur | join(toggles, (rc, e, _) -> (rc, e));
    let nontog = (cur - matched) | map(((r, c), e) -> (((r, 1) add, (c, 1) add, e), ()));
    var st = (symbols | filter(((r, c), _) -> ((r, 1) eq, (c, 1) eq) any) | map(((r, c), _) -> ((r, c, 0), ()))) + tog + nontog | distinct;
}

let enclosed = status::st | filter(((_, _, e), _) -> (e, 1) eq) | map(((r, c, _), _) -> ((r, c), ()));

-- pipe = reach minus S cells with no symm out-edge (slt keeps those countable)
let ssrc = symm | map((rc, _) -> (rc, ())) | distinct;
let scellk = scell | map(((r, c), _) -> ((r, c), ()));
let isoS = scellk - (scellk | join(ssrc, (rc, _, _) -> (rc, ())));
let pipe = loop - isoS;

-- set-minus needs an anti-join: bare `-` is multiset subtraction and lets
-- non-enclosed pipe cells cancel unrelated enclosed cells in the count.
let enc_on_pipe = enclosed | join(pipe, (rc, _, _) -> (rc, ()));
export "result" = (enclosed - enc_on_pipe) | key(_ -> ((), ())) | count | arrange | inspect(part2);
